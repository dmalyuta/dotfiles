#!/bin/bash
#
# Configure the KDE Plasma desktop: input devices, app hotkeys, global shortcuts, virtual desktops,
# effects, theme, icons and panels. Run by start_fresh, and safe to re-run on its own.
#
# Usage: configure_kde
#
# Exits with status 2 if a setting changed that takes a reboot to apply.
#
# The steps are at the bottom, in the order they run. The functions above them do the work.
#
# Author: Danylo Malyuta, 2026.

dotfiles=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
. "$dotfiles"/scripts/functions.sh

# --------------------------------------------------------------------------------------------------
# Talking to KWin, Plasma and the shortcuts service over D-Bus.
# --------------------------------------------------------------------------------------------------

dbus_call() {
	local dest=$1 path=$2 method=$3
	shift 3
	gdbus call --session --dest "$dest" --object-path "$path" --method "$method" "$@"
}

kwin() { dbus_call org.kde.KWin "$@" >/dev/null; }

# Call a method of kglobalaccel, which holds the global shortcuts.
kglobalaccel() { dbus_call org.kde.kglobalaccel /kglobalaccel "org.kde.KGlobalAccel.$1" "${@:2}"; }

# The names of a kglobalaccel component's shortcuts. Its D-Bus path is its name with
# non-alphanumerics turned into "_".
shortcut_names() {
	dbus_call org.kde.kglobalaccel "/component/${1//[^A-Za-z0-9]/_}" \
		org.kde.kglobalaccel.Component.shortcutNames
}

# Run JavaScript in plasmashell, see Plasma's desktop scripting API.
plasma_script() {
	dbus_call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$1"
}

# Ids of the given plasma objects. gdbus prints the returned string as ('...',).
plasma_ids() {
	plasma_script "print($1.map(x => x.id).join(' '))" | sed -E "s/^\('(.*)',\)$/\1/"
}

# --------------------------------------------------------------------------------------------------
# Settings, and noticing which ones changed.
# --------------------------------------------------------------------------------------------------

applets_rc=plasma-org.kde.plasma.desktop-appletsrc
kwin_env=~/.config/plasma-workspace/env/kwin-no-vulkan.sh
# A change to any of these needs a reboot (or a new login) to apply everywhere.
kde_files=(~/.config/{kcminputrc,kglobalshortcutsrc,kwinrc,ksmserverrc,kdeglobals,plasmashellrc}
	~/.config/"$applets_rc" "$kwin_env")
kde_before=$(mktemp -d)
trap 'rm -rf "$kde_before"' EXIT

# Keep a copy of each of those files, to compare with at the end. Writing an unchanged value
# leaves a file as it is.
remember_settings() {
	local f
	for f in "${kde_files[@]}"; do
		[ -f "$f" ] && cp "$f" "$kde_before/${f##*/}"
	done
}

# Ask for a reboot for each file that changed, naming up to 5 of the keys that changed in it.
report_changed_settings() {
	local f old keys n
	for f in "${kde_files[@]}"; do
		old=$kde_before/${f##*/}
		{ [ -e "$old" ] || [ -e "$f" ]; } || continue
		cmp -s "$old" "$f" 2>/dev/null && continue
		keys=$(diff "$old" "$f" 2>/dev/null | sed -n 's/^[<>] \([^=]*\)=.*/\1/p' | sort -u)
		n=$(wc -l <<<"$keys")
		[ -n "$keys" ] &&
			keys=": $(awk 'NR <= 5 { printf "%s%s", (NR > 1 ? ", " : ""), $0 }' <<<"$keys")" &&
			[ "$n" -gt 5 ] && keys+=" and $((n - 5)) more"
		reboot_for "KDE setting changed in ${f##*/}$keys"
	done
}

# Plasmashell only reads its settings on start, and writes its in-memory copy back over the file,
# so set them in the file and restart it at the end if any changed. Args: file, kreadconfig6's
# --group and --key options, value.
restart_plasmashell=
plasma_conf() {
	local file=$1 value=${!#} args=("${@:2:$#-2}")
	[ "$(kreadconfig6 --file "$file" "${args[@]}")" = "$value" ] && return
	kconf --file "$file" "${args[@]}" "$value"
	restart_plasmashell=1
}

# The config group of the panel applet with the given plugin, printed as "containment applet".
applet_group() {
	awk -F'[][]' -v want="plugin=$1" '
		/^\[Containments]\[[0-9]+]\[Applets]\[[0-9]+]$/ { c = $4; a = $8 }
		$0 == want { print c, a; exit }
	' ~/.config/"$applets_rc"
}

# Whether the app with this desktop file id (without .desktop) is installed.
app_installed() {
	[ -f ~/.local/share/applications/"$1".desktop ] || [ -f /usr/share/applications/"$1".desktop ]
}

# Show the system's desktop entry $1 changed by sed script $2, through a copy in the user's folder,
# which shadows it. Without the app, drop the copy.
shadow_desktop_entry() {
	local system=/usr/share/applications/$1 mine=~/.local/share/applications/$1
	if [ -f "$system" ]; then
		sed "$2" "$system" >"$mine"
	else
		rm -f "$mine"
	fi
}

# --------------------------------------------------------------------------------------------------
# Input devices.
# --------------------------------------------------------------------------------------------------

# Since Plasma 6.7, KWin's Vulkan path keeps a context on the NVIDIA dGPU, which then never
# suspends. KWin renders with OpenGL on the iGPU anyway. Plasma reads this file at login.
keep_kwin_off_vulkan() {
	if has_nvidia; then
		mkdir -p "${kwin_env%/*}"
		echo 'export KWIN_DISABLE_VULKAN=1' >"$kwin_env"
	else
		rm -f "$kwin_env"
	fi
}

configure_keyboard_and_cursor() {
	kconf --file kcminputrc --group Keyboard --key RepeatDelay 150
	kconf --file kcminputrc --group Keyboard --key RepeatRate 50
	kconf --file kcminputrc --group Mouse --key cursorSize 24
	# Tell running apps the cursor changed (5 is KGlobalSettings::CursorChanged).
	gdbus emit --session --object-path /KGlobalSettings \
		--signal org.kde.KGlobalSettings.notifyChange 5 0
}

# The pointer devices, one "vendor|product|name" per line, with the ids in decimal as KDE's
# settings name them.
pointer_devices() {
	gawk -v RS= '/Handlers=[^\n]*mouse/ &&
		match($0, /Vendor=(\w+) Product=(\w+).*N: Name="([^"]*)"/, m) {
			print strtonum("0x" m[1]) "|" strtonum("0x" m[2]) "|" m[3]
		}' /proc/bus/input/devices
}

# Libinput settings are per device: touchpads scroll the traditional way, mice are slowed down.
configure_pointer_devices() {
	local vendor product name device
	while IFS='|' read -r vendor product name; do
		device=(--file kcminputrc --group Libinput --group "$vendor" --group "$product" --group "$name")
		if [[ ${name,,} == *touchpad* ]]; then
			kconf "${device[@]}" --key NaturalScroll false
		else
			kconf "${device[@]}" --key PointerAcceleration -- -0.325
		fi
	done < <(pointer_devices)
}

# The on-screen keyboard, on a machine that folds into a tablet. KWin would pop it up over the app
# whenever a text field is tapped, so it never shows by itself (VirtualKeyboardMode 0): a tray
# button, shown in tablet mode, brings it up, see config/plasma/oskbutton.
plasma_keyboard=/usr/share/applications/org.kde.plasma.keyboard.desktop
set_up_onscreen_keyboard() {
	if [ -f "$plasma_keyboard" ]; then
		kconf --file kwinrc --group Wayland --key InputMethod "$plasma_keyboard"
		kconf --file kwinrc --group Wayland --key VirtualKeyboardMode 0
		# KWin reads the mode at login, so also set it live.
		kwin /VirtualKeyboard org.freedesktop.DBus.Properties.Set org.kde.kwin.VirtualKeyboard mode '<0>'
		mkdir -p ~/.local/share/plasma/plasmoids
		ln -sfn "$dotfiles"/config/plasma/oskbutton ~/.local/share/plasma/plasmoids/dotfiles.oskbutton
	fi
	# It also pops up accented characters when a physical key is held. Holding a key should repeat
	# it.
	kconf --file plasmakeyboardrc --group General --key diacriticsPopupEnabled false
}

# --------------------------------------------------------------------------------------------------
# App hotkeys: a KWin script that focuses an app's window on any desktop, or launches the app, see
# config/kwin/apphotkeys.
# --------------------------------------------------------------------------------------------------

# The script launches an app through kglobalaccel, by the "_launch" action of its desktop entry.
# kglobalaccel only keeps an entry across logins if it has a key, or if it's in this folder, which
# it reads at login. So the entries the script launches go here. They aren't in the app menu.
launch_dir=~/.local/share/kglobalaccel

# The VS Code workspaces that Meta+C, Meta+<letter> focuses, or opens if no window has them: this
# repo, and those answered in start_fresh as "<letter>:<absolute path>,...".
declare -A vscode_workspaces=([D]=$dotfiles)
read_workspaces() {
	local entry entries
	IFS=, read -r -a entries <<<"$(answer workspaces)"
	for entry in "${entries[@]}"; do
		vscode_workspaces[${entry%%:*}]=${entry#*:}
	done
}

# The letters of the workspaces that have a shortcut or a desktop entry now.
known_workspace_letters() {
	{
		shortcut_names kwin | grep -oP "'App Hotkeys: VS Code workspace \K[A-Z]"
		kglobalaccel allComponents | grep -oP 'vscode_workspace_\K[a-z](?=_desktop)'
		printf '%s\n' "$launch_dir"/vscode-workspace-?.desktop |
			grep -oP 'vscode-workspace-\K[a-z](?=\.desktop$)'
	} | tr '[:lower:]' '[:upper:]' | sort -u
}

# Drop the shortcuts and desktop entry of each workspace no longer in the list, which frees their
# keys. Only those: re-registering a shortcut right after unregistering it is unreliable.
drop_removed_workspaces() {
	local key
	while read -r key; do
		[ -n "${vscode_workspaces[$key]:-}" ] && continue
		kglobalaccel unregister kwin "App Hotkeys: VS Code workspace $key" >/dev/null
		kglobalaccel unregister "vscode-workspace-${key,,}.desktop" _launch >/dev/null
		rm -f "$launch_dir"/vscode-workspace-"${key,,}".desktop
	done < <(known_workspace_letters)
	# Earlier versions put the entries in the app menu's folder, hidden, where kglobalaccel forgot
	# them at logout.
	rm -f ~/.local/share/applications/vscode-workspace-?.desktop
}

# A desktop entry per workspace, named by its letter, for the script to launch it by. And the list
# itself, which the script reads from its config when it loads.
write_workspace_launchers() {
	local key dir config=
	for key in "${!vscode_workspaces[@]}"; do
		dir=${vscode_workspaces[$key]}
		cat >"$launch_dir"/vscode-workspace-"${key,,}".desktop <<EOF
[Desktop Entry]
Type=Application
Name=VS Code: ${dir##*/}
Exec=code "$dir"
Icon=vscode
EOF
		config+="$key=$dir;"
	done
	kconf --file kwinrc --group Script-apphotkeys --key vscodeWorkspaces "$config"
}

set_up_app_hotkeys() {
	mkdir -p ~/.local/share/kwin/scripts "$launch_dir"
	ln -sfn "$dotfiles"/config/kwin/apphotkeys ~/.local/share/kwin/scripts/apphotkeys
	kconf --file kwinrc --group Plugins --key apphotkeysEnabled true
	# Unloaded, so that Scripting.start (in configure_effects) loads it again with the new list.
	kwin /Scripting org.kde.kwin.Scripting.unloadScript apphotkeys
	read_workspaces
	drop_removed_workspaces
	write_workspace_launchers
}

# --------------------------------------------------------------------------------------------------
# Global shortcuts.
# --------------------------------------------------------------------------------------------------

# Qt key code of a "Mod+Mod+Key" binding, as kglobalaccel's D-Bus API takes it.
qt_keycode() {
	local part code=0
	local -A codes=([Shift]=0x02000000 [Ctrl]=0x04000000 [Alt]=0x08000000
		[Meta]=0x10000000 [Tab]=0x01000001 [Print]=0x01000009 [Del]=0x01000007 [Left]=0x01000012
		[Up]=0x01000013 [Right]=0x01000014 [None]=0)
	for part in ${1//+/ }; do
		if [[ $part == [A-Z] ]]; then
			((code += $(printf %d "'$part")))
		elif [ -n "${codes[$part]:-}" ]; then
			((code += codes[$part]))
		else
			failed "Unknown key '$part' in the shortcut '$1'"
			return 1
		fi
	done
	echo "$code"
}

# The actions bound to the key with Qt key code $1, one "action|its name|component|its name|keys"
# per line, from kglobalaccel's list of tuples.
actions_with_key() {
	kglobalaccel globalShortcutsByKey "([$1],)" "(0,)" |
		grep -oP "\('[^']*', '[^']*', '[^']*', '[^']*', '[^']*', '[^']*', \[[^]]*\]" |
		sed -E "s/^\('([^']*)', '([^']*)', '([^']*)', '([^']*)', '[^']*', '[^']*', \[(.*)\]$/\1|\2|\3|\4|\5/"
}

# Remove the key with Qt key code $1 from the actions that have it, except action $3 of component
# $2, keeping their other keys. kglobalaccel does not let two actions share a key.
take_key() {
	local action action_name component component_name keys
	while IFS='|' read -r action action_name component component_name keys; do
		[ "$component|$action" = "$2|$3" ] && continue
		keys=$(tr -d ' ' <<<"$keys" | tr , '\n' | grep -vx "$1" | paste -sd ,)
		kglobalaccel setForeignShortcut \
			"['$component','$action','$component_name','$action_name']" "[${keys:-0}]" >/dev/null
	done < <(actions_with_key "$1")
}

# Bind a global shortcut, taking the key from any other action that has it. Args: component, its
# friendly name, action, its friendly name, keys (see qt_keycode, or None to unbind).
set_shortcut() {
	local id code
	# Skip on error: an empty key list would unbind the action.
	code=$(qt_keycode "$5") || return
	id="['$1','$3','$2','$4']"
	[ "$code" -ne 0 ] && take_key "$code" "$1" "$3"
	# kglobalaccel ignores a desktop entry's shortcut until it notices the entry, which for a new one
	# takes a few seconds after kbuildsycoca6, so retry while it is missing.
	for _ in {1..20}; do
		kglobalaccel doRegister "$id" >/dev/null
		kglobalaccel setForeignShortcut "$id" "[$code]" >/dev/null
		[[ $1 == *.desktop ]] && [ -f ~/.local/share/applications/"$1" ] || return 0
		shortcut_names "$1" 2>/dev/null | grep -qF "'$3'" && return
		sleep 0.5
	done
	failed "Could not register the $2 shortcut."
}

# Link an app's desktop entry into $launch_dir, so its launch action stays across logins.
keep_launch_entry() {
	local d
	for d in ~/.local/share/applications /usr/share/applications \
		/var/lib/flatpak/exports/share/applications; do
		[ -f "$d/$1" ] && ln -sfn "$d/$1" "$launch_dir/$1" && return
	done
}

# Set through kglobalaccel's D-Bus API, because it keeps the shortcuts in memory and overwrites
# edits to kglobalshortcutsrc. An app is bound by its desktop entry, whose "_launch" action runs
# its Exec. Each key is taken from KDE's default action for it, if any, e.g. Meta+Up from Quick
# Tile Top.
set_global_shortcuts() {
	local shortcut key name
	# Rebuild the cache that kglobalaccel finds the desktop entries in.
	kbuildsycoca6 >/dev/null 2>&1
	find "$launch_dir" -xtype l -delete
	# Component, its name, action, its name, keys.
	while IFS='|' read -r -a shortcut; do
		set_shortcut "${shortcut[@]}"
		[ "${shortcut[2]}" = _launch ] && keep_launch_entry "${shortcut[0]}"
	done <<'EOF'
kwin|KWin|Window Minimize|Minimize Window|Meta+Del
kwin|KWin|Window Maximize|Maximize Window|Meta+Up
kwin|KWin|Switch One Desktop to the Left|Switch One Desktop to the Left|Meta+Ctrl+Left
kwin|KWin|Switch One Desktop to the Right|Switch One Desktop to the Right|Meta+Ctrl+Right
kwin|KWin|Window One Desktop to the Left|Window One Desktop to the Left|Meta+Ctrl+Shift+Left
kwin|KWin|Window One Desktop to the Right|Window One Desktop to the Right|Meta+Ctrl+Shift+Right
kwin|KWin|Overview|Toggle Overview|Meta+Ctrl+Tab
kwin|KWin|Invert|Toggle Invert Effect|Ctrl+Shift+I
org.flameshot.Flameshot.desktop|Flameshot|Capture|Flameshot|Print
org.kde.konsole.desktop|Konsole|_launch|Konsole|None
kitty.desktop|kitty|_launch|kitty|Ctrl+Alt+T
brave-browser.desktop|Brave|_launch|Brave|None
org.kde.dolphin.desktop|Dolphin|_launch|Dolphin|None
io.github.cboxdoerfer.FSearch.desktop|FSearch|_launch|FSearch|None
pureref.desktop|PureRef|_launch|PureRef|None
md.obsidian.Obsidian.desktop|Obsidian|_launch|Obsidian|None
org.inkscape.Inkscape.desktop|Inkscape|_launch|Inkscape|None
org.speedcrunch.SpeedCrunch.desktop|SpeedCrunch|_launch|SpeedCrunch|None
pdf-xchange-editor.desktop|PDF-XChange Editor|_launch|PDF-XChange Editor|None
com.microsoft.VSCode.desktop|Visual Studio Code|_launch|Visual Studio Code|None
kwin|KWin|App Hotkeys: Brave|App Hotkeys: Brave|Meta+B
kwin|KWin|App Hotkeys: New Brave window|App Hotkeys: New Brave window|Meta+Shift+B
kwin|KWin|App Hotkeys: Terminal|App Hotkeys: Terminal|Meta+W
kwin|KWin|App Hotkeys: New terminal|App Hotkeys: New terminal|Meta+Shift+W
kwin|KWin|App Hotkeys: Dolphin|App Hotkeys: Dolphin|Meta+E
kwin|KWin|App Hotkeys: New Dolphin window|App Hotkeys: New Dolphin window|Meta+Shift+E
kwin|KWin|App Hotkeys: FSearch|App Hotkeys: FSearch|Meta+S
kwin|KWin|App Hotkeys: PureRef|App Hotkeys: PureRef|Meta+R
kwin|KWin|App Hotkeys: Obsidian|App Hotkeys: Obsidian|Meta+O
kwin|KWin|App Hotkeys: Inkscape|App Hotkeys: Inkscape|Meta+I
kwin|KWin|App Hotkeys: SpeedCrunch|App Hotkeys: SpeedCrunch|Meta+N
kwin|KWin|App Hotkeys: PDF-XChange Editor|App Hotkeys: PDF-XChange Editor|Meta+P
kwin|KWin|App Hotkeys: VS Code|App Hotkeys: VS Code|Meta+C
EOF
	for key in "${!vscode_workspaces[@]}"; do
		name="VS Code ${vscode_workspaces[$key]##*/}"
		set_shortcut vscode-workspace-"${key,,}".desktop "$name" _launch "$name" None
		set_shortcut kwin KWin "App Hotkeys: VS Code workspace $key" "App Hotkeys: $name" "Meta+$key"
	done
}

# --------------------------------------------------------------------------------------------------
# Virtual desktops and effects.
# --------------------------------------------------------------------------------------------------

# Exactly the virtual desktops named by the arguments, in one row. Existing ones are renamed
# rather than recreated, so their windows stay put.
set_virtual_desktops() {
	local names=("$@") ids i id
	vdm() { kwin /VirtualDesktopManager "org.kde.KWin.VirtualDesktopManager.$1" "${@:2}"; }
	# The desktops property is a list of (position, id, name).
	mapfile -t ids < <(dbus_call org.kde.KWin /VirtualDesktopManager \
		org.freedesktop.DBus.Properties.Get org.kde.KWin.VirtualDesktopManager desktops |
		grep -oP "\d+, '\K[^']+")
	for i in "${!names[@]}"; do
		if [ -n "${ids[i]:-}" ]; then
			vdm setDesktopName "${ids[i]}" "${names[i]}"
		else
			vdm createDesktop "$i" "${names[i]}"
		fi
	done
	for id in "${ids[@]:${#names[@]}}"; do
		vdm removeDesktop "$id"
	done
	kwin /VirtualDesktopManager org.freedesktop.DBus.Properties.Set \
		org.kde.KWin.VirtualDesktopManager rows '<uint32 1>'
}

configure_effects() {
	local effect
	# Flash the desktop name for 200 ms on switch. This OSD is a KWin script, which a reconfigure
	# does not load, so start the scripts (apphotkeys too, see set_up_app_hotkeys).
	kconf --file kwinrc --group Plugins --key desktopchangeosdEnabled true
	kconf --file kwinrc --group Script-desktopchangeosd --key PopupHideDelay 200
	kconf --file kwinrc --group Script-desktopchangeosd --key TextOnly true
	kwin /Scripting org.kde.kwin.Scripting.start

	kconf --file ksmserverrc --group General --key loginMode emptySession
	kconf --file ksmserverrc --group General --key confirmLogout false
	kconf --file kdeglobals --group KDE --key AnimationDurationFactor 0
	# Ctrl+Shift+I (see set_global_shortcuts) inverts the screen colors.
	kconf --file kwinrc --group Plugins --key invertEnabled true
	kwin /Effects org.kde.kwin.Effects.loadEffect invert
	# No animations. Also unload them, since a reconfigure leaves running effects loaded.
	for effect in wobblywindows magiclamp translucency squash scale fade glide \
		maximize fullscreen slide fadedesktop; do
		kconf --file kwinrc --group Plugins --key "${effect}Enabled" false
		kwin /Effects org.kde.kwin.Effects.unloadEffect "$effect"
	done
	kwin /KWin org.kde.KWin.reconfigure
}

# --------------------------------------------------------------------------------------------------
# Theme and icons.
# --------------------------------------------------------------------------------------------------

apply_look_and_feel() {
	[ "$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage)" = "$1" ] ||
		plasma-apply-lookandfeel --apply "$1"
}

# Link $2 to $1, a file in the same folder, if $2 doesn't exist.
tela_links=
tela_link() {
	[ -e "$2" ] && return
	ln -s "$1" "$2"
	tela_links=1
	restart_plasmashell=1
}

# Tela-circle icons, from upstream (Fedora doesn't package them).
install_tela_icons() {
	local src icon theme
	if [ ! -d ~/.local/share/icons/"$1" ]; then
		src=$(mktemp -d)
		git clone -q --depth 1 https://github.com/vinceliuice/Tela-circle-icon-theme.git "$src" &&
			"$src"/install.sh >/dev/null
		rm -rf "$src"
	fi
	# The tray asks for battery-090-charging-symbolic and the like, which Tela lacks, so it falls
	# back to battery-symbolic: an empty outline at every charge level. Give Tela's level icons
	# those names.
	for icon in ~/.local/share/icons/Tela-circle*/*/panel/battery-[0-9]*.svg \
		~/.local/share/icons/Tela-circle*/*/*/battery-profile-*.svg; do
		case $icon in *-symbolic.svg) continue ;; esac
		tela_link "$(basename "$icon")" "${icon%.svg}-symbolic.svg"
	done
	# Fully charged on AC with a power profile other than the default, the tray shows
	# battery-profile-<profile>-symbolic instead. Tela has no balanced one, so show the full,
	# plugged-in battery for that.
	for icon in ~/.local/share/icons/Tela-circle*/*/panel/battery-100-charging.svg; do
		tela_link "$(basename "$icon")" "${icon%/*}/battery-profile-balanced-symbolic.svg"
	done
	if [ -n "$tela_links" ]; then
		for theme in ~/.local/share/icons/Tela-circle*/; do gtk-update-icon-cache -qf "$theme"; done
		rm -f ~/.cache/icon-cache.kcache
	fi
}

# The panel keeps the icons it already looked up, so restart plasmashell too.
apply_icon_theme() {
	[ "$(kreadconfig6 --file kdeglobals --group Icons --key Theme)" = "$1" ] && return
	/usr/libexec/plasma-changeicons "$1"
	restart_plasmashell=1
}

# --------------------------------------------------------------------------------------------------
# Panels, the desktop and the start menu.
# --------------------------------------------------------------------------------------------------

# Panels 40 px tall, opaque (0 is adaptive, 1 opaque, 2 translucent), and never floating, even with
# no window maximized.
configure_panels() {
	local id panel
	for id in $(plasma_ids 'panels()'); do
		panel=(plasmashellrc --group PlasmaViews --group "Panel $id")
		plasma_conf "${panel[@]}" --group Defaults --key thickness 40
		plasma_conf "${panel[@]}" --key panelOpacity 1
		plasma_conf "${panel[@]}" --key floating 0
	done
}

# No desktop icons: switch from the Folder View layout to the plain one.
hide_desktop_icons() {
	local id
	for id in $(plasma_ids 'desktops()'); do
		plasma_conf "$applets_rc" --group Containments --group "$id" \
			--key plugin org.kde.desktopcontainment
	done
}

# The PDF editor, which gets pinned and opens PDF files: PDF-XChange if installed, else PdfCraft.
pdf_app=
choose_pdf_app() {
	local app
	for app in pdf-xchange-editor ai.storyteller.pdfcraft; do
		app_installed "$app" && pdf_app=$app && break
	done
	[ -z "$pdf_app" ] || [ "$(xdg-mime query default application/pdf)" = "$pdf_app.desktop" ] ||
		xdg-mime default "$pdf_app.desktop" application/pdf
}

# The task manager's pinned apps: exactly the given ones, in this order. Anything else that was
# pinned is dropped.
pin_apps() {
	local containment applet list
	read -r containment applet < <(applet_group org.kde.plasma.icontasks)
	[ -n "${applet:-}" ] || return 0
	list=$(printf ',applications:%s.desktop' "$@")
	plasma_conf "$applets_rc" --group Containments --group "$containment" --group Applets \
		--group "$applet" --group Configuration --group General --key launchers "${list#,}"
}

# Edit one of the system tray's lists, the key $1 of its config group $tray: append each +item
# that isn't in it, and drop each -item.
tray_list() {
	local key=$1 item list kept=()
	local -A drop=() have=()
	for item in "${@:2}"; do [[ $item == -* ]] && drop[${item:1}]=1; done
	IFS=, read -ra list <<<"$(kreadconfig6 --file "${tray[@]}" --key "$key")"
	for item in "${list[@]}"; do
		[ -n "${drop[$item]:-}" ] || { kept+=("$item"); have[$item]=1; }
	done
	for item in "${@:2}"; do
		[[ $item == +* ]] && [ -z "${have[${item:1}]:-}" ] && kept+=("${item:1}")
	done
	plasma_conf "${tray[@]}" --key "$key" "$(IFS=,; echo "${kept[*]}")"
}

# The system tray: our on-screen keyboard button, the battery always shown on a laptop, and
# brightness, clipboard, Bluetooth and Discover's updates always hidden. The rest show only when
# they have something to show.
configure_system_tray() {
	local containment applet tray
	local buttons=() always_shown=()
	local always_hidden=(org.kde.plasma.brightness org.kde.plasma.clipboard org.kde.plasma.bluetooth
		"Discover Notifier_org.kde.DiscoverNotifier")
	[ -f "$plasma_keyboard" ] && buttons=(dotfiles.oskbutton)
	is_laptop && always_shown=(org.kde.plasma.battery)
	read -r containment applet < <(applet_group org.kde.plasma.systemtray)
	[ -n "${applet:-}" ] || return 0
	tray=("$applets_rc" --group Containments --group "$containment" --group Applets
		--group "$applet" --group General)
	tray_list extraItems "${buttons[@]/#/+}"
	tray_list knownItems "${buttons[@]/#/+}"
	tray_list shownItems "${always_shown[@]/#/+}" "${always_hidden[@]/#/-}"
	tray_list hiddenItems "${always_hidden[@]/#/+}" "${always_shown[@]/#/-}"
}

set_start_menu_icon() {
	local containment applet
	read -r containment applet < <(applet_group org.kde.plasma.kickoff)
	[ -n "${applet:-}" ] || return 0
	plasma_conf "$applets_rc" --group Containments --group "$containment" --group Applets \
		--group "$applet" --group Configuration --group General --key icon "$1"
}

# The start menu's favorites: exactly the given apps, in this order. They're in the activity
# manager's database, so go through its D-Bus API (and read the database only with mode=ro, which
# sees writes still in its WAL).
set_start_menu_favorites() {
	local agent=org.kde.plasma.favorites.applications want order res group app
	fav_link() {
		dbus_call org.kde.ActivityManager /ActivityManager/Resources/Linking \
			"org.kde.ActivityManager.ResourcesLinking.$1" "$agent" "$2" :global >/dev/null
	}
	want=" $(printf 'applications:%s.desktop ' "$@")"
	while read -r res; do
		[ -z "$res" ] || [[ $want == *" $res "* ]] || fav_link UnlinkResourceFromActivity "$res"
	done < <(sqlite3 "file:$HOME/.local/share/kactivitymanagerd/resources/database?mode=ro" \
		"select targettedResource from ResourceLink where initiatingAgent='$agent';" 2>/dev/null)
	# The menu shows them in the order kept for each of its instances, if it has one, else as
	# linked.
	order=$(printf ',%s.desktop' "$@")
	while read -r group; do
		kconf --file kactivitymanagerd-statsrc --group "$group" --key ordering "${order#,}"
	done < <(sed -n 's/^\[\(Favorites-org\.kde\.plasma\.kickoff\.[^]]*\)\]$/\1/p' \
		~/.config/kactivitymanagerd-statsrc 2>/dev/null)
	for app in "$@"; do
		fav_link LinkResourceToActivity "applications:$app.desktop"
	done
}

# Remove every widget of the given types from the panels.
remove_panel_widgets() {
	local types
	types=$(printf '"%s", ' "$@")
	plasma_script "panels().forEach(p => [${types%, }]
		.forEach(type => p.widgets(type).forEach(w => w.remove())))" >/dev/null
}

# --------------------------------------------------------------------------------------------------
# The steps.
# --------------------------------------------------------------------------------------------------

remember_settings

step "Configuring KDE input devices"
keep_kwin_off_vulkan
configure_keyboard_and_cursor
configure_pointer_devices
# Three-finger swipes switch windows (and rows) every 2.5 mm the fingers move, rather than 5 mm,
# see scripts/patches/kwin-touchpad-gestures.patch. KWin reads it at the reconfigure below.
kconf --file kwinrc --group TouchpadGestures --key StepDistance 2.5
kconf --file kwinrc --group TouchpadGestures --key RowDistance 2.5
compgen -G '/sys/class/backlight/*' >/dev/null &&
	say "If System Settings > Display has an auto-brightness toggle, turn it off."
set_up_onscreen_keyboard

step "Setting up the KDE app hotkeys"
set_up_app_hotkeys
# Cardwire from the menu shows the running copy instead of starting another, whose tray icon would
# sit next to the first one's.
shadow_desktop_entry cardwire-gui.desktop "s|^Exec=.*|Exec=\"$dotfiles/bin/cardwire-show\"|"
# Touchscreen panning in Brave: a touch doesn't scroll until it has moved Chromium's "touch slop"
# (15 px), and then the page trails the finger by that much, a jump at every pan's start. 4 px
# still keeps a tap that wobbles a tap. Brave's launcher reads no flags file, so the flag goes on
# every Exec of its desktop entry (which Meta+B uses too). Restart Brave for it to take effect.
shadow_desktop_entry brave-browser.desktop \
	's|^Exec=/usr/bin/brave-browser-stable|& --touch-slop-distance=4|'

step "Setting the KDE global shortcuts"
set_global_shortcuts

step "Setting up the virtual desktops"
set_virtual_desktops code browsing

step "Configuring the desktop effects"
configure_effects

step "Applying the Breeze Dark theme and icons"
apply_look_and_feel org.kde.breezedark.desktop
# Dark icons to match, set after the look and feel, which resets the icon theme.
install_tela_icons Tela-circle-dark
apply_icon_theme Tela-circle-dark

step "Setting up the panels and the start menu"
configure_panels
hide_desktop_icons
choose_pdf_app
pin_apps org.kde.dolphin brave-browser kitty com.microsoft.VSCode md.obsidian.Obsidian \
	${pdf_app:+"$pdf_app"}
configure_system_tray
set_start_menu_icon "$dotfiles"/config/icons/start_menu.svg
[ -n "$restart_plasmashell" ] && systemctl --user restart plasma-plasmashell.service
# System Settings, then the installed hardware tools.
favorites=(systemsettings)
for app in cardwire-gui org.opengamingcollective.rog-control-center \
	org.coolercontrol.CoolerControl org.openrgb.OpenRGB; do
	app_installed "$app" && favorites+=("$app")
done
set_start_menu_favorites "${favorites[@]}"
# The shortcuts and OSD already show the current desktop, so drop the pager. Drop Peek at Desktop
# too: it's a panel widget, which the tray can't hide.
remove_panel_widgets org.kde.plasma.pager org.kde.plasma.showdesktop

step 2 "Adding Danylo's Linux Tweaks to System Settings"
# The settings of scripts/patches, see config/tweaks.
"$dotfiles"/config/tweaks/install

report_changed_settings
[ -z "${need_reboot:-}" ] || exit 2
