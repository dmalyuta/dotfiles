+    // Tweaks, read when Plasma starts.
+    const QSettings tweaks(QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation)
+                               + QStringLiteral("/danylo-tweaksrc"),
+                           QSettings::IniFormat);
+    if (tweaks.value(QStringLiteral("Battery/HideAbsentDeviceBatteries"), true).toBool()
+        && battery->type() != Solid::Battery::PrimaryBattery && !battery->isPresent()) {
+        qCDebug(COMPONENTS::BATTERYCONTROL) << "Battery with udi: " << udi << " isn't present, waiting for it";
+        connect(battery, &Solid::Battery::presentStateChanged, this, [this, battery](bool present, const QString &udi) {
+            if (present && !m_batteryPositions.contains(udi)) {
