#!/bin/bash
#
# Set up a fresh Fedora KDE Plasma install. On a new machine, run
#
#   curl -fsSL https://raw.githubusercontent.com/dmalyuta/dotfiles/fedora/start_fresh | bash
#
# Safe to re-run: every step skips what is already done. See usage below and `man start_fresh`.
#
# The steps are at the bottom, in the order they run. The functions above them do the work, and
# the last steps run scripts/configure_hardware and scripts/configure_kde.
#
# Author: Danylo Malyuta, 2026.

repo_ssh=git@github.com:dmalyuta/dotfiles.git
branch=fedora
raw_base=https://raw.githubusercontent.com/dmalyuta/dotfiles/$branch

# --------------------------------------------------------------------------------------------------
# Bootstrap.
# --------------------------------------------------------------------------------------------------

usage() {
	cat <<'EOF'
Usage: start_fresh [-c] [-n] [-p] [-h]

Set up a fresh Fedora KDE Plasma install: repositories, packages, apps, the NVIDIA driver, the
dotfiles, hardware settings and the KDE desktop. Safe to re-run: every step skips what is already
done. Run from a checkout of the dotfiles, it first pulls the checkout's branch and runs the
newest start_fresh, unless the machine is offline.

Options:
  -c  Reuse the answers from the last run instead of asking the setup questions again.
  -n  Don't pull the dotfiles first: run this checkout as it is.
  -p  Plain output, without the progress display.
  -h  Show this help and exit.

On a new machine:
  curl -fsSL https://raw.githubusercontent.com/dmalyuta/dotfiles/fedora/start_fresh | bash

More in `man start_fresh`.
EOF
}

use_cached='' plain='' no_update=''
while getopts cnph opt; do
	case $opt in
	c) use_cached=1 ;;
	n) no_update=1 ;;
	p) plain=1 ;;
	h) usage && exit 0 ;;
	*) usage >&2 && exit 1 ;;
	esac
done

# Under `curl ... | bash` stdin is the script itself, so `read` would eat it. Re-exec a downloaded
# copy with the terminal on stdin instead.
if [ ! -t 0 ] && [ -z "${DOTFILES_BOOTSTRAP:-}" ]; then
	self=$(mktemp)
	curl -fsSL "$raw_base/start_fresh" -o "$self" </dev/tty || exit
	DOTFILES_BOOTSTRAP=$self exec bash "$self" "$@" </dev/tty
fi

# Use this checkout if running from one, else clone to ~/Projects/dotfiles below.
mkdir -p ~/Projects
dotfiles=~/Projects/dotfiles
this_script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -f "$this_script_dir/home/.bash_aliases" ] && [ -e "$this_script_dir/.git" ]; then
	dotfiles=$this_script_dir
fi

# Downloads land here, and the installers that need a manual download are looked for here.
downloads=~/Downloads
mkdir -p "$downloads" ~/.local/bin ~/.local/share/applications
cd "$downloads" || exit
# Apps installed to ~/.local/bin below are run from here too.
export PATH=$HOME/.local/bin:$PATH

# Shared helpers, see scripts/functions.sh. Before the repo is cloned, fetch them from GitHub.
if [ "$dotfiles" = "$this_script_dir" ]; then
	. "$dotfiles"/scripts/functions.sh
else
	functions=$(curl -fsSL "$raw_base/scripts/functions.sh") || exit
	eval "$functions"
fi

# Update itself: pull the checkout's branch, and if that brought anything new, run the new
# start_fresh in place of this one. Only by fast-forward, so local commits and uncommitted changes
# are never merged or rewritten: changes to files the pull doesn't touch are fine, anything else
# stops here, as running an old start_fresh on a half-updated checkout helps nobody. Not on a new
# machine, where the checkout is cloned below. START_FRESH_UPDATED keeps the new start_fresh (and
# the one run under the progress display) from pulling again.
#
# Offline, the pull is skipped and this checkout runs as it is. Offline means that NetworkManager
# reports no connection to the internet, or that the remote's host has no address; a remote that
# is a local path is always there.

# The host of the remote that the checkout's branch pulls from, or nothing for a local path.
dotfiles_remote_host() {
	local remote url
	remote=$(git -C "$dotfiles" config "branch.$(git -C "$dotfiles" branch --show-current).remote")
	url=$(git -C "$dotfiles" remote get-url "${remote:-origin}" 2>/dev/null) || return 0
	case $url in
	*://*) url=${url#*://} && url=${url%%/*} && url=${url##*@} && echo "${url%%:*}" ;;
	/* | ./* | ../*) ;;
	*:*) url=${url%%:*} && echo "${url##*@}" ;;
	esac
}

# Print why the remote can't be reached, if the reason is that there is no network.
offline_reason() {
	local host
	case $(nmcli -t -f CONNECTIVITY general status 2>/dev/null) in
	none | limited | portal) echo "no internet connection" && return ;;
	esac
	host=$(dotfiles_remote_host)
	[ -z "$host" ] || getent ahosts "$host" >/dev/null || echo "can't find $host"
}

# The update's one line of output: an icon in the color $1, "Checking for updates", and $3 after
# it. Drawn over the line the cursor is on, with the icons and colors of the progress display
# (scripts/tui.py) and in its columns: its spinner while the pull runs, then the mark it ends a
# run with.
update_line() { printf '\r   %b%s\e[0m \e[1mChecking for updates\e[0m%s\e[K' "$1" "$2" "$3"; }
update_done() { update_line '\e[1;92m' ✓ "$1" && echo; }

# Pull, with the output in the file $1, and spin meanwhile. Without prompts, which the spinner
# would draw over: if git or ssh needs to ask for something, this fails and says so.
pull_with_spinner() {
	local pid frame=0 spinner=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
	GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes" \
		git -C "$dotfiles" pull --ff-only >"$1" 2>&1 &
	pid=$!
	if [ -t 1 ]; then
		# Hide the cursor while it spins, and give it back if interrupted.
		printf '\e[?25l'
		trap 'printf "\e[?25h\n"; exit 130' INT
		while kill -0 "$pid" 2>/dev/null; do
			update_line '\e[94m' "${spinner[frame++ % ${#spinner[@]}]}" ''
			sleep 0.08
		done
		trap - INT
		printf '\e[?25h'
	fi
	wait "$pid"
}

if [ "$dotfiles" = "$this_script_dir" ] && [ -z "$no_update" ] && [ -z "${START_FRESH_UPDATED:-}" ]; then
	export START_FRESH_UPDATED=1
	offline=$(offline_reason)
	if [ -n "$offline" ]; then
		update_done ": skipped, offline ($offline)"
	else
		before=$(git -C "$dotfiles" rev-parse HEAD 2>/dev/null)
		pull_log=$(mktemp)
		pull_with_spinner "$pull_log"
		pull_status=$?
		if [ $pull_status -ne 0 ] &&
			grep -qE 'Permission denied|Host key verification failed|terminal prompts disabled' "$pull_log"; then
			# It needed to ask, for a key's passphrase for instance. Again with prompts, and so
			# without the spinner.
			[ -t 1 ] && update_line '\e[94m' "⠋" '' && echo
			git -C "$dotfiles" pull --ff-only >"$pull_log" 2>&1
			pull_status=$?
		fi
		pulled=$(cat "$pull_log")
		rm -f "$pull_log"
		if [ $pull_status -ne 0 ]; then
			update_line '\e[1;91m' ✗ '' && echo
			# Under the line's text.
			{
				printf '\e[1;91m%s\e[0m\n' "Couldn't pull the latest dotfiles into $dotfiles."
				echo "git pull --ff-only said:"
				echo "${pulled:-(nothing)}" | sed 's/^/    /'
				echo "Resolve that by hand in $dotfiles, then run start_fresh again."
				echo "To run this checkout as it is, without updating: start_fresh -n"
			} | sed 's/^/     /' >&2
			exit 1
		fi
		if [ "$(git -C "$dotfiles" rev-parse HEAD)" != "$before" ]; then
			update_done ": updated to $(git -C "$dotfiles" log -1 --format='%h %s')"
			exec bash "$this_script_dir/${BASH_SOURCE[0]##*/}" "$@"
		fi
		update_done ''
	fi
fi

# Run the rest again under scripts/tui.py, which shows the progress through the steps above a box
# with the tail of the output. It needs pyte, a terminal emulator library, under Fedora's own
# Python rather than whichever is first on PATH (Anaconda's). Before the repo is cloned, fetch it
# from GitHub.
if [ -z "${START_FRESH_TUI:-}" ] && [ -z "$plain" ] && [ -t 0 ] && [ -t 1 ]; then
	installed python3-pyte || sudo dnf install -y -q python3-pyte </dev/null
	tui=$dotfiles/scripts/tui.py
	if [ ! -f "$tui" ]; then
		tui=$(mktemp --suffix=.py)
		curl -fsSL "$raw_base/scripts/tui.py" -o "$tui" || tui=
	fi
	if [ -n "$tui" ] && /usr/bin/python3 -I -c 'import pyte' 2>/dev/null; then
		self=$this_script_dir/${BASH_SOURCE[0]##*/}
		START_FRESH_TUI=1 exec /usr/bin/python3 -I "$tui" --script "$self" --dotfiles "$dotfiles" \
			--raw-base "$raw_base" -- bash "$self" "$@"
	fi
	say "No progress display, see above." >&2
fi

# What needs a reboot and what failed, one per line, from here and the scripts run at the end. See
# reboot_for and failed in scripts/functions.sh.
REBOOT_REASONS=$(mktemp) FAILURES=$(mktemp)
export REBOOT_REASONS FAILURES
trap 'kill ${sudo_keepalive:-} 2>/dev/null
	rm -f "$REBOOT_REASONS" "$FAILURES" ${DOTFILES_BOOTSTRAP:+"$DOTFILES_BOOTSTRAP"}' EXIT

fedora=$(rpm -E %fedora)

# The last run's answers, kept in the repo but out of git. On a fresh install the repo is cloned
# later, so they are saved after that.
answers_file=$dotfiles/.start_fresh_answers
declare -A answers=()
# shellcheck source=/dev/null
[ -f "$answers_file" ] && . "$answers_file"

# --------------------------------------------------------------------------------------------------
# Questions, all up front so the rest runs unattended.
# --------------------------------------------------------------------------------------------------

# Ask for the sudo password once, and keep it fresh in the background so a long step doesn't ask
# again partway through.
start_sudo_session() {
	local tmp conf=/etc/sudoers.d/timestamp-global
	sudo -v || exit
	while kill -0 $$ 2>/dev/null && sleep 60; do sudo -n -v 2>/dev/null || break; done &
	sudo_keepalive=$!

	# sudo remembers the password per terminal, and the progress display is a terminal of its own,
	# so have it remember it across the user's terminals. Checked with visudo first: a broken
	# sudoers file locks sudo out.
	tmp=$(mktemp)
	echo "Defaults:$USER timestamp_type=global" >"$tmp"
	if ! sudo cmp -s "$tmp" "$conf" && visudo -cqf "$tmp"; then
		sudo install -Z -m 440 "$tmp" "$conf"
	fi
	rm -f "$tmp"
}

# Yes/no question whose default is the last answer, remembered under key $1. With -c, a remembered
# answer is used without asking.
ask() {
	local key=$1 hint="[yN]" a
	if [ -n "$use_cached" ] && [ -n "${answers[$key]:-}" ]; then
		[ "${answers[$key]}" = y ]
		return
	fi
	[ "${answers[$key]:-}" = y ] && hint="[Yn]"
	read -p "$2 $hint " -r a
	[[ ${a:-${answers[$key]:-n}} =~ ^[Yy]$ ]] && answers[$key]=y || answers[$key]=n
	[ "${answers[$key]}" = y ]
}

# Ask for a line of text, remembered under key $1, with the last answer pre-filled for editing.
# Args: key, prompt, a function that checks the answer, and help to print before asking. With -c,
# a valid remembered answer is used without asking. Only for what can't be found on the machine.
ask_text() {
	local key=$1 prompt=$2 valid=${3:-true} help=${4:-}
	local value=${answers[$key]-}
	if [ -n "$use_cached" ] && [ -n "${answers[$key]+set}" ] && "$valid" "$value"; then
		return
	fi
	[ -z "$help" ] || echo "$help"
	while true; do
		read -e -i "$value" -p "$prompt " -r value || exit
		"$valid" "$value" && break
		echo "Invalid, try again."
	done
	answers[$key]=$value
}

# Whether $1 lists VS Code workspaces as "<letter>:<absolute path>,..." (or is empty), with distinct
# letters.
valid_workspaces() {
	local entry="[A-Z]:/[^,;]*[^,;/]"
	[[ $1 =~ ^($entry(,$entry)*)?$ ]] &&
		[ -z "$(tr , '\n' <<<"$1" | cut -c1 | sort | uniq -d)" ]
}

# Offer a newer Fedora release: the highest final version on Fedora's download page. Asked every
# run while there is one, even with -c. It's downloaded at the end, see download_fedora_upgrade.
ask_fedora_upgrade() {
	local newest a
	newest=$(curl -fsSL https://fedoraproject.org/releases.json 2>/dev/null |
		grep -oE '"version": *"[0-9]+"' | grep -oE '[0-9]+' | sort -n | tail -n 1)
	if [ "${newest:-0}" -gt "$fedora" ]; then
		read -p "Fedora $newest is out. Upgrade to it from Fedora $fedora? [Yn] " -r a
		[[ ${a:-y} =~ ^[Yy]$ ]] && upgrade_to=$newest
	fi
}

# The key that signs the kernel modules built here, see set_up_module_signing.
akmods_cert=/etc/pki/akmods/certs/public_key.der

# Whether that key is enrolled in the firmware, or queued for enrollment on the next boot. Its
# directory is only readable by root.
mok_key_ok() {
	sudo test -f "$akmods_cert" &&
		! sudo mokutil --test-key "$akmods_cert" 2>/dev/null | grep -q 'not enrolled'
}

# Ask for a one-time password for enrolling the module signing key. Asked every run until the key
# is enrolled, and only its hash is kept, for this run only.
ask_mok_password() {
	local password again
	echo "Secure Boot is on, so the NVIDIA driver needs a signing key that the firmware trusts. Pick"
	echo "a one-time password for adding it: the next boot asks for it once."
	while true; do
		read -s -p "Key password: " -r password && echo
		read -s -p "Again: " -r again && echo
		[ -n "$password" ] && [ "$password" = "$again" ] && break
		echo "Empty or different, try again."
	done
	mok_hash=$(mokutil --generate-hash="$password")
}

# Find a Brother printer on the network by what it announces over mDNS, and print its model (like
# MFC-L2750DW), hostname and IPv4 address. Prints nothing while it is off.
find_brother() {
	avahi-browse --resolve --parsable --terminate _ipp._tcp 2>/dev/null |
		awk -F';' '$1 == "=" && $3 == "IPv4" && match($0, /"ty=Brother [A-Za-z0-9-]+/) {
			print substr($0, RSTART + 12, RLENGTH - 12), $7, $8
			exit
		}'
}

superluminal_dir=~/.local/superluminal
obs_basic=~/.config/obs-studio/basic
pdfx_dir=~/.wine/drive_c/"Program Files/PDF-XChange"

# Ask everything, setting the want_* variables that the steps go by.
ask_questions() {
	local a

	ask_fedora_upgrade

	# Fedora doesn't ship git.
	installed git || sudo dnf install -y git || exit
	[ -n "$(git config --global user.name)" ] ||
		{ read -p "Git name: " -r a && git config --global user.name "$a"; }
	[ -n "$(git config --global user.email)" ] ||
		{ read -p "Git email: " -r a && git config --global user.email "$a"; }

	[ -x "$superluminal_dir"/Superluminal ] ||
		{ ask superluminal "Install Superluminal profiler?" && want_superluminal=1; }

	# By hardware, without asking: CoolerControl everywhere, the desktop's fan chip driver
	# (nct6775) and OpenRGB, the ASUS laptop's tools, and cardwire for a laptop's hybrid GPU.
	want_coolercontrol=1
	if is_laptop; then
		is_asus_laptop && want_asusctl=1
		has_nvidia && want_cardwire=1
	else
		want_nct6775=1
		want_openrgb=1
	fi
	if ! installed coolercontrol && ask cc_backup "Restore CoolerControl settings from backup?"; then
		while true; do
			read -e -p "Path to the CoolerControl backup file: " -r cc_backup
			cc_backup="${cc_backup/#\~/$HOME}"
			[ -f "$cc_backup" ] && break
			echo "$cc_backup not found, try again."
		done
	fi

	# Offered only when a Brother is on the network, as its drivers install for the model found.
	installed avahi-tools || sudo dnf install -y -q avahi-tools </dev/null
	read -r brother_model brother_host brother_ip < <(find_brother)
	if installed brscan-skey; then
		want_brother=1
	elif [ -n "$brother_model" ] &&
		ask brother "Found a Brother $brother_model on the network. Install its printer and scanner drivers?"; then
		want_brother=1
	fi

	# The OBS configuration, on the desktop. Already installed if its profiles link into the repo.
	if ! is_laptop; then
		if [ "$(readlink "$obs_basic/profiles")" = "$dotfiles/config/obs/profiles" ]; then
			want_obs=1
		elif ask obs "Install the custom OBS configuration?"; then
			want_obs=1
		fi
	fi

	is_laptop && ask sleep_debug "Turn on the sleep and hibernation debug log (scripts/sleep-debug)?" &&
		want_sleep_debug=1
	[ -n "${want_sleep_debug:-}" ] &&
		ask sleep_debug_trace \
			"Also trace hibernations (pm_trace)? Shows where a hang stopped; clock off after each until online." &&
		want_sleep_debug_trace=1

	[ -d "$pdfx_dir" ] || { ask pdfx "Install PDF-XChange Editor?" && want_pdfx=1; }
	command -v PureRef >/dev/null || want_pureref=1

	ask_text workspaces "Workspaces:" valid_workspaces \
		"VS Code workspaces for Meta+C, Meta+<letter>, as <letter>:<absolute path>,... with distinct
letters and no trailing slashes, like M:/home/me/project,X:/home/me/other (empty for none).
Meta+<letter> is taken from whatever else uses it."

	if secure_boot && ! mok_key_ok; then
		ask_mok_password
	fi
}

# --------------------------------------------------------------------------------------------------
# Repositories and kernel module signing.
# --------------------------------------------------------------------------------------------------

# Enable COPR repo $1 (owner/project) if it isn't yet.
copr() {
	compgen -G "/etc/yum.repos.d/_copr*:${1/\//:}.repo" >/dev/null || sudo dnf copr enable -y "$1"
}

add_repositories() {
	# RPM Fusion, for the NVIDIA driver and the codecs that Fedora leaves out.
	if ! installed rpmfusion-free-release || ! installed rpmfusion-nonfree-release; then
		sudo dnf install -y \
			"https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$fedora.noarch.rpm" \
			"https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$fedora.noarch.rpm"
	fi

	# Terra, for most of what Fedora doesn't have: cardwire, asusctl, CoolerControl, keyd, OpenRazer,
	# Polychromatic, gping and the Nerd Fonts. Its terra-release package adds the repo and its key.
	# shellcheck disable=SC2016 # $releasever is for dnf.
	installed terra-release ||
		sudo dnf install -y --nogpgcheck \
			--repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release

	# COPRs: FSearch from its author, and acpi_call for scripts/bin/asus-power-limits.
	copr cboxdoerfer/fsearch
	[ -n "${want_asusctl:-}" ] && copr rhea/acpi_call

	# The vendors' own repos. Fedora has Grafana too, but years behind.
	write_root_file /etc/yum.repos.d/brave-browser.repo <<'EOF'
[brave-browser]
name=Brave Browser
baseurl=https://brave-browser-rpm-release.s3.brave.com/$basearch
enabled=1
gpgcheck=1
gpgkey=https://brave-browser-rpm-release.s3.brave.com/brave-core.asc
EOF
	write_root_file /etc/yum.repos.d/vscode.repo <<'EOF'
[code]
name=Visual Studio Code
baseurl=https://packages.microsoft.com/yumrepos/vscode
enabled=1
autorefresh=1
type=rpm-md
gpgcheck=1
gpgkey=https://packages.microsoft.com/keys/microsoft.asc
EOF
	write_root_file /etc/yum.repos.d/nordvpn.repo <<'EOF'
[nordvpn]
name=NordVPN
baseurl=https://repo.nordvpn.com/yum/nordvpn/centos/$basearch
enabled=1
gpgcheck=1
gpgkey=https://repo.nordvpn.com/gpg/nordvpn_public.asc
EOF
	write_root_file /etc/yum.repos.d/grafana.repo <<'EOF'
[grafana]
name=Grafana
baseurl=https://rpm.grafana.com
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://rpm.grafana.com/gpg.key
EOF
}

# With Secure Boot on, the kernel only loads modules signed by a key the firmware trusts. akmods
# (NVIDIA, OpenRazer) and DKMS (acpi_call) both sign with akmods' key, which mokutil queues: on the
# next boot, MOK Manager asks for the password to enroll it. Until then those modules don't load.
set_up_module_signing() {
	local hash_file
	sudo dnf install -y akmods kmodtool mokutil openssl
	sudo test -f "$akmods_cert" || sudo kmodgenca -a
	write_root_file /etc/dkms/framework.conf.d/akmods-key.conf <<EOF
# Sign DKMS modules with the akmods key, see start_fresh.
mok_signing_key="/etc/pki/akmods/private/private_key.priv"
mok_certificate="$akmods_cert"
EOF
	if [ -n "${mok_hash:-}" ] && ! mok_key_ok; then
		hash_file=$(mktemp)
		echo "$mok_hash" >"$hash_file"
		sudo mokutil --import "$akmods_cert" --hash-file "$hash_file" && need_mok_enroll=1
		rm -f "$hash_file"
	fi
}

# --------------------------------------------------------------------------------------------------
# Packages.
# --------------------------------------------------------------------------------------------------

# Fill dnf_apps, flatpak_apps, groups (the user joins them) and services (enabled and started),
# for this machine's hardware and the answers.
choose_packages() {
	dnf_apps=(
		@c-development @development-tools git curl wget unzip openssh-clients
		bat btop htop tree fzf fd-find ripgrep the_silver_searcher shfmt ShellCheck gping sqlite xclip
		kitty tmux cascadiacode-nerd-fonts
		brave-browser code okular inkscape obs-studio gimp
		vlc vlc-plugins-all vlc-plugins-freeworld flameshot nextcloud-client
		qalculate-gtk speedcrunch fsearch syncthing
		texlive-scheme-full texlive-latexindent perl-YAML-Tiny perl-File-HomeDir
		openrazer-meta akmod-openrazer polychromatic keyd
		flatpak rustup nodejs npm grafana wine winetricks nordvpn nordvpn-gui
		# Loads the ntsync kernel module at boot. Wine then does its thread syncing in the kernel,
		# instead of a slow round trip to wineserver each time.
		ntsync-autoload
		# To build RAD Debugger, below.
		clang lld llvm libX11-devel libXext-devel libXfixes-devel mesa-libGL-devel mesa-libEGL-devel
		freetype-devel
	)
	flatpak_apps=(
		com.github.tchx84.Flatseal
		io.github.tanaybhomia.Whisp
		io.github.tanaybhomia.DeepDive
		io.github.amit9838.mousam
		md.obsidian.Obsidian
		me.proton.Pass
		com.xnview.XnViewMP
	)
	groups=(plugdev nordvpn)
	services=(grafana-server nordvpnd keyd)

	# The NVIDIA driver, as an akmod: akmods builds it for each new kernel. The CUDA package also
	# has nvidia-smi.
	has_nvidia && dnf_apps+=(akmod-nvidia xorg-x11-drv-nvidia-cuda)
	[ -n "${want_coolercontrol:-}" ] && dnf_apps+=(coolercontrol) && services+=(coolercontrold)
	# A tablet needs an on-screen keyboard.
	is_convertible && dnf_apps+=(plasma-keyboard)
	# To build and load the accelerometer fix, see scripts/hid-bpf/amd-sfh-accel.bpf.c.
	has_amd_sfh && dnf_apps+=(udev-hid-bpf clang bpftool libbpf-devel)
	# libinput record and debug-events, to look at what the touchpad sends, see scripts/touchpad.
	is_laptop && dnf_apps+=(libinput-utils)
	# OpenRGB itself comes from upstream, see install_openrgb.
	[ -n "${want_openrgb:-}" ] && dnf_apps+=(i2c-tools) && groups+=(i2c)
	# acpi_call is for scripts/bin/asus-power-limits.
	[ -n "${want_asusctl:-}" ] && dnf_apps+=(asusctl asusctl-rog-gui acpi_call-dkms) &&
		services+=(asusd)
	[ -n "${want_cardwire:-}" ] && dnf_apps+=(cardwire cardwire-gui) && services+=(cardwired)
	if [ -n "${want_brother:-}" ]; then
		# Brother's installer tool needs wget, and the scanner driver is a SANE backend.
		dnf_apps+=(cups wget sane-backends) && services+=(cups)
		# The printer driver is 32-bit. Installed here, else the tool would ask dnf for them, and
		# dnf would wait on its own question.
		installed brscan-skey || dnf_apps+=(glibc.i686 libstdc++.i686 libgcc.i686)
	fi
}

install_packages() {
	local installed_groups p missing=()
	# The full FFmpeg and AMD's hardware video decoding, in place of Fedora's builds without the
	# patented codecs. --allowerasing swaps them for Fedora's. Before the rest, which may need them.
	installed ffmpeg || sudo dnf install -y --allowerasing ffmpeg
	installed mesa-va-drivers-freeworld || sudo dnf install -y --allowerasing mesa-va-drivers-freeworld
	# cardwire replaces switcheroo-control, which Fedora KDE ships, and the two conflict.
	[ -n "${want_cardwire:-}" ] && installed switcheroo-control &&
		sudo dnf swap -y switcheroo-control cardwire

	# Only those not installed yet, else dnf lists each one that is. A name may be a package, a
	# group (@...), a capability (nodejs) or another arch's package (glibc.i686). The group list
	# comes from root's dnf, which already trusts the repos' keys, and without stdin, so it can't
	# wait on a question.
	installed_groups=" $(sudo dnf -q group list --installed --hidden </dev/null 2>/dev/null |
		awk 'NR > 1 { printf "%s ", $1 }')"
	for p in "${dnf_apps[@]}"; do
		if [[ $p == @* ]]; then
			[[ $installed_groups == *" ${p#@} "* ]] || missing+=("$p")
		else
			installed "$p" || rpm -q --whatprovides "$p" >/dev/null 2>&1 || missing+=("$p")
		fi
	done
	# One package gone from a repo shouldn't hold up the rest. Any other problem fails the whole
	# install, and everything after needs it, so stop there.
	if [ ${#missing[@]} -gt 0 ] && ! sudo dnf install -y --skip-unavailable "${missing[@]}"; then
		say "Installing the packages failed, see above. Fix it and run this again." >&2
		exit 1
	fi
}

# Download URLs of the assets matching regex $2 in the latest release of OpenRGB's repo $1.
openrgb_release_assets() {
	curl -fsSL "https://codeberg.org/api/v1/repos/OpenRGB/$1/releases/latest" |
		grep -oE '"browser_download_url":"[^"]+"' | cut -d'"' -f4 | grep -E "$2"
}

# OpenRGB from its latest upstream release, with its own hidapi-hotplug library. It replaces
# Fedora's packages, which are older, can't read the profiles in config/OpenRGB, and are only the
# fallback. A Fedora upgrade puts Fedora's back, which the next run swaps out again.
install_openrgb() {
	local dir url hidapi_url ver have hidapi_rpm actions
	dir=$(mktemp -d)
	# An .rpm per Fedora version, like openrgb_1.1_x86_64_f44_8e16de2.rpm: take this version's, or
	# the latest one before it.
	url=$(openrgb_release_assets OpenRGB '_x86_64_f[0-9]+_[0-9a-f]+\.rpm$' |
		awk -v fedora="$fedora" 'match($0, /_f[0-9]+_[0-9a-f]+\.rpm$/) {
			f = substr($0, RSTART + 2) + 0
			if (f <= fedora && f > best) { best = f; url = $0 }
		} END { print url }')
	hidapi_url=$(openrgb_release_assets hidapi-hotplug '/hidapi-hotplug-[0-9][^/]*\.x86_64\.rpm$' |
		head -n 1)
	# The file is named for version 1.1, say, and the package inside is 1.1.0. hidapi-hotplug's
	# file is named for its exact package.
	ver=$(sed -nE 's|.*/openrgb_([0-9.]+)_.*|\1|p' <<<"$url")
	have=$(rpm -q --qf '%{VERSION}' openrgb 2>/dev/null)
	hidapi_rpm=${hidapi_url##*/}
	actions=(--action=install "$dir"/{openrgb,hidapi-hotplug}.rpm)
	installed openrgb-udev-rules && actions+=(--action=remove openrgb-udev-rules)
	if [ -n "$ver" ] && { [ "$have" = "$ver" ] || [ "$have" = "$ver.0" ]; } &&
		installed "${hidapi_rpm%.x86_64.rpm}" && ! installed openrgb-udev-rules; then
		: # Up to date.
	elif [ -n "$url" ] && [ -n "$hidapi_url" ] &&
		curl -fsSL -o "$dir"/openrgb.rpm "$url" &&
		curl -fsSL -o "$dir"/hidapi-hotplug.rpm "$hidapi_url" &&
		sudo dnf "do" -y --skip-unavailable "${actions[@]}"; then
		say "Installed OpenRGB $(rpm -q --qf '%{VERSION}' openrgb) from upstream."
	else
		failed "Could not install upstream OpenRGB, falling back to Fedora's older one."
		installed openrgb || sudo dnf install -y openrgb
	fi
	rm -rf "$dir"
}

# The Brother's printer driver packages, named for the model without its dashes, like its print
# queue.
brother_driver_packages() {
	local queue=${brother_model//-/}
	rpm -qa --qf '%{NAME}\n' "${queue,,}*"
}

# The Brother's scanner driver package: brscan4 or brscan5, by model.
brother_scanner_package() { rpm -qa --qf '%{NAME}\n' 'brscan[0-9]' | head -n 1; }

# The Brother printer and scanner, by Brother's installer tool: the printer driver, the scanner
# driver and its scan-button tool (brscan-skey). If the printer's IP address changes, run
#   sudo brsaneconfig4 -r <model> && sudo brsaneconfig4 -a name=<model> model=<model> ip=<new>
install_brother_drivers() {
	local dir tool
	dir=$(mktemp -d)
	tool=$dir/linux-brprinter-installer
	if curl -fsSL -o "$tool.gz" \
		https://download.brother.com/welcome/dlf006893/linux-brprinter-installer-2.2.6-1.gz &&
		sha256sum -c --quiet <<<"ce0f6221f5979804c54994ad562fad87ef74e100f596115afd9218d35a568e73  $tool.gz" &&
		gunzip "$tool.gz"; then
		# Its RPMs have digests but no signatures, which RPM 6 refuses, so an rpm first on its
		# PATH checks the digests only.
		printf '#!/bin/sh\nexec /usr/bin/rpm --define "_pkgverify_level digest" "$@"\n' >"$dir/rpm"
		chmod +x "$dir/rpm"
		# The tool installs its own build of the printer driver: remove any other, else RPM keeps
		# both. That removes the printer too, which the tool adds back.
		brother_driver_packages | xargs -r sudo rpm -e --allmatches
		# It adds the printer through CUPS, which otherwise only starts with the other services.
		sudo systemctl enable --now cups
		# Its questions, answered in order: install, accept the license, specify the device URI,
		# take the one found (A), no test print, accept the two scanner licenses, the scanner's IP.
		(cd "$dir" && printf '%s\n' y y y A n y y "$brother_ip" |
			sudo env PATH="$dir:/usr/sbin:/usr/bin" bash "$tool" "$brother_model")
		{ [ -n "$(brother_driver_packages)" ] && [ -n "$(brother_scanner_package)" ] &&
			installed brscan-skey; } ||
			failed "Could not install the Brother drivers, see the full output."
	else
		failed "The Brother installer tool download failed or changed, skipping its drivers."
	fi
	sudo rm -rf "$dir"
}

# List the Brother once, as "Brother <model>", wherever a scanner or printer is picked, instead of
# under its drivers' names.
name_brother_devices() {
	local name="Brother $brother_model" queue=${brother_model//-/} scanner uri
	# Fedora's eSCL backend (sane-airscan) finds the same scanner, so hide it there.
	write_root_file "/etc/sane.d/airscan.d/brother-${brother_model,,}.conf" <<EOF
[blacklist]
model = "*$brother_model"
EOF
	# A SANE alias also hides the original name, like brother4:net1;dev0 for brscan4.
	scanner=$(brother_scanner_package)
	[ -z "$scanner" ] || write_root_file /etc/sane.d/dll.aliases <<EOF
alias "$name" brother${scanner#brscan}:net1;dev0
EOF
	# CUPS can't rename a print queue, and its name can't have spaces: add the printer again under
	# the new name, then remove the old one, which a driver reinstall brings back.
	uri=$(lpstat -v "$queue" 2>/dev/null | sed -n "s/^device for $queue: //p")
	if [ -n "$uri" ] &&
		sudo lpadmin -p "Brother_$brother_model" -E -v "$uri" -P "/etc/cups/ppd/$queue.ppd" \
			-D "$name"; then
		sudo lpadmin -x "$queue"
	fi
}

# Build the kernel modules for the newest kernel now, rather than on its first boot, which would
# hold up the desktop for minutes.
build_kernel_modules() {
	local newest_kernel acpi_call_ver
	newest_kernel=$(rpm -q kernel --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort -V | tail -n 1)
	# acpi_call-dkms's uninstall scripts also run on an upgrade to a new build of the same version
	# (a Fedora upgrade), deleting the new source and its modules-load.d file, so DKMS builds
	# nothing. Reinstall it without scripts then: the autoinstall below builds it.
	if installed acpi_call-dkms; then
		acpi_call_ver=$(rpm -q --qf '%{VERSION}' acpi_call-dkms)
		if [ ! -f "/usr/src/acpi_call-$acpi_call_ver/dkms.conf" ]; then
			sudo dnf reinstall -y --setopt=tsflags=noscripts acpi_call-dkms
			[ -e "/var/lib/dkms/acpi_call/$acpi_call_ver/source" ] ||
				sudo dkms add -m acpi_call -v "$acpi_call_ver"
		fi
		write_root_file /etc/modules-load.d/acpi_call.conf <<<acpi_call
	fi
	if installed akmods || installed dkms; then
		installed "kernel-devel-$newest_kernel" || sudo dnf install -y "kernel-devel-$newest_kernel"
		installed dkms && sudo dkms autoinstall -k "$newest_kernel"
	fi
	if installed akmods; then
		sudo akmods --kernels "$newest_kernel"
		if has_nvidia && ! modinfo -k "$newest_kernel" nvidia >/dev/null 2>&1; then
			failed "The NVIDIA driver failed to build, see /var/cache/akmods/nvidia."
		fi
	fi
}

add_user_to_groups() {
	local g
	for g in "${groups[@]}"; do
		getent group "$g" >/dev/null || sudo groupadd --system "$g"
		sudo usermod -aG "$g" "$USER"
	done
}

# Flatpak apps, system-wide, plus the GL extension matching the NVIDIA driver for hardware
# rendering.
install_flatpak_apps() {
	local nvidia a missing=()
	sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
	nvidia=$(nvidia_version)
	[ -n "$nvidia" ] && flatpak_apps+=("org.freedesktop.Platform.GL.nvidia-${nvidia//./-}")
	# Only those not installed yet, else flatpak lists each one that is.
	for a in "${flatpak_apps[@]}"; do
		flatpak info --system "$a" >/dev/null 2>&1 || missing+=("$a")
	done
	[ ${#missing[@]} -eq 0 ] || sudo flatpak install -y --noninteractive flathub "${missing[@]}"
	# Install leaves installed apps as they are, so update them and their runtimes too.
	[ -z "$(flatpak remote-ls --system --updates 2>/dev/null)" ] ||
		sudo flatpak update -y --noninteractive
}

