#!/bin/bash
#
# Show the Windows VM's desktop through Looking Glass.
#
#   looking-glass            connect, starting the VM first if it is off
#   looking-glass -- <args>  pass anything else straight to the client
#
# The guest draws on the passed-through iGPU and the host app copies each
# finished frame into shared memory; this client maps the same memory and
# draws it. Nothing is encoded, so unlike RDP or SPICE there is no compression
# latency, and unlike virt-viewer the frames were rendered by the real GPU.
#
# Keyboard and mouse arrive over SPICE, which is why the client is given a
# SPICE address as well as the shared memory file.
#
# Written by make_windows_vm.sh; edit that instead of this.

set -o pipefail

: "${VM_NAME:={{VM_NAME}}}"
: "${LG_SHM:={{LG_SHM}}}"
: "${VIRSH:=virsh --connect qemu:///system}"
: "${LG_CLIENT:={{LG_CLIENT}}}"

die() {
	printf '\033[1;31mlooking-glass:\033[0m %s\n' "$*" >&2
	exit 1
}

[ -x "$LG_CLIENT" ] || die "client not found at $LG_CLIENT"

# Bring the VM up if it is not already.
if ! $VIRSH domstate "$VM_NAME" 2>/dev/null | grep -q running; then
	printf 'Starting %s...\n' "$VM_NAME" >&2
	$VIRSH start "$VM_NAME" >/dev/null || die "could not start $VM_NAME"
fi

# The shared memory file is created by QEMU when the VM starts, so it only
# exists once the domain is up.
deadline=$((SECONDS + 60))
while [ ! -e "$LG_SHM" ] && [ "$SECONDS" -lt "$deadline" ]; do sleep 1; done
[ -e "$LG_SHM" ] || die "$LG_SHM never appeared; is the ivshmem device attached?"
[ -r "$LG_SHM" ] || die "$LG_SHM is not readable by $USER"

# Ask libvirt where SPICE ended up rather than assuming 5900: autoport means
# the number moves as soon as a second VM is running.
spice_addr=$($VIRSH domdisplay "$VM_NAME" --type spice 2>/dev/null | tail -n1)
spice_host=${spice_addr#spice://}
spice_port=${spice_host##*:}
spice_host=${spice_host%%:*}
[ -n "$spice_port" ] && [ "$spice_port" != "$spice_host" ] ||
	die "could not work out the SPICE address (got '$spice_addr')"

# On a machine with an NVIDIA card and the proprietary driver, libglvnd hands
# the Wayland display to Mesa, which has no DRI driver for it and quietly falls
# back to llvmpipe -- the whole desktop then renders on the CPU. Naming the
# vendor file directly is what keeps the client on the GPU. Harmless elsewhere:
# the variable is only set when that vendor file is actually present.
nvidia_egl=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
if [ -e "$nvidia_egl" ] && [ -z "${__EGL_VENDOR_LIBRARY_FILENAMES:-}" ] &&
	command -v nvidia-smi >/dev/null 2>&1; then
	export __EGL_VENDOR_LIBRARY_FILENAMES=$nvidia_egl
fi

exec "$LG_CLIENT" \
	-f "$LG_SHM" \
	"spice:host=$spice_host" \
	"spice:port=$spice_port" \
	"$@"
