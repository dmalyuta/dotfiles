[Unit]
Description=Save the last hibernation's pm_trace and whether the chipset's watchdog fired, or power off after a crash
DefaultDependencies=no
After=sys-firmware-efi-efivars.mount
Before=systemd-hibernate-resume.service
ConditionPathExists=/etc/initrd-release

[Service]
Type=oneshot
ExecStart=/usr/bin/hibernate-trace-save
