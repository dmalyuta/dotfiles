#!/usr/bin/python3 -I
"""Record what the touchpad reports next to what the cursor and scrolling really do, and find
where the two disagree: cursor jumps, dead zones, late or jumpy scroll starts.

  touchpad-trace record [NAME]
      Opens a full-screen window. Move the cursor and scroll with two fingers inside it, the way
      that feels wrong (small slow movements, starts after a pause, scroll starts). Whenever it
      jumps or sticks, press Shift (or Ctrl) right after: that marks the moment. Esc ends it.
      Asks for the sudo password, to read the touchpad's raw events.
      Writes ~/touchpad-traces/NAME.trace (NAME: the date and time if not given).

  touchpad-trace analyze FILE [--lib DIR] [--all] [--tweaks FILE]
      Replays the raw events through libinput (the installed library, or the one in DIR), then
      prints, for every stroke and scroll: how far the fingers moved against how far the cursor
      or the scroll went, in the recording (KWin's libinput, with whatever state it had built up)
      and in the replay (a fresh libinput), every jump and dead zone found, and the events
      around each mark. --all prints every stroke, not just those with something found.
      --tweaks: a danylo-tweaksrc to replay with, instead of the recorded one.

  touchpad-trace convert FILE.yml FILE.trace
      Makes a trace (raw events only) from a `libinput record` file.

A trace is text: the device's description (N, I, P, B, A lines, see replay.c), C (JSON: KWin's
touchpad settings, the tweaks file, versions), then by time:
  E usec type code value     a raw event, kernel time (CLOCK_MONOTONIC)
  Q msec x y recv_usec       the cursor's position in the window, KWin's event time
  W msec dx dy ax ay recv_usec   a scroll: pixels and angle, as an application gets them
  K msec recv_usec           a mark

The replay needs gcc and libinput-devel (replay.c is built into ~/.cache/touchpad-trace).

Author: Danylo Malyuta, 2026.
"""

import collections
import glob
import json
import math
import os
import re
import select
import struct
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.realpath(__file__))
TRACES = os.path.expanduser("~/touchpad-traces")
CACHE = os.path.expanduser("~/.cache/touchpad-trace")

EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
ABS_MT_SLOT, ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 47, 53, 54, 57
BTN_LEFT = 272


def find_touchpad():
    for name_file in sorted(glob.glob("/sys/class/input/event*/device/name")):
        with open(name_file) as file:
            if file.read().strip().endswith("Touchpad"):
                return "/dev/input/" + name_file.split("/")[4]
    sys.exit("No touchpad found.")


