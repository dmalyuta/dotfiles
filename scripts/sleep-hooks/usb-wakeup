#!/bin/sh
# Before each sleep: USB keyboards may wake the machine, USB mice may not. The kernel lets any
# device with a keyboard interface wake it, which includes a mouse that has one for its extra
# buttons, so a nudge of the mouse would end the sleep. A device counts as what its first HID
# interface is. systemd sleep hook, installed by scripts/configure_hardware.

[ "$1" = pre ] || exit 0

# What a USB device's first HID interface is: its boot protocol, 01 for a keyboard and 02 for a
# mouse. Prints nothing for a device without one.
hid_kind() {
	for interface in "$1":*; do
		[ "$(cat "$interface/bInterfaceClass" 2>/dev/null)" = 03 ] || continue
		cat "$interface/bInterfaceProtocol"
		return
	done
}

for device in /sys/bus/usb/devices/*; do
	[ -w "$device/power/wakeup" ] || continue
	case $(hid_kind "$device") in
	01) state=enabled ;;
	02) state=disabled ;;
	*) continue ;;
	esac
	[ "$(cat "$device/power/wakeup")" = "$state" ] && continue
	echo "$state" >"$device/power/wakeup"
	# Logged before the freeze, so the journal has the state it went to sleep in.
	logger -t usb-wakeup "$(cat "$device/product" 2>/dev/null) at ${device##*/} -> $state"
done
exit 0
