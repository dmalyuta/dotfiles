#!/bin/bash
# Custom fan curves for the ProArt PX13, applied through asusd, which saves them and reapplies
# them on every profile switch. They are what G-Helper applies on Windows with "Apply custom fan
# curve" ticked: the firmware's curves spread out to 100 C, so the fans ramp later and more gently,
# up to the same top speeds.
#
# What the EC does with a curve:
# - It is a staircase: each point's speed holds from its temperature up to the next point, with
#   no interpolation, and the first point's speed also applies below it.
# - The fan steps up a few seconds after the CPU temperature reaches a point, and back down only
#   once it is 5 C below that point.
# - Speed is rpm ~= 2450 + 19.7 * pwm (pwm 0-255). There is no speed between off and 2500 rpm.
# - With the dGPU off, the GPU fan follows a slower board sensor that runs below the CPU's
#   temperature, so on the same curve it lags the CPU fan.
#
# Usage: asus-fan-curves [--reset]   (--reset goes back to the firmware's own curves)
# shellcheck disable=SC2034 # the curves are read through ${!curve}
set -eu

# temp:pwm points per profile, for the CPU and the GPU fan. Comments give the rpm. The kernel
# sends the EC percent = pwm * 100 / 255, rounded down, so these pwm values are G-Helper's percents
# rounded up. Don't pass asusctl percents instead: it maps 1% to pwm 2, which reaches the EC as 0%.
#               off       2500      2750      3050      3750      3750      3750      3750
quiet_cpu="30c:0,48c:3,52c:16,60c:31,70c:67,80c:67,90c:67,100c:67"
quiet_gpu="30c:0,48c:3,52c:16,60c:31,70c:64,80c:64,90c:64,100c:64"
#                off       2500      2750      3050      3750      4150      4450       4850
balanced_cpu="30c:0,47c:3,50c:16,60c:31,70c:67,80c:87,90c:102,100c:123"
balanced_gpu="30c:0,47c:3,50c:16,60c:31,70c:64,80c:82,90c:97,100c:115"
#                   off       2500      2750      3050      4150      4850       5350       6150
performance_cpu="30c:0,49c:3,52c:16,60c:31,70c:87,80c:123,90c:148,100c:189"
performance_gpu="30c:0,49c:3,52c:16,60c:31,70c:82,80c:115,90c:141,100c:169"

for profile in quiet balanced performance; do
	if [ "${1:-}" = --reset ]; then
		asusctl fan-curve --mod-profile "$profile" --enable-fan-curves false
		continue
	fi
	for fan in cpu gpu; do
		curve=${profile}_$fan
		asusctl fan-curve --mod-profile "$profile" --fan "$fan" --data "${!curve}"
	done
	# Writing a curve with --data marks it disabled, so enable afterwards.
	asusctl fan-curve --mod-profile "$profile" --enable-fan-curves true
done
