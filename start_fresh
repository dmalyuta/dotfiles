# Syncthing, as a user service. Its web UI is on 127.0.0.1:8384, and also at
# http://syncthing.localhost through a loopback-only proxy from port 80 (Syncthing takes
# *.localhost as local, so its check against DNS rebinding stays on). Sets $syncthing_changed if
# this run set any of it up.
set_up_syncthing() {
	local b proxy_changed=
	systemctl --user -q is-enabled syncthing.service 2>/dev/null || syncthing_changed=1
	systemctl --user enable --now syncthing.service
	write_root_file /etc/systemd/system/syncthing-gui-proxy.socket <<'EOF' && proxy_changed=1
[Unit]
Description=Syncthing web UI at http://syncthing.localhost, see start_fresh

[Socket]
ListenStream=127.0.0.1:80
ListenStream=[::1]:80

[Install]
WantedBy=sockets.target
EOF
	write_root_file /etc/systemd/system/syncthing-gui-proxy.service <<'EOF' && proxy_changed=1
[Unit]
Description=Forward http://syncthing.localhost to the Syncthing web UI
Requires=syncthing-gui-proxy.socket
After=syncthing-gui-proxy.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=5min 127.0.0.1:8384
# No root powers, as systemd hands it the socket. Nothing may imply NoNewPrivileges (DynamicUser=
# and most sandboxing do): SELinux would then keep it out of systemd_socket_proxyd_t, which may
# connect to 8384.
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
EOF
	# SELinux lets the proxy use only a few ports: these booleans let it listen on 80 and connect
	# to 8384.
	for b in systemd_socket_proxyd_bind_any systemd_socket_proxyd_connect_any; do
		[ "$(getsebool "$b" 2>/dev/null)" = "$b --> on" ] ||
			{ sudo setsebool -P "$b" 1 && proxy_changed=1; }
	done
	if [ -n "$proxy_changed" ]; then
		sudo systemctl daemon-reload
		sudo systemctl restart syncthing-gui-proxy.socket
		syncthing_changed=1
	fi
	sudo systemctl enable --now syncthing-gui-proxy.socket
}

# Anaconda, in batch mode, which accepts the license and doesn't touch ~/.bashrc: .local.bashrc
# sets conda up instead, since `conda init`'s block delays every prompt by ~1 s.
install_anaconda() {
	if [ ! -d ~/anaconda3 ]; then
		curl -fL -o anaconda.sh \
			"https://repo.anaconda.com/archive/Anaconda3-2026.07-1-Linux-x86_64.sh" &&
			bash anaconda.sh -b -p ~/anaconda3
