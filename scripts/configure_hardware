#!/bin/bash
#
# Low-level hardware setup: GPUs, kernel command line, initramfs, wake sources, CPU power readings,
# sleep and hibernation, the ASUS laptop's quirks, and the patched libraries. Run by start_fresh
# after it installs the software, and safe to re-run on its own.
#
# Usage: configure_hardware
#
# Exits with status 2 if a setting changed that takes a reboot to apply.
#
# The steps are at the bottom, in the order they run. The functions above them do the work.
#
# Author: Danylo Malyuta, 2026.

dotfiles=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
. "$dotfiles"/scripts/functions.sh

nvidia_version=$(nvidia_version)

# --------------------------------------------------------------------------------------------------
# GPUs.
# --------------------------------------------------------------------------------------------------

# On a laptop with an AMD iGPU, show Vulkan apps only that one: Electron apps (Obsidian, VS Code)
# list every GPU through Vulkan at startup, which wakes the NVIDIA dGPU for ~20 s. bin/nvidia-run
# runs one on the dGPU. Not on the desktop, whose screens are on the NVIDIA card: an app drawing on
# the iGPU can't show its window there ("importing the supplied dmabufs failed").
hide_dgpu_from_vulkan() {
	local conf=~/.config/environment.d/60-vulkan-igpu.conf
	local radeon_icd=/usr/share/vulkan/icd.d/radeon_icd.x86_64.json
	if is_laptop && [ -n "$nvidia_version" ] && lspci -d 1002: | grep -qE 'VGA|3D|Display'; then
		mkdir -p ~/.config/environment.d
		cat >"$conf" <<EOF
# Vulkan apps only see the AMD iGPU, so they don't wake the NVIDIA dGPU. nvidia-run uses the dGPU.
VK_DRIVER_FILES=$radeon_icd
VK_ICD_FILENAMES=$radeon_icd
EOF
	else
		rm -f "$conf"
	fi
}

# --------------------------------------------------------------------------------------------------
# Kernel.
# --------------------------------------------------------------------------------------------------

# Zen 5's 32-bit RDSEED is broken until a microcode fix that needs a BIOS update, so the kernel
# prints "RDSEED32 is broken" on screen at every boot (and harmlessly turns it off). It's logged
# at emergency level, which only loglevel=0 keeps off the console. Panics still show. New kernels
# copy the option from the running one.
hide_rdseed_boot_message() {
	if journalctl -k -b 0 -q -g 'RDSEED32 is broken' >/dev/null 2>&1 &&
		! sudo grubby --info=DEFAULT | grep -q '^args=.*\bloglevel=0\b'; then
		sudo grubby --update-kernel=ALL --args=loglevel=0
		reboot_for "kernel option loglevel=0, which hides the RDSEED32 boot message"
	fi
}

# The hardware clock in UTC, Linux's default, unless Windows is installed, which keeps it in local
# time: systemd never updates a local-time clock, so it's an hour off after each daylight saving
# change. Look for Windows itself, as its boot entry can outlive it.
keep_hardware_clock_in_utc() {
	if sudo test -e /boot/efi/EFI/Microsoft/Boot/bootmgfw.efi &&
		lsblk -nro FSTYPE | grep -qixE 'ntfs|bitlocker'; then
		[ "$(timedatectl show -p LocalRTC --value)" = yes ] ||
			say "Windows is installed: run 'sudo timedatectl set-local-rtc 1' if its clock is off."
	elif [ "$(timedatectl show -p LocalRTC --value)" = yes ]; then
		sudo timedatectl set-local-rtc 0
	fi
}

# --------------------------------------------------------------------------------------------------
# USB devices and wake sources.
# --------------------------------------------------------------------------------------------------

# Remove what earlier versions installed and newer ones replaced: udev rules for the USB wake
# sources, and the webcam guard under its first name (start_fresh installs it where it's needed).
remove_replaced_files() {
	if [ -e /etc/udev/rules.d/90-usb-wakeup.rules ]; then
		sudo rm -f /etc/udev/rules.d/90-usb-wakeup.rules
		sudo udevadm control --reload
	fi
	if [ -e /etc/systemd/system/c920-guard.service ]; then
		sudo systemctl disable --now c920-guard
		sudo rm -f /etc/systemd/system/c920-guard.service /usr/local/bin/c920-guard \
			/usr/lib/systemd/system-sleep/c920-guard
		sudo systemctl daemon-reload
	fi
}

# --------------------------------------------------------------------------------------------------
# Laptop sleep and hibernation.
# --------------------------------------------------------------------------------------------------

# Let the NVIDIA dGPU power off in sleep and whenever it's idle (runtime D3, see
# /proc/driver/nvidia/gpus/*/power). The laptop only has s2idle sleep, which reaches the SoC's
# deepest state only with every device off, and the driver keeps the dGPU on unless told
# (~1.5%/h).
#
# The driver's own sleep hook (UseKernelSuspendNotifiers) is off, as hibernation hung with it; RPM
# Fusion's nvidia-suspend, -hibernate and -resume services do its part instead. Keep systemd's
# default HibernateMode, platform: shutdown and reboot hang in the driver's nv_pci_shutdown.
set_nvidia_power_management() {
	write_root_file /etc/modprobe.d/nvidia-power.conf <<'EOF' &&
options nvidia NVreg_EnableS0ixPowerManagement=1
options nvidia NVreg_DynamicPowerManagement=0x02
options nvidia NVreg_UseKernelSuspendNotifiers=0
EOF
		reboot_for "NVIDIA power management options (/etc/modprobe.d/nvidia-power.conf)"
}

# An initramfs that can resume from hibernation: with dracut's resume module, which it leaves out
# without resume= on the kernel command line, and without the GPU drivers. The resumed kernel can't
# restore an iGPU that the initramfs set up ("MES failed to respond", the screen stays black), and
# an NVIDIA driver loaded there refuses the freeze before the resume (nv_pmops_freeze), so the
# image is dropped. RPM Fusion's 99-nvidia-dracut.conf already keeps NVIDIA's out.
set_up_initramfs_for_hibernation() {
	local rebuild=
	write_root_file /etc/dracut.conf.d/90-hibernate.conf <<'EOF' && rebuild=1
# Hibernation, see scripts/configure_hardware: resume, and without amdgpu, which can't resume
# from the initramfs.
add_dracutmodules+=" resume "
omit_drivers+=" amdgpu "
EOF
	# Also rebuild if a past rebuild was skipped or failed, so no initramfs still has a GPU driver.
	sudo find /boot -maxdepth 1 -name 'initramfs-*.img' ! -name '*rescue*' -exec lsinitrd {} \; \
		2>/dev/null | grep -q -E '/(nvidia|amdgpu)\.ko' && rebuild=1
	if [ -n "$rebuild" ]; then
		sudo dracut -f --regenerate-all
		reboot_for "initramfs rebuilt for hibernation"
	fi
}

# Hibernation goes to a swapfile as big as RAM (zram can't hold the image), in its own subvolume:
# btrfs can't snapshot one with an active swapfile. SELinux needs it labeled swapfile_t. systemd
# finds it on resume through an EFI variable, so no resume= is needed.
swapfile=/var/swap/swapfile
create_hibernation_swapfile() {
	local ram_gb
	ram_gb=$(awk '/MemTotal/ { print int($2 / 1048576) + 1 }' /proc/meminfo)
	sudo btrfs subvolume show /var/swap >/dev/null 2>&1 || sudo btrfs subvolume create /var/swap
	sudo semanage fcontext -l -C | grep -q '^/var/swap(/\.\*)?\s' ||
		sudo semanage fcontext -a -t swapfile_t '/var/swap(/.*)?'
	sudo btrfs filesystem mkswapfile --size "${ram_gb}g" "$swapfile"
	sudo restorecon -R /var/swap
	grep -q "^${swapfile}[[:space:]]" /etc/fstab ||
		{ cat /etc/fstab && echo "$swapfile none swap defaults 0 0"; } | write_root_file /etc/fstab
	sudo systemctl daemon-reload
	sudo swapon "$swapfile"
}

# Sleep, then hibernate after 50 min on battery (on AC it stays asleep), or with "off", back to
# plain sleep. Sleep draws ~0.64 W and a hibernation costs ~0.53 Wh to enter and leave
# (bin/sleep_stats, 2026-11), so after 50 min sleeping has cost more than hibernating would have.
sleep_then_hibernate() {
	local profile sleep_mode=(--delete)
	local sleep_conf=/etc/systemd/sleep.conf.d/50-suspend-then-hibernate.conf
	local suspend_dropin=/etc/systemd/system/systemd-suspend.service.d/50-suspend-then-hibernate.conf
	if [ "$1" = on ]; then
		write_root_file "$sleep_conf" <<'EOF'
[Sleep]
HibernateDelaySec=50min
HibernateOnACPower=no
EOF
		# The Plasma menu's Sleep asks logind for a plain suspend, so make that one sleep then
		# hibernate too.
		write_root_file "$suspend_dropin" <<'EOF' && sudo systemctl daemon-reload
[Service]
ExecStart=
ExecStart=/usr/lib/systemd/systemd-sleep suspend-then-hibernate
EOF
		# KDE's "Standby, then hibernate".
		sleep_mode=(3)
	else
		sudo rm -f "$sleep_conf"
		if [ -e "$suspend_dropin" ]; then
			sudo rm -f "$suspend_dropin"
			sudo systemctl daemon-reload
		fi
	fi
	for profile in AC Battery LowBattery; do
		kconf --file powerdevilrc --group "$profile" --group SuspendAndShutdown --key SleepMode \
			"${sleep_mode[@]}"
	done
}

# Pack and unpack the hibernation image on half of the CPU's threads instead of the kernel's 3: the
# compression is what a hibernation spends most of its time and battery on, and the same work done
# sooner means less time with everything else powered. On the command line rather than in
# /sys/power, so that the kernel that loads the image at resume uses them too.
set_hibernation_compression_threads() {
	local threads=$(($(nproc --all) / 2))
	# Older kernels don't have the option.
	[ -e /sys/power/hibernate_compression_threads ] && [ "$threads" -gt 3 ] || return 0
	if ! sudo grubby --info=DEFAULT |
		grep -q "^args=.*\\bhibernate_compression_threads=$threads\\b"; then
		sudo grubby --update-kernel=ALL --args="hibernate_compression_threads=$threads"
		reboot_for "kernel option hibernate_compression_threads=$threads, for faster hibernation"
	fi
}

# Skip GRUB's menu and its timeout at the boot that resumes a hibernation, see the menu part.
skip_boot_menu_on_resume() {
	installed grub2-tools || return 0
	if install_script_file grub/15_hibernate_resume /etc/grub.d/15_hibernate_resume 755 ||
		! sudo grep -qs 'hibernated' /boot/grub2/grub.cfg; then
		sudo grub2-mkconfig -o /boot/grub2/grub.cfg >/dev/null 2>&1 ||
			failed "Could not rebuild GRUB's menu (grub2-mkconfig), see the full output."
	fi
}

# Turn hibernation off, so KDE never offers it (it would if a big enough swap showed up).
disable_hibernation() {
	write_root_file /etc/systemd/sleep.conf.d/50-no-hibernate.conf <<'EOF'
[Sleep]
AllowHibernation=no
AllowSuspendThenHibernate=no
AllowHybridSleep=no
EOF
}

# --------------------------------------------------------------------------------------------------
# ASUS laptop.
# --------------------------------------------------------------------------------------------------

# Keep the keyboard backlight dark from the initramfs on (scripts/dracut/asus-kbd-dark), as
# asus-kbd-dark below does later in the boot: the controller forgets it at each power-off, so
# without this the backlight pulses 4 s into a cold boot, and after a hibernation until its image
# is loaded. Its program is built here, and kept with its source to rebuild only
# when that changes.
set_up_asus_keyboard_backlight_initramfs() {
	local src=scripts/dracut/asus-kbd-dark
	local module=/usr/lib/dracut/modules.d/90asus-kbd-dark
	local program=/usr/local/lib/asus-kbd-dark/asus-kbd-dark-initrd
	local build f img rebuild=
	if [ ! -f "$program" ] || ! sudo cmp -s "$dotfiles/$src/${program##*/}.c" "$program.c"; then
		build=$(mktemp -d)
		if gcc -O2 -Wall -Wextra -o "$build/program" "$dotfiles/$src/${program##*/}.c"; then
			sudo install -Z -Dm755 "$build/program" "$program"
			sudo install -Z -Dm644 "$dotfiles/$src/${program##*/}.c" "$program.c"
		else
			failed "Could not build the keyboard backlight's initramfs step, so it will pulse" \
				"at power-on."
		fi
		rm -rf "$build"
	fi
	[ -f "$program" ] || return 0
	install_script_file "${src#scripts/}/module-setup.sh" "$module/module-setup.sh" 755 && rebuild=1
	f=asus-kbd-dark-initrd.service
	install_script_file "${src#scripts/}/$f" "$module/$f" && rebuild=1
	write_root_file /etc/dracut.conf.d/92-asus-kbd-dark.conf <<'EOF' && rebuild=1
# The ASUS keyboard backlight stays dark from the initramfs on, see scripts/configure_hardware.
add_dracutmodules+=" asus-kbd-dark "
EOF
	# Also rebuild if an initramfs lacks the current program, as when a rebuild was interrupted.
	for img in /boot/initramfs-*.img; do
		[[ $img == *rescue* ]] && continue
		sudo lsinitrd -f usr/bin/asus-kbd-dark-initrd "$img" 2>/dev/null |
			sudo cmp -s - "$program" || rebuild=1
	done
	if [ -n "$rebuild" ]; then
		sudo dracut -f --regenerate-all
		reboot_for "initramfs rebuilt for the keyboard backlight"
	fi
}

# Keep the keyboard backlight dark while the laptop starts, instead of pulsing until asusd is up
# (scripts/bin/asus-kbd-dark), and reset the keyboard controller after a hibernation
# (scripts/bin/asus-kbd-rebind).
set_up_asus_keyboard_backlight() {
	local led=/sys/class/leds/asus::kbd_backlight
	# Run once now as well, at the brightness it has: the controller keeps "no animation at
	# power-on" from it.
	install_command asus-kbd-dark &&
		sudo /usr/local/bin/asus-kbd-dark "$(cat "$led/brightness" 2>/dev/null || echo 0)"
	install_udev_rule 90-asus-kbd-dark.rules
	set_up_asus_keyboard_backlight_initramfs
	if installed asusctl; then
		# asusd sets the backlight, while systemd-backlight restores whatever it saved at
		# shutdown, which can be 0.
		sudo systemctl mask "systemd-backlight@leds:${led##*/}.service"
		install_command asus-kbd-rebind
		install_unit asus-kbd-rebind.service
		sudo systemctl enable asus-kbd-rebind
	fi
}

# Keep the power profile that was last chosen (in KDE's battery menu, or with powerprofilesctl):
# neither KDE nor asusd switches it on AC or on battery. tuned-ppd holds it, sets platform_profile
# from it (which asusd follows), and saves it in /etc/tuned/ppd_base_profile, from which it starts
# at the next boot.
keep_chosen_power_profile() {
	local p source
	# Without the key, KDE leaves the profile unchanged for that power source.
	for p in AC Battery LowBattery; do
		kconf --file powerdevilrc --group "$p" --group Performance --key PowerProfile --delete
	done
	busctl --user call org.kde.Solid.PowerManagement /org/kde/Solid/PowerManagement \
		org.kde.Solid.PowerManagement reparseConfiguration >/dev/null 2>&1
	systemctl -q is-active asusd || return 0
	for source in Ac Battery; do
		busctl --system set-property xyz.ljones.Asusd /xyz/ljones xyz.ljones.Platform \
			"ChangePlatformProfileOn$source" b false
	done
}

# Per-profile CPU power limits, lower in Quiet for battery life, see scripts/bin/asus-power-limits.
# With Secure Boot on, acpi_call only loads once its signing key is enrolled, see start_fresh.
install_power_limits() {
	install_sleep_hook bin/asus-power-limits
	install_unit asus-power-limits.service
	install_command asus-power-limits && sudo systemctl try-restart asus-power-limits
	sudo systemctl enable --now asus-power-limits
}

# The laptop is a 2-in-1, but asus-nb-wmi has no quirk for it, so it never reports tablet mode. Use
# its lid-flip sensor (WMI device 0x00060062), on "Asus WMI hotkeys", which keyd leaves alone.
enable_tablet_mode_switch() {
	write_root_file /etc/modprobe.d/asus-tablet-mode.conf <<'EOF' &&
options asus_nb_wmi tablet_mode_sw=2
EOF
		reboot_for "tablet mode switch (/etc/modprobe.d/asus-tablet-mode.conf)"
}

# --------------------------------------------------------------------------------------------------
# Screen rotation.
# --------------------------------------------------------------------------------------------------

# Whether a HID device's report descriptor still ends with the field that the accelerometer fix
# removes (see the program's motion_state_tail).
has_motion_state_field() {
	[[ $(od -An -tx1 -v "$1/report_descriptor" | tr -d ' \n') == *0a510415002501750895018102c0 ]]
}

# Since kernel 7.1 the accelerometer's readings are dropped, so the screen doesn't rotate: a
# HID-BPF program fixes its report descriptor, see scripts/hid-bpf/amd-sfh-accel.bpf.c. Built
# against the running kernel's types (CO-RE, so later kernels load it too), and loaded by udev at
# boot.
install_accelerometer_fix() {
	local src=$dotfiles/scripts/hid-bpf/amd-sfh-accel.bpf.c
	local obj=/etc/udev-hid-bpf/amd-sfh-accel.bpf.o
	local build dev attached=
	# Its source is kept next to it, to rebuild only when it changes.
	if [ ! -f "$obj" ] || ! sudo cmp -s "$src" "${obj%.o}.c"; then
		build=$(mktemp -d)
		if bpftool btf dump file /sys/kernel/btf/vmlinux format c >"$build/vmlinux.h" &&
			clang -O2 -g -target bpf -Wno-missing-declarations -I"$build" \
				-c "$src" -o "$build/fix.bpf.o"; then
			sudo install -Z -Dm644 "$build/fix.bpf.o" "$obj"
			sudo install -Z -Dm644 "$src" "${obj%.o}.c"
		else
			failed "Could not build the accelerometer fix, so the screen won't rotate."
		fi
		rm -rf "$build"
	fi
	install_udev_rule 99-hid-bpf-amd-sfh-accel.rules
	[ -f "$obj" ] || return 0
	# Fix the accelerometer now too. It comes back as a new IIO device, so restart
	# iio-sensor-proxy.
	for dev in /sys/bus/hid/devices/0020:1022:0001.*; do
		[ -e "$dev/report_descriptor" ] && has_motion_state_field "$dev" &&
			sudo udev-hid-bpf add "$dev" "$obj" && attached=1
	done
	[ -z "$attached" ] || sudo systemctl restart iio-sensor-proxy
}

# --------------------------------------------------------------------------------------------------
# Patched libraries.
# --------------------------------------------------------------------------------------------------

# Replace a library with one built with a patch from scripts/patches, again whenever an update
# puts Fedora's back, see patch-library. It takes effect at the next login. The patches' settings
# are in System Settings > Danylo's Linux Tweaks, see config/tweaks. Args: what goes wrong without
# the patch, the patch, its package, the library.
patch_library() { "$dotfiles"/scripts/patches/patch-library --impact "$@"; }

# --------------------------------------------------------------------------------------------------
# The steps.
# --------------------------------------------------------------------------------------------------

step "Configuring the GPUs"
hide_dgpu_from_vulkan
# Also hide /dev/nvidiactl etc. when the dGPU is blocked, so tools like nvtop don't wake it. Only
# reliable with exactly one iGPU and one NVIDIA dGPU.
# Only when it isn't on yet: setting it wakes the GPU, reading it doesn't.
installed cardwire && has_nvidia &&
	! cardwire config experimental-nvidia-block 2>/dev/null | grep -qi ': *true$' &&
	cardwire config experimental-nvidia-block true

step "Configuring the kernel"
hide_rdseed_boot_message
keep_hardware_clock_in_utc

step "Configuring USB devices and wake sources"
# USB keyboards wake it, mice don't, see the hook.
install_sleep_hook sleep-hooks/usb-wakeup
remove_replaced_files
# Chargers and batteries don't wake it, see the rules file.
install_udev_rule 90-power-supply-wakeup.rules --action=change --subsystem-match=power_supply
# CPU power for bin/status, see the rules file.
install_udev_rule 90-rapl-read.rules --action=add --subsystem-match=powercap

step 2 "Configuring sleep and hibernation"
if is_laptop; then
	[ -n "$nvidia_version" ] && set_nvidia_power_management
	# Hibernation needs Secure Boot off, see can_hibernate.
	if can_hibernate; then
		set_up_initramfs_for_hibernation
		[ "$(findmnt -no FSTYPE /)" = btrfs ] && [ ! -f "$swapfile" ] && create_hibernation_swapfile
	else
		say "Hibernation is off while Secure Boot is on: the laptop will only sleep." >&2
	fi
	if can_hibernate && [ -f "$swapfile" ]; then
		sleep_then_hibernate on
	else
		sleep_then_hibernate off
	fi
	# The battery drain of each sleep and hibernation, logged for bin/sleep_stats.
	install_sleep_hook sleep-hooks/sleep-stats
	# Keep the speaker amps from deadlocking a hibernation at power-off.
	install_sleep_hook sleep-hooks/cs35l41-hibernate
	# A smaller hibernation image, compressed on more threads.
	install_sleep_hook sleep-hooks/hibernate-image
	can_hibernate && set_hibernation_compression_threads
	can_hibernate && skip_boot_menu_on_resume
else
	disable_hibernation
fi

if is_asus_laptop; then
	step "Configuring the ASUS laptop"
	set_up_asus_keyboard_backlight
	if installed asusctl; then
		# G-Helper's fan curves. asusd saves them.
		"$dotfiles"/scripts/bin/asus-fan-curves >/dev/null
		keep_chosen_power_profile
	fi
	installed acpi_call-dkms && install_power_limits
	enable_tablet_mode_switch
fi
has_amd_sfh && installed udev-hid-bpf && install_accelerometer_fix

step "Patching KDE's idle timers"
patch_library "after waking up by itself, the system won't go back to sleep" \
	kidletime-wayland-simulate-activity.patch kf6-kidletime KF6IdleTimeWaylandPlugin.so
if is_laptop; then
	step 2 "Patching libinput for the touchpad"
	patch_library "the touchpad cursor and scrolling will start late" \
		libinput-touchpad-lag.patch libinput libinput.so
	step 6 "Patching KWin for touchpad gestures"
	patch_library "three-finger swipes will switch desktops, not windows" \
		kwin-touchpad-gestures.patch kwin-libs libkwin.so
	step 4 "Patching Plasma's battery menu"
	patch_library "the battery menu will list the touchscreen pen's battery" \
		plasma-battery-absent-devices.patch plasma-workspace-libs libbatterycontrol.so
fi

[ -z "${need_reboot:-}" ] || exit 2
