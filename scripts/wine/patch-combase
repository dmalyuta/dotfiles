#!/bin/bash
#
# Replace Wine's COM library, combase.dll, with one built with combase-endpoint.patch, which keeps
# PDF-XChange Editor from crashing within an hour of use (see the patch). Built from Fedora's
# source package of the installed Wine, prepared as Fedora's build does (with the Wine Staging
# patches), for both the 64-bit and the 32-bit DLL: the two ends of a COM call must agree.
#
# Wine updates put Fedora's DLLs back, so start_fresh runs this every time. It only builds for a
# new Wine or a changed patch, and keeps the builds in ~/.cache/wine-combase. A patch that no
# longer applies or builds gets a report for fixing it.
#
# Running Wine programs keep the DLL they loaded: restart them (wineserver -k).
# `rpm -V wine-core` lists the replaced files as changed, `sudo dnf reinstall wine-core` undoes it.
#
# Usage: patch-combase [--build-only]
#
# Author: Danylo Malyuta, 2026.

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
dotfiles=$(cd "$here/../.." && pwd)
. "$dotfiles"/scripts/functions.sh
. "$dotfiles"/scripts/patches/patch-build.sh

build_only=
[ "${1:-}" = --build-only ] && build_only=1
patch_file=$here/combase-endpoint.patch

installed wine-core || { echo "wine-core isn't installed." >&2; exit 1; }
ver=$(rpm -q --qf '%{VERSION}-%{RELEASE}' wine-core)
# Fedora's DLLs, in folders named for their architecture: i386-windows, x86_64-windows.
mapfile -t dlls < <(rpm -ql wine-core | grep -E '/[a-z0-9_]+-windows/combase\.dll$')
[ ${#dlls[@]} -gt 0 ] || { echo "No combase.dll in wine-core." >&2; exit 1; }
arch_of() { basename "$(dirname "$1")"; }

# The build for this Wine and this patch.
cache=~/.cache/wine-combase/$ver-$(sha256sum "$patch_file" | cut -c1-12)
log=$cache/build.log

# Whether each DLL in $cache is there and, with "installed", also in place of Fedora's.
check() {
	local d
	for d in "${dlls[@]}"; do
		if [ "$1" = installed ]; then
			cmp -s "$cache/$(arch_of "$d")/combase.dll" "$d" || return 1
		else
			[ -f "$cache/$(arch_of "$d")/combase.dll" ] || return 1
		fi
	done
}

# Build the patched DLLs into $cache, working in $1. On failure, sets $failure to what failed.
failure=''
build() {
	local tmp=$1 srpm src d arch_list archs=() targets=() pkgs=() p
	# For Fedora's prep (rpmbuild, and Python for the Staging patches), and for building: Wine
	# compiles its Windows side with clang and lld.
	for p in rpm-build python3 gcc clang lld flex bison make git; do
		installed "$p" || pkgs+=("$p")
	done
	[ ${#pkgs[@]} -eq 0 ] || sudo dnf install -y "${pkgs[@]}" || return

	say "Building Wine $ver's combase.dll with $(basename "$patch_file"), see $log"
	rm -rf "$cache"
	mkdir -p "$cache"
	if ! srpm=$(download_source_rpm "wine-core-$ver" "$tmp"); then
		failure="Couldn't download the source package of wine-core $ver."
		return 1
	fi
	# Unpack the source and apply Fedora's patches, as its build does (the spec's %prep).
	if ! rpmbuild --define "_topdir $tmp/rpm" -rp --nodeps "$srpm" >>"$log" 2>&1; then
		failure="Couldn't prepare the source of wine-core $ver."
		return 1
	fi
	src=$(compgen -G "$tmp/rpm/BUILD/*/wine-*/configure" | head -n 1)
	if [ -z "$src" ]; then
		failure="Couldn't find the unpacked source of wine-core $ver."
		return 1
	fi
	src=$(dirname "$src")
	if ! apply_patch "$src"; then
		failure="$(basename "$patch_file") no longer applies to Wine $ver."
		return 1
	fi

	for d in "${dlls[@]}"; do
		archs+=("$(arch_of "$d")")
		targets+=("dlls/combase/$(arch_of "$d")/combase.dll")
	done
	arch_list=$(printf '%s\n' "${archs[@]%-windows}" | paste -sd,)
	# Only the DLL, so without the libraries the rest of Wine uses.
	mkdir -p "$tmp/build"
	if ! (cd "$tmp/build" &&
		"$src"/configure --enable-archs="$arch_list" --disable-tests --without-x --without-freetype &&
		make -j"$(nproc)" "${targets[@]}") >>"$log" 2>&1; then
		failure="Wine $ver's combase.dll doesn't build with $(basename "$patch_file")."
		return 1
	fi
	for d in "${dlls[@]}"; do
		install -Dm644 "$tmp/build/dlls/combase/$(arch_of "$d")/combase.dll" \
			"$cache/$(arch_of "$d")/combase.dll" || return
	done
	# Drop the builds, and failed ones, for older versions of Wine or the patch.
	find ~/.cache/wine-combase -mindepth 1 -maxdepth 1 ! -path "$cache" -exec rm -rf {} +
}

[ -z "$build_only" ] && check installed && exit 0

if ! check built; then
	tmp=$(mktemp -d -p /var/tmp wine-combase.XXXXXX) || exit
	trap 'rm -rf "$tmp"' EXIT
	if ! build "$tmp"; then
		report_patch_failure "${failure:-Building failed.}" \
			"${here/#$HOME/\~}/patch-combase --build-only" \
			"Couldn't patch Wine's combase.dll: PDF-XChange Editor will crash after a while."
		exit 1
	fi
fi
[ -n "$build_only" ] && echo "Built in $cache." && exit 0

for d in "${dlls[@]}"; do
	sudo install -Z -m644 "$cache/$(arch_of "$d")/combase.dll" "$d" || exit
done
say "Installed the patched combase.dll for Wine $ver"
if pgrep -u "$(id -u)" '^wineserver' >/dev/null; then
	say "Running Wine programs still use the old combase.dll, restart them (wineserver -k)"
fi
