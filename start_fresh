	done
	cat >~/.local/share/applications/pdf-xchange-editor.desktop <<EOF
[Desktop Entry]
Type=Application
Name=PDF-XChange Editor
GenericName=PDF Editor
Comment=View and edit PDF documents
Exec=$HOME/.bin/pdf-xchange-editor %F
Icon=$pdfx_icon
Terminal=false
StartupNotify=true
StartupWMClass=pxceditor.exe
Categories=Office;Viewer;
MimeType=application/pdf;
EOF
	set_desktop_key ~/.local/share/applications/wine/Programs/PDF-XChange/"PDF-XChange Editor.desktop" \
		NoDisplay true
	update-desktop-database ~/.local/share/applications
	kbuildsycoca6 >/dev/null 2>&1
fi

# Silence Wine from logging the spammy "fixme:" channel to stderr. Keep "err:" and "warn:", so real
# faults get reported.
mkdir -p ~/.config/environment.d
cat >~/.config/environment.d/50-winedebug.conf <<'EOF'
# Silence Wine's "fixme:" chatter, which otherwise floods the systemd journal.
# Real problems still log: the err: and warn: channels are left enabled.
WINEDEBUG=fixme-all
EOF
# environment.d only applies to sessions started after it, so cover the launchers directly too.
while IFS= read -r -d '' f; do
	grep -q '^Exec=env .*wine' "$f" && ! grep -q WINEDEBUG "$f" &&
		sed -i 's|^Exec=env |Exec=env "WINEDEBUG=fixme-all" |' "$f"
done < <(find ~/.local/share/applications -name '*.desktop' -print0 2>/dev/null)

step "Configuring Flameshot and the system journal"

# Flameshot's Wayland clipboard copy is lost on non-Gnome desktops because the capture window closes
# too early. Run the daemon under XWayland instead, for both ways it gets started: autostart and
# D-Bus activation.
flameshot_autostart=~/.config/autostart/Flameshot.desktop
if [ ! -f "$flameshot_autostart" ]; then
	mkdir -p ~/.config/autostart
	cat >"$flameshot_autostart" <<'EOF'
[Desktop Entry]
Name=flameshot
Icon=flameshot
Exec=flameshot
Terminal=false
Type=Application
X-GNOME-Autostart-enabled=true
EOF
fi
set_desktop_key "$flameshot_autostart" Exec "env QT_QPA_PLATFORM=xcb flameshot"
mkdir -p ~/.local/share/dbus-1/services
cat >~/.local/share/dbus-1/services/org.flameshot.Flameshot.service <<'EOF'
[D-BUS Service]
Name=org.flameshot.Flameshot
Exec=/usr/bin/env QT_QPA_PLATFORM=xcb /usr/bin/flameshot
EOF

# Explicitly set the journald size (default 50 MB).
if write_root_file /etc/systemd/journald.conf.d/99-size.conf <<'EOF'
[Journal]
SystemMaxUse=256M
EOF
then
	sudo systemctl restart systemd-journald
fi

# Low-level hardware setup (GPUs, kernel, sleep and hibernation, laptop quirks), see
# scripts/configure_hardware. These scripts add what needs a reboot to $REBOOT_REASONS.
bash "$dotfiles"/scripts/configure_hardware

# The laptop's sleep and hibernation debug log, on or off as answered, see
# scripts/sleep-debug/setup.
if is_laptop; then
	bash "$dotfiles"/scripts/sleep-debug/setup \
		"$([ -n "${want_sleep_debug:-}" ] && echo on || echo off)"
fi

# KDE desktop configuration, see scripts/configure_kde.
bash "$dotfiles"/scripts/configure_kde "${answers[workspaces]:-}"

# Fedora upgrade, if chosen above. Last, after everything else is installed, so the upgrade takes
# all of it along. dnf downloads the new release's packages and stores the transaction, and the
# reboot at the end runs it, with `dnf offline reboot`. Without the upgrade, the packages were
# still upgraded within this release above.
if [ -n "${upgrade_to:-}" ]; then
	step 6 "Downloading the Fedora upgrade"
	if sudo dnf system-upgrade download -y --releasever="$upgrade_to"; then
		fedora_upgrade=1
		reboot_for "upgrade to Fedora $upgrade_to, which installs while it reboots"
	else
		say "Could not download the Fedora $upgrade_to upgrade, see above. Staying on Fedora $fedora." >&2
		echo "If packages conflict, try: sudo dnf system-upgrade download --releasever=$upgrade_to --allowerasing"
	fi
fi

if [ -n "${need_mok_enroll:-}" ]; then
	reboot_for "enroll the module signing key, see above"
	say "Next boot: enroll the module signing key, or the NVIDIA driver won't load."
	echo "A blue MOK Manager screen waits 10 s for a key press. Press any key, then pick"
	echo "Enroll MOK > Continue > Yes, type the password you picked, and pick Reboot. If you miss"
	echo "it, run this script again and reboot."
fi

# Discover's update notifier (the panel's update icon) checks once at login and then only every so
# often, and doesn't notice updates made outside Discover, like the ones above. Restart it, so it
# checks again and stops listing what was just updated. Last, as its check refreshes the package
# data, which dnf above could have had to wait for.
systemctl --user try-restart app-org.kde.discover.notifier@autostart.service 2>/dev/null

steps_done
say "Done."
[ -n "${syncthing_new:-}${proxy_changed:-}" ] && echo "Syncthing is at http://syncthing.localhost/"
if [ -s "$REBOOT_REASONS" ]; then
	echo "Reboot to apply:"
	sed 's/^/  - /' "$REBOOT_REASONS"
	say "Press ENTER to reboot, or ESC to finish without rebooting."
	# IFS= keeps a space or tab as the key read, rather than an empty one like ENTER.
	while IFS= read -r -s -n 1 key; do
		case $key in
		'')
			if [ -n "${fedora_upgrade:-}" ]; then
				sudo dnf offline reboot -y
			else
				sudo reboot
			fi
			break
			;;
		$'\e')
			# Swallow the rest of a key that sends an escape sequence, like an arrow key.
			read -r -s -t 0.1 -n 10
			# A plain reboot doesn't install the downloaded upgrade.
			[ -n "${fedora_upgrade:-}" ] &&
				echo "To upgrade to Fedora $upgrade_to later, run: sudo dnf offline reboot"
			break
			;;
		esac
	done
fi
