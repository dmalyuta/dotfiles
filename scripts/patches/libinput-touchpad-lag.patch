+/* How far the scroll is behind the fingers: what's left of their motion
+ * before the scroll was recognized, out of all of it. For the touchpad that
+ * scrolled last. */
+static struct {
+	struct tp_dispatch *tp;
+	struct normalized_coords left, all;
+	double speed;
