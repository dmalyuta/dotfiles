+ * once makes the content jump, and dropping it makes every scroll start
+ * late. Instead, scroll faster than the fingers until caught up with them,
+ * easing off as it does: at first (1 + ScrollCatchUp) times as fast. */
+static void
+tp_gesture_scroll_catch_up(struct tp_dispatch *tp, struct normalized_coords *delta)
+{
+	if (scroll_backlog.tp != tp)
+		return;
+	delta->x = scroll_catch_up(delta->x, &scroll_backlog.left.x, scroll_backlog.all.x);
+	delta->y = scroll_catch_up(delta->y, &scroll_backlog.left.y, scroll_backlog.all.y);
+}
