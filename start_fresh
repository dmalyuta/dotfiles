step 2 "Setting up Wine and PDF-XChange Editor"

# ntsync-autoload only loads the module from the next boot on. Load it now, before wineserver first
# starts, so Wine uses it from the start.
[ -e /dev/ntsync ] || sudo modprobe ntsync

[ -f ~/.wine/drive_c/windows/Fonts/arial.ttf ] || winetricks -q corefonts

# Fedora's wine-mono, Wine's .NET runtime, is broken: its libmono needs iconv.dll and
# libgcc_s_dw2-1.dll from the MinGW packages, in a folder Wine never searches. So .NET programs
# fail with "Could not load Mono". Install WineHQ's build into the prefix instead: it bundles those,
# and Wine prefers it over the system one. Take the version this Wine asks for, and check the
# download against the hashes that Wine itself carries.
appwiz=$(rpm -ql wine-core | grep -m1 'x86_64-windows/appwiz\.cpl$')
mono_msi=$(strings -el "$appwiz" | grep -m1 -xE 'wine-mono-[0-9.]+-x86\.msi')
mono_ver=${mono_msi#wine-mono-} && mono_ver=${mono_ver%-x86.msi}
if [ -n "$mono_ver" ] && ! grep -A3 '"DisplayName"="Wine Mono Runtime"' ~/.wine/system.reg |
	grep -q "\"DisplayVersion\"=\"$mono_ver\""; then
	if curl -fsSL -o "$mono_msi" "https://dl.winehq.org/wine/wine-mono/$mono_ver/$mono_msi" &&
		strings -n 64 "$appwiz" | grep -qx "$(sha256sum "$mono_msi" | cut -d' ' -f1)"; then
		wine msiexec /i "$mono_msi" /qn
	else
		echo "Couldn't download or verify $mono_msi: .NET programs in Wine won't run."
	fi
	rm -f "$mono_msi"
fi

# Font smoothing. The desktop's LCD has RGB subpixels, so use ClearType for sharper text. The
# laptop's screen is OLED, whose subpixels aren't in RGB stripes, so ClearType would leave color
# fringes there: keep grayscale.
font_smoothing_type=2
is_laptop && font_smoothing_type=1
# Only run wine for the values not set yet: each run starts Wine, which is slow and prints warnings.
# They are in user.reg, as "Name"="text" or "Name"=dword:<8 hex digits>.
desktop_reg=$(awk '/^\[/ { s = /^\[Control Panel\\\\Desktop\] / } s' ~/.wine/user.reg 2>/dev/null)
for kv in FontSmoothing:REG_SZ:2 FontSmoothingType:REG_DWORD:$font_smoothing_type \
	FontSmoothingOrientation:REG_DWORD:1 FontSmoothingGamma:REG_DWORD:1400; do
	IFS=: read -r name type value <<<"$kv"
	case $type in
	REG_SZ) line="\"$name\"=\"$value\"" ;;
	REG_DWORD) line=$(printf '"%s"=dword:%08x' "$name" "$value") ;;
	esac
	grep -qxF "$line" <<<"$desktop_reg" ||
		wine reg add 'HKCU\Control Panel\Desktop' /v "$name" /t "$type" /d "$value" /f >/dev/null
done
if [ -n "${want_pdfx:-}" ]; then
	while [ ! -f EditorV11.x64.msi ]; do
		echo "Download PDF-XChange Editor Plus 64-bit MSI installer from"
		echo "https://www.pdf-xchange.com/product/downloads into $downloads"
		read -p "Press ENTER to try again... " -r
