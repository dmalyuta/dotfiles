#!/bin/bash
#
# Run a command in the background with limited memory and CPU, for example:
#   run_throttled --ram 3000M --cpu 100% brave-browser
#
# Usage: run_throttled --cpu LIMIT --ram LIMIT COMMAND [ARG...]
#   --cpu LIMIT  CPU time as a percentage of one core: 200% is two cores.
#   --ram LIMIT  Memory, like 3000M or 4G.

cpu='' ram=''
while [ $# -gt 0 ]; do
	case $1 in
	-c | --cpu) cpu=$2 && shift 2 ;;
	-r | --ram) ram=$2 && shift 2 ;;
	*) break ;;
	esac
done
if [ -z "$cpu" ] || [ -z "$ram" ] || [ $# -eq 0 ]; then
	sed -n '/^# Usage/,/^$/s/^# \{0,1\}//p' "$0" >&2
	exit 1
fi

echo "Running $* with $ram RAM and $cpu CPU."
# As a user unit, so it needs no password. MemoryMax is the hard limit (MemoryLimit, used here
# before, was cgroup v1's and is ignored now).
systemd-run --user --scope -p MemoryMax="$ram" -p CPUQuota="$cpu" "$@" >/dev/null 2>&1 &
disown
