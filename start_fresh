#!/bin/bash
#
# Set up a fresh Fedora KDE Plasma install. On a new machine, run
#
#   curl -fsSL https://raw.githubusercontent.com/dmalyuta/dotfiles/fedora/start_fresh | bash
#
# Safe to re-run: every step skips what is already done. With -c, reuse the answers from the last
# run instead of asking again (pass it through curl with `| bash -s -- -c`). It shows its progress
# above a box with the tail of its output, see scripts/tui.py. With -p, or without a terminal, it
# prints its output as is instead.
#
# This script installs and configures the software, including the NVIDIA driver. At the end it runs
# scripts/configure_hardware for low-level hardware setup (GPUs, kernel, sleep and hibernation,
# laptop quirks) and scripts/configure_kde for the desktop.
#
# Author: Danylo Malyuta, 2026.

repo_ssh=git@github.com:dmalyuta/dotfiles.git
branch=fedora
raw_base=https://raw.githubusercontent.com/dmalyuta/dotfiles/$branch

# --------------------------------------------------------------------------------------------------
# Bootstrap.
# --------------------------------------------------------------------------------------------------

usage() {
	cat <<'EOF'
Usage: start_fresh [-c] [-p] [-h]

Set up a fresh Fedora KDE Plasma install: repositories, packages, apps, the NVIDIA driver, the
dotfiles, hardware settings and the KDE desktop. Safe to re-run: every step skips what is already
done.

Options:
  -c  Reuse the answers from the last run instead of asking the setup questions again.
  -p  Plain output, without the progress display.
  -h  Show this help and exit.

On a new machine:
  curl -fsSL https://raw.githubusercontent.com/dmalyuta/dotfiles/fedora/start_fresh | bash

More in `man start_fresh`.
EOF
}

use_cached= plain=
while getopts cph opt; do
	case $opt in
	c) use_cached=1 ;;
	p) plain=1 ;;
	h) usage && exit 0 ;;
	*) usage >&2 && exit 1 ;;
	esac
done

# Under `curl ... | bash` stdin is the script itself, so `read` would eat it. Re-exec a downloaded
# copy with the terminal on stdin instead.
if [ ! -t 0 ] && [ -z "${DOTFILES_BOOTSTRAP:-}" ]; then
	self=$(mktemp)
	curl -fsSL "$raw_base/start_fresh" -o "$self" </dev/tty || exit
	DOTFILES_BOOTSTRAP=$self exec bash "$self" "$@" </dev/tty
fi

# Use this checkout if running from one, else clone to ~/Projects/dotfiles below.
mkdir -p ~/Projects
dotfiles=~/Projects/dotfiles
this_script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -f "$this_script_dir/home/.bash_aliases" ] && [ -e "$this_script_dir/.git" ]; then
	dotfiles=$this_script_dir
fi

downloads=~/Downloads
mkdir -p "$downloads" ~/.local/bin ~/.local/share/applications
cd "$downloads" || exit
# Apps installed to ~/.local/bin below are run from here too.
export PATH=$HOME/.local/bin:$PATH

# --------------------------------------------------------------------------------------------------
# Helpers.
# --------------------------------------------------------------------------------------------------

# Shared helpers, see scripts/functions.sh. Before the repo is cloned, fetch them from GitHub.
if [ "$dotfiles" = "$this_script_dir" ]; then
	. "$dotfiles"/scripts/functions.sh
else
	functions=$(curl -fsSL "$raw_base/scripts/functions.sh") || exit
	eval "$functions"
fi

# --------------------------------------------------------------------------------------------------
# Progress display.
# --------------------------------------------------------------------------------------------------

# Run the rest again under scripts/tui.py, which shows how far through the steps it is (see step in
# scripts/functions.sh) above a box with the tail of the output. It needs pyte, a terminal emulator
# library, run by Fedora's own Python, which has it, rather than whichever is first on PATH
# (Anaconda's). Before the repo is cloned, fetch it from GitHub.
if [ -z "${START_FRESH_TUI:-}" ] && [ -z "$plain" ] && [ -t 0 ] && [ -t 1 ]; then
	installed python3-pyte || sudo dnf install -y -q python3-pyte </dev/null
	tui=$dotfiles/scripts/tui.py
	if [ ! -f "$tui" ]; then
		tui=$(mktemp --suffix=.py)
		curl -fsSL "$raw_base/scripts/tui.py" -o "$tui" || tui=
	fi
	if [ -n "$tui" ] && /usr/bin/python3 -I -c 'import pyte' 2>/dev/null; then
		self=$this_script_dir/${BASH_SOURCE[0]##*/}
		START_FRESH_TUI=1 exec /usr/bin/python3 -I "$tui" --script "$self" --dotfiles "$dotfiles" \
			--raw-base "$raw_base" -- bash "$self" "$@"
	fi
	say "No progress display, see above." >&2
fi

# What needs a reboot, one reason per line, from here and the scripts run at the end. See reboot_for
# in scripts/functions.sh.
REBOOT_REASONS=$(mktemp)
export REBOOT_REASONS
trap 'kill ${sudo_keepalive:-} 2>/dev/null; rm -f "$REBOOT_REASONS" ${DOTFILES_BOOTSTRAP:+"$DOTFILES_BOOTSTRAP"}' EXIT

# Yes/no question whose default is the last answer, remembered under key $1. With -c, a remembered
# answer is used without asking.
ask() {
	local key=$1 hint="[yN]" a
	if [ -n "$use_cached" ] && [ -n "${answers[$key]:-}" ]; then
		[ "${answers[$key]}" = y ]
		return
	fi
	[ "${answers[$key]:-}" = y ] && hint="[Yn]"
	read -p "$2 $hint " -r a
	[[ ${a:-${answers[$key]:-n}} =~ ^[Yy]$ ]] && answers[$key]=y || answers[$key]=n
	[ "${answers[$key]}" = y ]
}

# Whether $1 lists VS Code workspaces as "<letter>:<absolute path>,..." (or is empty), with distinct
# letters.
valid_workspaces() {
	local entry="[A-Z]:/[^,;]*[^,;/]"
	[[ $1 =~ ^($entry(,$entry)*)?$ ]] &&
		[ -z "$(tr , '\n' <<<"$1" | cut -c1 | sort | uniq -d)" ]
}

# Download $1 to $2 with mode $3 (default 644), replacing $2 only once the download is complete.
fetch() {
	local tmp rc
	tmp=$(mktemp)
	curl -fsSL "$1" -o "$tmp" && install -Dm "${3:-644}" "$tmp" "$2"
	rc=$?
	rm -f "$tmp"
	return $rc
}

# Enable COPR repo $1 (owner/project) if it isn't yet.
copr() {
	compgen -G "/etc/yum.repos.d/_copr*:${1/\//:}.repo" >/dev/null || sudo dnf copr enable -y "$1"
}

# The key that signs the kernel modules built here, see "Kernel module signing" below.
akmods_cert=/etc/pki/akmods/certs/public_key.der

# Whether that key is enrolled in the firmware, or queued for enrollment on the next boot. Its
# directory is only readable by root.
mok_key_ok() {
	sudo test -f "$akmods_cert" &&
		! sudo mokutil --test-key "$akmods_cert" 2>/dev/null | grep -q 'not enrolled'
}

# --------------------------------------------------------------------------------------------------
# Questions, all up front so the rest runs unattended.
# --------------------------------------------------------------------------------------------------

step "Asking the setup questions"

# The sudo password, once, with the questions, and kept fresh in the background so a long step
# doesn't ask again partway through.
sudo -v || exit
while kill -0 $$ 2>/dev/null && sleep 60; do sudo -n -v 2>/dev/null || break; done &
sudo_keepalive=$!

# sudo remembers the password per terminal by default, and the progress display is a terminal of its
# own, so it would always ask above. Have it remember the password across all of the user's
# terminals instead, for its usual 5 minutes: then the display doesn't ask if it was just entered
# elsewhere. Checked with visudo first, since a broken sudoers file locks sudo out.
sudoers_tmp=$(mktemp)
echo "Defaults:$USER timestamp_type=global" >"$sudoers_tmp"
sudoers_conf=/etc/sudoers.d/timestamp-global
if ! sudo cmp -s "$sudoers_tmp" "$sudoers_conf" && visudo -cqf "$sudoers_tmp"; then
	sudo install -Z -m 440 "$sudoers_tmp" "$sudoers_conf"
fi
rm -f "$sudoers_tmp"

# Last answers, kept in the repo (git-ignored). On a fresh install the repo is cloned later, so they
# are saved after that.
answers_file=$dotfiles/.start_fresh_answers
declare -A answers=()
[ -f "$answers_file" ] && . "$answers_file"

# A newer Fedora release, if there is one: the highest final version on Fedora's download page,
# which lists betas as "45 Beta" and so on. Asked every run while one is available, rather than
# remembered, even with -c. The upgrade itself is downloaded at the end, see "Fedora upgrade" below.
fedora=$(rpm -E %fedora)
fedora_newest=$(curl -fsSL https://fedoraproject.org/releases.json 2>/dev/null |
	grep -oE '"version": *"[0-9]+"' | grep -oE '[0-9]+' | sort -n | tail -n 1)
if [ "${fedora_newest:-0}" -gt "$fedora" ]; then
	read -p "Fedora $fedora_newest is out. Upgrade to it from Fedora $fedora? [Yn] " -r a
	[[ ${a:-y} =~ ^[Yy]$ ]] && upgrade_to=$fedora_newest
fi

# Fedora doesn't ship git, and the questions below already need it.
installed git || sudo dnf install -y git || exit

[ -n "$(git config --global user.name)" ] ||
	{ read -p "Git name: " -r a && git config --global user.name "$a"; }
[ -n "$(git config --global user.email)" ] ||
	{ read -p "Git email: " -r a && git config --global user.email "$a"; }

superluminal_dir=~/.local/superluminal
[ -x "$superluminal_dir"/Superluminal ] ||
	{ ask superluminal "Install Superluminal profiler?" && want_superluminal=1; }

# CoolerControl on both. The desktop also gets its fan chip's driver (nct6775) and OpenRGB, the
# laptop the ASUS tools and cardwire for its hybrid GPU.
want_coolercontrol=1
if is_laptop; then
	want_asusctl=1
	want_cardwire=1
else
	want_nct6775=1
	want_openrgb=1
fi
if ! installed coolercontrol && ask cc_backup "Restore CoolerControl settings from backup?"; then
	while true; do
		read -e -p "Path to the CoolerControl backup file: " -r cc_backup
		cc_backup="${cc_backup/#\~/$HOME}"
		[ -f "$cc_backup" ] && break
		echo "$cc_backup not found, try again."
	done
fi

installed brscan-skey || ask brother "Install the Brother printer and scanner drivers?" && want_brother=1

# The OBS configuration, on the desktop. Already installed if its profiles link into the repo.
obs_basic=~/.config/obs-studio/basic
if ! is_laptop; then
	if [ "$(readlink "$obs_basic/profiles")" = "$dotfiles/config/obs/profiles" ]; then
		want_obs=1
	elif ask obs "Install the custom OBS configuration?"; then
		want_obs=1
	fi
fi

is_laptop && ask sleep_debug "Turn on the sleep and hibernation debug log (scripts/sleep-debug)?" &&
	want_sleep_debug=1

pdfx_dir=~/.wine/drive_c/"Program Files/PDF-XChange"
[ -d "$pdfx_dir" ] || { ask pdfx "Install PDF-XChange Editor?" && want_pdfx=1; }
command -v PureRef >/dev/null || want_pureref=1

# Kept out of the repo, since the projects may be private. The last answer, or the rejected one on a
# retry, is pre-filled for editing.
if [ -z "$use_cached" ] || ! valid_workspaces "${answers[workspaces]-x}"; then
	echo "VS Code workspaces for Meta+C, Meta+<letter>, as <letter>:<absolute path>,... (empty for"
	echo "none). Meta+<letter> is taken from whatever else uses it."
	workspaces=${answers[workspaces]:-}
	while true; do
		read -e -i "$workspaces" -p "Workspaces: " -r workspaces || exit
		valid_workspaces "$workspaces" && break
		echo "Invalid: expected e.g. M:/home/me/project,X:/home/me/other, with distinct letters and"
		echo "no trailing slashes."
	done
	answers[workspaces]=$workspaces
fi

# A one-time password for enrolling the module signing key, see "Kernel module signing" below.
# Asked every run until the key is enrolled, and only its hash is kept, for this run only.
if secure_boot && ! mok_key_ok; then
	echo "Secure Boot is on, so the NVIDIA driver needs a signing key that the firmware trusts. Pick"
	echo "a one-time password for adding it: the next boot asks for it once."
	while true; do
		read -s -p "Key password: " -r mok_password && echo
		read -s -p "Again: " -r a && echo
		[ -n "$mok_password" ] && [ "$mok_password" = "$a" ] && break
		echo "Empty or different, try again."
	done
	mok_hash=$(mokutil --generate-hash="$mok_password")
	unset mok_password a
fi

# --------------------------------------------------------------------------------------------------
# Repositories.
# --------------------------------------------------------------------------------------------------

step "Adding the software repositories"

# RPM Fusion, for the NVIDIA driver and the codecs that Fedora leaves out.
if ! installed rpmfusion-free-release || ! installed rpmfusion-nonfree-release; then
	sudo dnf install -y \
		"https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$fedora.noarch.rpm" \
		"https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$fedora.noarch.rpm"
fi

# Terra, for most of what Fedora doesn't have: cardwire, asusctl, CoolerControl, keyd, OpenRazer,
# Polychromatic, gping and the Nerd Fonts. Its terra-release package adds the repo and its key.
# shellcheck disable=SC2016 # $releasever is for dnf.
installed terra-release ||
	sudo dnf install -y --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' \
		terra-release

# COPRs: FSearch from its author, and acpi_call for scripts/bin/asus-power-limits.
copr cboxdoerfer/fsearch
[ -n "${want_asusctl:-}" ] && is_laptop && copr rhea/acpi_call

# The vendors' own repos. Fedora has Grafana too, but years behind.
write_root_file /etc/yum.repos.d/brave-browser.repo <<'EOF'
[brave-browser]
name=Brave Browser
baseurl=https://brave-browser-rpm-release.s3.brave.com/$basearch
enabled=1
gpgcheck=1
gpgkey=https://brave-browser-rpm-release.s3.brave.com/brave-core.asc
EOF
write_root_file /etc/yum.repos.d/vscode.repo <<'EOF'
[code]
name=Visual Studio Code
baseurl=https://packages.microsoft.com/yumrepos/vscode
enabled=1
autorefresh=1
type=rpm-md
gpgcheck=1
gpgkey=https://packages.microsoft.com/keys/microsoft.asc
EOF
write_root_file /etc/yum.repos.d/nordvpn.repo <<'EOF'
[nordvpn]
name=NordVPN
baseurl=https://repo.nordvpn.com/yum/nordvpn/centos/$basearch
enabled=1
gpgcheck=1
gpgkey=https://repo.nordvpn.com/gpg/nordvpn_public.asc
EOF
write_root_file /etc/yum.repos.d/grafana.repo <<'EOF'
[grafana]
name=Grafana
baseurl=https://rpm.grafana.com
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://rpm.grafana.com/gpg.key
EOF

# --------------------------------------------------------------------------------------------------
# Kernel module signing.
# --------------------------------------------------------------------------------------------------

step "Setting up kernel module signing"

# With Secure Boot on, the kernel only loads modules signed by a key the firmware trusts. akmods
# builds the NVIDIA and OpenRazer modules and signs them with its own key, and DKMS (acpi_call) is
# set to use the same one, so that one key is all the firmware needs. mokutil queues it, and on the
# next boot MOK Manager asks for the password to enroll it. Until then those modules don't load.
if secure_boot; then
	sudo dnf install -y akmods kmodtool mokutil openssl
	sudo test -f "$akmods_cert" || sudo kmodgenca -a
	write_root_file /etc/dkms/framework.conf.d/akmods-key.conf <<EOF
# Sign DKMS modules with the akmods key, see start_fresh.
mok_signing_key="/etc/pki/akmods/private/private_key.priv"
mok_certificate="$akmods_cert"
EOF
	if [ -n "${mok_hash:-}" ] && ! mok_key_ok; then
		hash_file=$(mktemp)
		echo "$mok_hash" >"$hash_file"
		sudo mokutil --import "$akmods_cert" --hash-file "$hash_file" && need_mok_enroll=1
		rm -f "$hash_file"
	fi
fi

# --------------------------------------------------------------------------------------------------
# Packages.
# --------------------------------------------------------------------------------------------------

dnf_apps=(
	@c-development @development-tools git curl wget unzip openssh-clients
	bat btop htop tree fzf fd-find ripgrep shfmt gping sqlite
	kitty tmux cascadiacode-nerd-fonts
	brave-browser code okular inkscape obs-studio gimp
	vlc vlc-plugins-all vlc-plugins-freeworld flameshot nextcloud-client
	qalculate-gtk speedcrunch fsearch syncthing
	texlive-scheme-full texlive-latexindent perl-YAML-Tiny perl-File-HomeDir
	openrazer-meta akmod-openrazer polychromatic keyd
	flatpak rustup nodejs npm grafana wine winetricks nordvpn nordvpn-gui
	# Loads the ntsync kernel module at boot. Wine then does its thread syncing in the kernel,
	# instead of a slow round trip to wineserver each time.
	ntsync-autoload
	# To build RAD Debugger, below.
	clang lld llvm libX11-devel libXext-devel libXfixes-devel mesa-libGL-devel mesa-libEGL-devel
	freetype-devel
)
flatpak_apps=(
	com.github.tchx84.Flatseal
	io.github.tanaybhomia.Whisp
	io.github.tanaybhomia.DeepDive
	io.github.amit9838.mousam
	md.obsidian.Obsidian
	me.proton.Pass
	com.xnview.XnViewMP
)

groups=(plugdev nordvpn)
services=(grafana-server nordvpnd keyd)

# The NVIDIA driver, as an akmod: akmods builds it for each new kernel. The CUDA package also has
# nvidia-smi.
has_nvidia && dnf_apps+=(akmod-nvidia xorg-x11-drv-nvidia-cuda)
[ -n "${want_coolercontrol:-}" ] && dnf_apps+=(coolercontrol) && services+=(coolercontrold)
# The PX13 folds into a tablet, which needs an on-screen keyboard.
is_laptop && dnf_apps+=(plasma-keyboard)
# OpenRGB itself comes from upstream, below.
[ -n "${want_openrgb:-}" ] && dnf_apps+=(i2c-tools) && groups+=(i2c)
[ -n "${want_asusctl:-}" ] && dnf_apps+=(asusctl asusctl-rog-gui) && services+=(asusd)
# For scripts/bin/asus-power-limits.
[ -n "${want_asusctl:-}" ] && is_laptop && dnf_apps+=(acpi_call-dkms)
[ -n "${want_cardwire:-}" ] && dnf_apps+=(cardwire cardwire-gui) && services+=(cardwired)
if [ -n "${want_brother:-}" ]; then
	# Brother's installer tool, below, needs wget, and the scanner driver is a SANE backend.
	dnf_apps+=(cups wget sane-backends) && services+=(cups)
	# The printer driver is 32-bit. Installed here, else the tool would ask dnf for them, and dnf
	# would wait on its own question.
	installed brscan-skey || dnf_apps+=(glibc.i686 libstdc++.i686 libgcc.i686)
fi

step 6 "Upgrading the installed packages"
sudo dnf upgrade -y --refresh
step 6 "Installing packages"
# The full FFmpeg and AMD's hardware video decoding, in place of Fedora's builds without the
# patented codecs. --allowerasing swaps them for Fedora's. Before the rest, which may need them.
installed ffmpeg || sudo dnf install -y --allowerasing ffmpeg
installed mesa-va-drivers-freeworld || sudo dnf install -y --allowerasing mesa-va-drivers-freeworld
# cardwire replaces switcheroo-control, which Fedora KDE ships, and the two conflict.
[ -n "${want_cardwire:-}" ] && installed switcheroo-control &&
	sudo dnf swap -y switcheroo-control cardwire
# Only those not installed yet, else dnf lists each one that is. A name may be a package, a group
# (@...), something a package provides (nodejs) or a package of another arch (glibc.i686).
# As root, whose dnf already trusts the repos' keys from the upgrade above: as the user, dnf would
# ask to import them. No stdin, so it can't wait on a question either.
installed_groups=" $(sudo dnf -q group list --installed --hidden </dev/null 2>/dev/null |
	awk 'NR > 1 { printf "%s ", $1 }')"
dnf_missing=()
for p in "${dnf_apps[@]}"; do
	if [[ $p == @* ]]; then
		[[ $installed_groups == *" ${p#@} "* ]] || dnf_missing+=("$p")
	else
		installed "$p" || rpm -q --whatprovides "$p" >/dev/null 2>&1 || dnf_missing+=("$p")
	fi
done
# One package gone from a repo shouldn't hold up the rest. Any other problem fails the whole
# install, and everything after needs it, so stop there.
if [ ${#dnf_missing[@]} -gt 0 ] &&
	! sudo dnf install -y --skip-unavailable "${dnf_missing[@]}"; then
	say "Installing the packages failed, see above. Fix it and run this again." >&2
	exit 1
fi

# OpenRGB from its latest upstream release. Upstream builds an .rpm per Fedora version, which needs
# its own hidapi-hotplug library. Until upstream builds for a new Fedora release, the build for the
# latest release before it, which usually still installs. One transaction swaps them in for
# Fedora's packages, whose separate openrgb-udev-rules owns the same udev rules file. Fedora's are
# only the fallback, as they are older and can't read the profiles in config/OpenRGB. A Fedora
# upgrade swaps Fedora's back in, and re-running this then swaps upstream's in again. Re-running
# this also upgrades it, and does nothing if it is up to date.
if [ -n "${want_openrgb:-}" ]; then
	step "Installing OpenRGB"
	# Download URLs of the assets matching regex $2 in the latest release of OpenRGB's repo $1.
	openrgb_assets() {
		curl -fsSL "https://codeberg.org/api/v1/repos/OpenRGB/$1/releases/latest" |
			grep -oE '"browser_download_url":"[^"]+"' | cut -d'"' -f4 | grep -E "$2"
	}
	openrgb_dir=$(mktemp -d)
	# Files are named for their Fedora release, like openrgb_1.1_x86_64_f44_8e16de2.rpm.
	openrgb_url=$(openrgb_assets OpenRGB '_x86_64_f[0-9]+_[0-9a-f]+\.rpm$' |
		awk -v fedora="$fedora" 'match($0, /_f[0-9]+_[0-9a-f]+\.rpm$/) {
			f = substr($0, RSTART + 2) + 0
			if (f <= fedora && f > best) { best = f; url = $0 }
		} END { print url }')
	hidapi_url=$(openrgb_assets hidapi-hotplug '/hidapi-hotplug-[0-9][^/]*\.x86_64\.rpm$' | head -n 1)
	# The file is named for version 1.1, say, and the package inside is 1.1.0. hidapi-hotplug's file
	# is named for its exact package.
	openrgb_ver=$(sed -nE 's|.*/openrgb_([0-9.]+)_.*|\1|p' <<<"$openrgb_url")
	openrgb_have=$(rpm -q --qf '%{VERSION}' openrgb 2>/dev/null)
	hidapi_rpm=${hidapi_url##*/}
	if [ -n "$openrgb_ver" ] &&
		{ [ "$openrgb_have" = "$openrgb_ver" ] || [ "$openrgb_have" = "$openrgb_ver.0" ]; } &&
		installed "${hidapi_rpm%.x86_64.rpm}" && ! installed openrgb-udev-rules; then
		: # Up to date.
	elif [ -n "$openrgb_url" ] && [ -n "$hidapi_url" ] &&
		curl -fsSL -o "$openrgb_dir"/openrgb.rpm "$openrgb_url" &&
		curl -fsSL -o "$openrgb_dir"/hidapi-hotplug.rpm "$hidapi_url" &&
		sudo dnf do -y --skip-unavailable \
			--action=install "$openrgb_dir"/{openrgb,hidapi-hotplug}.rpm \
			$(installed openrgb-udev-rules && echo --action=remove openrgb-udev-rules); then
		say "Installed OpenRGB $(rpm -q --qf '%{VERSION}' openrgb) from upstream (its build for Fedora $(sed -nE 's|.*_f([0-9]+)_[0-9a-f]+\.rpm$|\1|p' <<<"$openrgb_url"))."
	else
		say "Could not install upstream OpenRGB, falling back to Fedora's older one." >&2
		installed openrgb || sudo dnf install -y openrgb
	fi
	rm -rf "$openrgb_dir"
fi

# Brother printer and scanner, by Brother's installer tool. It installs the printer driver and adds
# the printer, then installs the scanner driver (brscan4) and its scan-button tool (brscan-skey) and
# sets the scanner up. Brother's RPMs have digests but no signatures, which RPM 6 refuses ("does not
# verify: no signature"), and the tool runs plain rpm. So put an rpm first on its PATH that checks
# the digests only. The tool asks on stdin, answered here in order: install the packages, accept
# the printer license, specify the device URI, take the one it finds (A), no test print, accept the
# two scanner licenses, and the scanner's IP address. The scanner is set up by that address: if the
# router gives the printer a new one, re-run
#   sudo brsaneconfig4 -r MFC-J805DW && sudo brsaneconfig4 -a name=MFC-J805DW model=MFC-J805DW ip=<new>
if [ -n "${want_brother:-}" ] && ! installed brscan-skey; then
	step "Installing the Brother printer and scanner drivers"
	brother_ip=$(getent ahostsv4 brwc0b5d7e779d6.local | awk '{ print $1; exit }')
	brother_dir=$(mktemp -d)
	brother_tool=$brother_dir/linux-brprinter-installer
	if [ -z "$brother_ip" ]; then
		say "The Brother printer isn't on the network, skipping its drivers. Turn it on and run this again." >&2
	elif curl -fsSL -o "$brother_tool.gz" \
		https://download.brother.com/welcome/dlf006893/linux-brprinter-installer-2.2.6-1.gz &&
		sha256sum -c --quiet <<<"ce0f6221f5979804c54994ad562fad87ef74e100f596115afd9218d35a568e73  $brother_tool.gz" &&
		gunzip "$brother_tool.gz"; then
		printf '#!/bin/sh\nexec /usr/bin/rpm --define "_pkgverify_level digest" "$@"\n' >"$brother_dir/rpm"
		chmod +x "$brother_dir/rpm"
		# The tool installs its own build of the printer driver. Remove any other first, else RPM
		# keeps both. That also removes the printer, which the tool adds back.
		installed mfcj805dwpdrv && sudo rpm -e --allmatches mfcj805dwpdrv
		# It adds the printer through CUPS, which only starts with the other services, further down.
		sudo systemctl enable --now cups
		(cd "$brother_dir" && printf '%s\n' y y y A n y y "$brother_ip" |
			sudo env PATH="$brother_dir:/usr/sbin:/usr/bin" bash "$brother_tool" MFC-J805DW)
		installed mfcj805dwpdrv && installed brscan4 && installed brscan-skey ||
			say "Could not install the Brother drivers, see above." >&2
	else
		say "The Brother installer tool download failed or changed, skipping." >&2
	fi
	sudo rm -rf "$brother_dir"
fi
# Fedora's eSCL scanner backend (sane-airscan) finds the same scanner on the network, so scan dialogs
# list it twice. Hide it from that backend, leaving Brother's.
[ -n "${want_brother:-}" ] &&
	write_root_file /etc/sane.d/airscan.d/brother-mfc-j805dw.conf <<'EOF'
[blacklist]
model = "*MFC-J805DW"
EOF
# Show the scanner and printer as "Brother MFC-J805DW", rather than the scanner's SANE device name
# (brother4:net1;dev0, the first network scanner that brsaneconfig4 knows) and the printer queue
# the tool names MFCJ805DW. A SANE alias also hides the original name from lists.
if [ -n "${want_brother:-}" ]; then
	write_root_file /etc/sane.d/dll.aliases <<'EOF'
alias "Brother MFC-J805DW" brother4:net1;dev0
EOF
	# A queue name can't have spaces, so Wine programs, which show it, get Brother_MFC-J805DW.
	# Other dialogs show the description. CUPS can't rename a queue, so add it again under the new
	# name, with the old one's device and PPD, then remove the old one. The driver adds MFCJ805DW
	# back whenever it is reinstalled, so do this whenever it is there.
	brother_uri=$(lpstat -v MFCJ805DW 2>/dev/null | sed -n 's/^device for MFCJ805DW: //p')
	if [ -n "$brother_uri" ] &&
		sudo lpadmin -p Brother_MFC-J805DW -E -v "$brother_uri" -P /etc/cups/ppd/MFCJ805DW.ppd \
			-D "Brother MFC-J805DW"; then
		sudo lpadmin -x MFCJ805DW
	fi
fi

step 3 "Building the kernel modules"

# Build the kernel modules (NVIDIA and OpenRazer with akmods, acpi_call with DKMS) for the newest
# kernel now, rather than on its first boot, which would hold up the desktop for minutes. The
# upgrade may have just installed that kernel, before the modules' own hooks were there.
newest_kernel=$(rpm -q kernel --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort -V | tail -n 1)
# acpi_call-dkms's uninstall scripts also run when it is upgraded to a new build of the same
# version, as on a Fedora upgrade. They then delete the source the new build just installed, and
# its /etc/modules-load.d file. DKMS calls the module broken and builds nothing, and
# asus-power-limits fails. A plain reinstall would run them again, so reinstall without scripts.
# DKMS still has the module registered, so the autoinstall below builds it.
if installed acpi_call-dkms; then
	acpi_call_ver=$(rpm -q --qf '%{VERSION}' acpi_call-dkms)
	if [ ! -f "/usr/src/acpi_call-$acpi_call_ver/dkms.conf" ]; then
		sudo dnf reinstall -y --setopt=tsflags=noscripts acpi_call-dkms
		[ -e "/var/lib/dkms/acpi_call/$acpi_call_ver/source" ] ||
			sudo dkms add -m acpi_call -v "$acpi_call_ver"
	fi
	write_root_file /etc/modules-load.d/acpi_call.conf <<<acpi_call
fi
if installed akmods || installed dkms; then
	installed "kernel-devel-$newest_kernel" || sudo dnf install -y "kernel-devel-$newest_kernel"
	installed dkms && sudo dkms autoinstall -k "$newest_kernel"
fi
if installed akmods; then
	sudo akmods --kernels "$newest_kernel"
	if has_nvidia && ! modinfo -k "$newest_kernel" nvidia >/dev/null 2>&1; then
		say "The NVIDIA driver failed to build, see /var/cache/akmods/nvidia." >&2
	fi
fi

