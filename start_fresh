	wine msiexec /i EditorV11.x64.msi
fi

# Ship our own top-level launcher that runs the exe directly, and hide Wine's. This makes sure
# that the icon can be pinned to the task manager etc. It goes through bin/pdf-xchange-editor,
# which turns the files to open into Windows paths.
