def ioc(direction, nr, size):
    return (direction << 30) | (size << 16) | (ord("E") << 8) | nr


def capture(node):
    """Print the device's description and its raw events. Runs as root, until stdin closes."""
    import fcntl

    fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK)
    out = sys.stdout
    name = bytearray(256)
    fcntl.ioctl(fd, ioc(2, 0x06, 256), name)
    out.write("N " + name.split(b"\0")[0].decode(errors="replace") + "\n")
    ident = bytearray(8)
    fcntl.ioctl(fd, ioc(2, 0x02, 8), ident)
    out.write("I %d %d %d %d\n" % struct.unpack("HHHH", ident))

    def bits(nr, size=96):
        buf = bytearray(size)
        fcntl.ioctl(fd, ioc(2, nr, size), buf)
        return [i for i in range(size * 8) if buf[i // 8] >> (i % 8) & 1]

    out.write("P " + " ".join(map(str, bits(0x09, 8))) + "\n")
    for ev_type in bits(0x20, 4):
        codes = bits(0x20 + ev_type)
        out.write(f"B {ev_type} " + " ".join(map(str, codes)) + "\n")
        if ev_type == EV_ABS:
            for code in codes:
                info = bytearray(24)
                fcntl.ioctl(fd, ioc(2, 0x40 + code, 24), info)
                _value, low, high, fuzz, flat, res = struct.unpack("iiiiii", info)
                out.write(f"A {code} {low} {high} {fuzz} {flat} {res}\n")
    # Event times on the clock that libinput and KWin use (CLOCK_MONOTONIC = 1)
    fcntl.ioctl(fd, ioc(1, 0xA0, 4), struct.pack("i", 1))
    out.flush()

    event = struct.Struct("qqHHi")
    while True:
        ready, _, _ = select.select([fd, sys.stdin], [], [])
        if sys.stdin in ready and not os.read(sys.stdin.fileno(), 1):
            break
        if fd not in ready:
            continue
        try:
            data = os.read(fd, event.size * 64)
        except BlockingIOError:
            continue
        for offset in range(0, len(data) - event.size + 1, event.size):
            sec, usec, ev_type, code, value = event.unpack_from(data, offset)
            out.write(f"E {sec * 1000000 + usec} {ev_type} {code} {value}\n")
        out.flush()


def kwin_settings(node):
    settings = {}
    path = "/org/kde/KWin/InputDevice/" + os.path.basename(node)
    for prop in (
        "tapToClick tapAndDrag tapDragLock naturalScroll disableWhileTyping pointerAcceleration "
        "pointerAccelerationProfileFlat scrollFactor"
    ).split():
        try:
            out = subprocess.run(
                ["busctl", "--user", "get-property", "org.kde.KWin", path,
                 "org.kde.KWin.InputDevice", prop],
                capture_output=True, text=True, timeout=5, check=True,
            ).stdout.split()
            settings[prop] = out[1] == "true" if out[0] == "b" else float(out[1])
        except (subprocess.SubprocessError, OSError, IndexError, ValueError):
            pass
    return settings


def command_output(*command):
    try:
        return subprocess.run(command, capture_output=True, text=True, timeout=20).stdout.strip()
    except (subprocess.SubprocessError, OSError):
        return ""


def tweaks_path():
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(config, "danylo-tweaksrc")


def record(name):
    import threading

    from PyQt6.QtCore import QCoreApplication, QPointF, Qt, QTimer
    from PyQt6.QtGui import QColor, QFont, QPainter, QPen
    from PyQt6.QtWidgets import QApplication, QWidget

    node = find_touchpad()
    os.makedirs(TRACES, exist_ok=True)
    path = os.path.join(TRACES, (name or time.strftime("%Y-%m-%d_%H-%M-%S")) + ".trace")

    print("Reading the touchpad's raw events needs root.")
    if subprocess.run(["sudo", "-v"]).returncode != 0:
        sys.exit("No sudo.")
    child = subprocess.Popen(
        ["sudo", "/usr/bin/python3", "-I", os.path.realpath(__file__), "_capture", node],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
    )
    lines = []  # the trace, in order of arrival
    tweaks = ""
    try:
        with open(tweaks_path()) as file:
            tweaks = file.read()
    except OSError:
        pass
    context = {
        "node": node,
        "kwin": kwin_settings(node),
        "tweaks": tweaks,
        "libinput": command_output("rpm", "-q", "libinput"),
        "libinput_changed": command_output("rpm", "-V", "libinput"),
        "patch": command_output(
            "sha256sum", os.path.join(HERE, "../patches/libinput-touchpad-lag.patch")
        )[:12],
        "kwin_version": command_output("rpm", "-q", "kwin"),
        "kernel": os.uname().release,
        "time": time.strftime("%Y-%m-%d %H:%M:%S"),
        "uptime_s": round(time.monotonic()),
    }
    raw_events = [0]

    def read_child():
        header = True
        for line in child.stdout:
            if header and line.startswith("E "):
                header = False
                lines.append("C " + json.dumps(context))
            lines.append(line.rstrip("\n"))
            raw_events[0] += 1

    reader = threading.Thread(target=read_child, daemon=True)
    reader.start()

    def now():
        return time.monotonic_ns() // 1000

    class Window(QWidget):
        def __init__(self):
            super().__init__()
            self.setWindowTitle("touchpad-trace")
            self.setMouseTracking(True)
            self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
            self.scroll = QPointF(0, 0)
            self.cursor = QPointF(0, 0)
            self.marks = 0
            self.flash = 0
            timer = QTimer(self)
            timer.timeout.connect(self.update)
            timer.start(100)

        def mouseMoveEvent(self, event):
            pos = event.position()
            lines.append(f"Q {event.timestamp()} {pos.x():.4f} {pos.y():.4f} {now()}")
            self.cursor = pos
            self.update()

        def wheelEvent(self, event):
            pixels, angle = event.pixelDelta(), event.angleDelta()
            lines.append(
                f"W {event.timestamp()} {pixels.x()} {pixels.y()} {angle.x()} {angle.y()} {now()}"
            )
            self.scroll += QPointF(pixels)
            self.update()

        def keyPressEvent(self, event):
            if event.key() == Qt.Key.Key_Escape:
                self.close()
            elif not event.isAutoRepeat():
                lines.append(f"K {event.timestamp()} {now()}")
                self.marks += 1
                self.flash = now()
                self.update()

        def paintEvent(self, _event):
            painter = QPainter(self)
            marked = now() - self.flash < 300000
            painter.fillRect(self.rect(), QColor(70, 30, 30) if marked else QColor(24, 24, 28))
            width, height = self.width(), self.height()
            # A ruled sheet that scrolls, to see scroll starts against
            painter.setFont(QFont("monospace", 9))
            step = 40
            offset_y, offset_x = self.scroll.y() % step, self.scroll.x() % step
            first = -int(self.scroll.y() // step)
            for i, y in enumerate(range(int(offset_y) - step, height + step, step)):
                painter.setPen(QPen(QColor(60, 60, 70), 1))
                painter.drawLine(0, y, width, y)
                painter.setPen(QColor(110, 110, 125))
                painter.drawText(8, y - 4, str(first + i - 1))
            painter.setPen(QPen(QColor(40, 40, 48), 1))
            for x in range(int(offset_x) - step, width + step, step):
                painter.drawLine(x, 0, x, height)
            # Fixed targets, to aim small movements at
            painter.setPen(QPen(QColor(230, 180, 60), 1))
            for x in range(width // 8, width, width // 8):
                for y in range(height // 6, height, height // 6):
                    painter.drawEllipse(QPointF(x, y), 3, 3)
                    painter.drawEllipse(QPointF(x, y), 12, 12)
            painter.setPen(QColor(235, 235, 235))
            painter.setFont(QFont("sans", 12))
            painter.drawText(
                40, 44,
                "Move the cursor slowly and scroll with two fingers, the way that goes wrong. "
                "Shift or Ctrl right after a jump or a stick marks it. Esc ends the recording.",
            )
            painter.drawText(
                40, 72, f"raw events: {raw_events[0]}    marks: {self.marks}"
                + ("" if raw_events[0] else "    (no raw events yet: touch the touchpad)"),
            )

    # Every motion event as KWin sent it, not merged
    QCoreApplication.setAttribute(Qt.ApplicationAttribute.AA_CompressHighFrequencyEvents, False)
    app = QApplication(sys.argv[:1])
    window = Window()
    window.showFullScreen()
    app.exec()

    child.stdin.close()
    reader.join(timeout=3)
    if child.poll() is None:
        subprocess.run(["sudo", "-n", "kill", str(child.pid)], stderr=subprocess.DEVNULL)

    def order(line):
        fields = line.split()
        # Everything on the kernel's clock: Q, W and K by when they arrived
        return int(fields[1]) if fields[0] == "E" else int(fields[-1])

    header = [line for line in lines if line[0] not in "EQWK"]
    body = sorted((line for line in lines if line[0] in "EQWK"), key=order)
    with open(path, "w") as file:
        file.write("\n".join(header + body) + "\n")
    counts = collections.Counter(line[0] for line in body)
    print(
        f"Wrote {path}: {counts['E']} raw events, {counts['Q']} cursor positions, "
        f"{counts['W']} scroll events, {counts['K']} marks."
    )
    if not counts["E"]:
        print("No raw events: the recording can't be analyzed.")
    else:
        print(f"Analyze it with: {os.path.realpath(__file__)} analyze {path}")


def convert(source, dest):
    import yaml

    with open(source) as file:
        text = file.read()
    device = yaml.safe_load(text[: text.index("  events:")])["devices"][0]["evdev"]
    with open(dest, "w") as out:
        out.write(f"N {device['name']}\n")
        out.write("I " + " ".join(map(str, device["id"])) + "\n")
        out.write("P " + " ".join(map(str, device["properties"])) + "\n")
        for ev_type, codes in device["codes"].items():
            out.write(f"B {ev_type} " + " ".join(map(str, codes)) + "\n")
        for code, info in device["absinfo"].items():
            out.write(f"A {code} " + " ".join(map(str, info)) + "\n")
        out.write("C " + json.dumps({"converted_from": os.path.basename(source)}) + "\n")
        pattern = re.compile(r"^\s*- \[\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+),\s*(-?\d+)\]", re.M)
        for match in pattern.finditer(text):
            sec, usec, ev_type, code, value = map(int, match.groups())
            out.write(f"E {sec * 1000000 + usec} {ev_type} {code} {value}\n")


