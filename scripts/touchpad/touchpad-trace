class Trace:
    def __init__(self, path):
        self.header, self.context = [], {}
        self.res = {}  # units per mm, by axis code
        events, self.cursor, self.wheel, self.marks = [], [], [], []
        with open(path) as file:
            for line in file:
                kind, fields = line[0], line.split()
                if kind == "E":
                    events.append(tuple(map(int, fields[1:5])))
                elif kind == "Q":
                    self.cursor.append((int(fields[1]), float(fields[2]), float(fields[3])))
                elif kind == "W":
                    self.wheel.append(tuple(map(int, fields[1:6])))
                elif kind == "K":
                    self.marks.append(int(fields[1]))
                elif kind == "C":
                    self.context = json.loads(line[2:])
                elif kind in "NIPBA":
                    self.header.append(line)
                    if kind == "A":
                        self.res[int(fields[1])] = int(fields[6]) or 1
        if not events:
            sys.exit("No raw events in the trace.")
        self.start = events[0][0]
        self.events = [(usec - self.start, t, c, v) for usec, t, c, v in events]
        self.res_x = self.res.get(ABS_MT_POSITION_X, 31)
        self.res_y = self.res.get(ABS_MT_POSITION_Y, 32)

        # Frames: (usec, {slot: (x, y, tracking id)}, button down)
        self.frames = []
        slot, pos, active, button = 0, {}, {}, False
        for usec, ev_type, code, value in self.events:
            if ev_type == EV_ABS and code == ABS_MT_SLOT:
                slot = value
            elif ev_type == EV_ABS and code == ABS_MT_TRACKING_ID:
                if value == -1:
                    active.pop(slot, None)
                else:
                    active[slot] = value
                    pos.setdefault(slot, [0, 0])
            elif ev_type == EV_ABS and code == ABS_MT_POSITION_X:
                pos.setdefault(slot, [0, 0])[0] = value
            elif ev_type == EV_ABS and code == ABS_MT_POSITION_Y:
                pos.setdefault(slot, [0, 0])[1] = value
            elif ev_type == EV_KEY and code == BTN_LEFT:
                button = bool(value)
            elif ev_type == EV_SYN and code == 0 and value == 0:
                touches = {s: (pos[s][0], pos[s][1], active[s]) for s in active}
                self.frames.append((usec, touches, button))

    def rel_usec(self, msec):
        """A KWin event time (ms, 32 bits of the kernel's clock) as usec since the start."""
        delta = (msec - self.start // 1000) & 0xFFFFFFFF
        if delta > 0x7FFFFFFF:
            delta -= 0x100000000
        return delta * 1000


def build_replay():
    source, binary = os.path.join(HERE, "replay.c"), os.path.join(CACHE, "replay")
    if os.path.exists(binary) and os.path.getmtime(binary) >= os.path.getmtime(source):
        return binary
    os.makedirs(CACHE, exist_ok=True)
    flags = subprocess.run(
        ["pkg-config", "--cflags", "--libs", "libinput"], capture_output=True, text=True
    )
    if flags.returncode != 0:
        sys.exit("The replay needs libinput-devel (sudo dnf install libinput-devel gcc).")
    built = subprocess.run(
        ["gcc", "-O2", "-rdynamic", "-o", binary, source] + flags.stdout.split(),
        capture_output=True, text=True,
    )
    if built.returncode != 0:
        sys.exit("Couldn't build replay.c:\n" + built.stderr)
    return binary


def replay(trace, lib=None, tweaks=None, verbose=False):
    """Run the raw events through libinput: ({usec: motion}, {usec: scroll}, others, log).
    The log: (usec, text) of libinput's state changes."""
    binary = build_replay()
    kwin = trace.context.get("kwin", {})
    options = [
        f"tap={int(kwin.get('tapToClick', True))}",
        f"drag={int(kwin.get('tapAndDrag', True))}",
        f"draglock={int(kwin.get('tapDragLock', False))}",
        f"natural={int(kwin.get('naturalScroll', False))}",
        f"dwt={int(kwin.get('disableWhileTyping', True))}",
        f"speed={kwin.get('pointerAcceleration', 0.0)}",
        "profile=" + ("flat" if kwin.get("pointerAccelerationProfileFlat") else "adaptive"),
        f"verbose={int(verbose)}",
    ]
    env = dict(os.environ)
    if lib:
        env["LD_LIBRARY_PATH"] = lib
    with tempfile.TemporaryDirectory() as config:
        # The patched library reads its settings from here: those of the recording
        if tweaks is None:
            tweaks = trace.context.get("tweaks", "")
        else:
            with open(tweaks) as file:
                tweaks = file.read()
        with open(os.path.join(config, "danylo-tweaksrc"), "w") as file:
            file.write(tweaks)
        env["XDG_CONFIG_HOME"] = config
        text = "".join(trace.header) + "".join(
            f"E {usec} {t} {c} {v}\n" for usec, t, c, v in trace.events
        )
        seconds = trace.events[-1][0] / 1e6
        print(f"Replaying {seconds:.0f} s of events at their recorded pace...", file=sys.stderr)
        done = subprocess.run(
            [binary, find_touchpad()] + options, input=text, capture_output=True, text=True, env=env
        )
    if done.returncode != 0:
        sys.exit("The replay failed:\n" + done.stderr[-2000:])
    motion, scroll, others, log = {}, {}, [], []
    for line in done.stdout.splitlines():
        fields = line.split()
        if fields[0] == "L":
            text = line.split(None, 2)[2] if len(fields) > 2 else ""
            # "event15 - gesture: [1fg] state A -> B": without the device, and only changes
            text = text.split(" - ", 1)[-1]
            if any(word in text for word in ("gesture: ", "tap: ", "palm", "thumb", "hysteresis",
                                             "dwt", "jump", "bug")) and " event " not in text:
                log.append((int(fields[1]), text))
        elif fields[0] == "M":
            usec, dx, dy = int(fields[1]), float(fields[2]), float(fields[3])
            old = motion.get(usec, (0.0, 0.0))
            motion[usec] = (old[0] + dx, old[1] + dy)
        elif fields[0] == "S":
            usec, vertical, horizontal = int(fields[1]), float(fields[2]), float(fields[3])
            old = scroll.get(usec, (0.0, 0.0))
            scroll[usec] = (old[0] + horizontal, old[1] + vertical)
        else:
            others.append((int(fields[1]), fields[0], fields[2:]))
    return motion, scroll, others, log


def by_frame(trace, events):
    """KWin's events ({usec: (dx, dy)}), each put on the raw frame it came from: KWin's event
    times are the frames' times, cut to ms."""
    frame_of_ms = {}
    for usec, _touches, _button in trace.frames:
        frame_of_ms.setdefault(usec // 1000, usec)
    out, unmatched = {}, 0
    for usec, dx, dy in events:
        frame = frame_of_ms.get(usec // 1000)
        if frame is None:
            # A timer's event (a scroll stop, say): keep it at its own time
            frame, unmatched = usec, unmatched + 1
        old = out.get(frame, (0.0, 0.0))
        out[frame] = (old[0] + dx, old[1] + dy)
    return out, unmatched


def segments(trace):
    """Split the frames into runs with the same touches down: (finger count, frames)."""
    runs, key, run = [], None, []
    for frame in trace.frames:
        ids = tuple(sorted(touch[2] for touch in frame[1].values()))
        if ids != key:
            if run and key:
                runs.append((len(key), run))
            key, run = ids, []
        run.append(frame)
    if run and key:
        runs.append((len(key), run))
    return runs


def tracks(trace, frames):
    """What the fingers of a run do: (what, [(x, y) per frame]).

    One finger moves the cursor, and so does one finger next to a resting one (a thumb waiting
    to click, say): its path. Two moving fingers scroll: the path of their midpoint.
    """
    slots = sorted(frames[0][1])
    paths = {slot: [frame[1][slot][:2] for frame in frames] for slot in slots}
    if len(slots) == 1:
        return "cursor", paths[slots[0]]
    lengths = {
        slot: sum(
            math.hypot((b[0] - a[0]) / trace.res_x, (b[1] - a[1]) / trace.res_y)
            for a, b in zip(path, path[1:])
        )
        for slot, path in paths.items()
    }
    still, moving = sorted(slots, key=lengths.get)
    if lengths[still] < 1.0 and lengths[still] < 0.25 * lengths[moving]:
        return "cursor, next to a resting touch", paths[moving]
    return "scroll", [
        ((a[0] + b[0]) / 2, (a[1] + b[1]) / 2) for a, b in zip(paths[slots[0]], paths[slots[1]])
    ]


class Finding:
    def __init__(self, usec, kind, text):
        self.usec, self.kind, self.text = usec, kind, text


def analyze_run(trace, fingers, frames, path, output, label):
    """Compare the fingers' motion with an output ({usec: (dx, dy)}) over one run of frames.

    Returns (summary, findings). The path is the fingers' (see tracks()), the output the cursor's
    motion or the scroll. Its gain (output per mm) is taken from the run itself, so only changes
    of it count.
    """
    px, py = path[0]
    steps = []  # (usec, mm since the last frame, output in this frame or None, button)
    for (usec, _touches, button), (x, y) in zip(frames, path):
        mm = math.hypot((x - px) / trace.res_x, (y - py) / trace.res_y)
        px, py = x, y
        out = output.get(usec)
        steps.append((usec, mm, math.hypot(*out) if out else None, button))
    raw_total = sum(step[1] for step in steps)
    out_total = sum(step[2] or 0 for step in steps)
    if raw_total < 0.05:
        return None, []

    # The gain: the median over output events of output per mm moved since the last one
    gains, pending = [], 0.0
    for _usec, mm, out, _button in steps:
        pending += mm
        if out is not None:
            if pending > 0 and out > 0:
                gains.append(out / pending)
            pending = 0.0
    gain = sorted(gains)[len(gains) // 2] if gains else 0.0

    findings = []
    # Dead zones: the fingers move but nothing comes out, at the start and after each pause
    pending, since, quiet_from, first = 0.0, steps[0][0], None, True
    last_motion = steps[0][0]
    for usec, mm, out, button in steps:
        if mm > 0:
            if pending == 0.0:
                since = usec
                paused = usec - last_motion > 150000
            pending += mm
            last_motion = usec
        if out is not None and out > 0:
            # 1 unit of the touchpad is ~0.03 mm: more than 3 of them without output
            if pending > 0.1 and not button and (first or paused):
                where = "at the start" if first else "after a pause"
                findings.append(Finding(
                    usec, "dead",
                    f"{label}: no output for the first {pending:.2f} mm ({(usec - since) / 1000:.0f} "
                    f"ms) {where}, then {out:.1f} px at once (even: {gain * mm:.1f})",
                ))
            pending, first = 0.0, False
    if first and raw_total > 0.3 and not any(step[3] for step in steps):
        findings.append(Finding(
            steps[0][0], "dead",
            f"{label}: no output at all for {raw_total:.2f} mm of motion",
        ))
    # Jumps: one event's output far above what the motion since the last one is worth
    pending = 0.0
    for usec, mm, out, _button in steps:
        pending += mm
        if out is not None:
            even = gain * pending
            if gain and out - even > 2.0 and out > 2.0 * even:
                findings.append(Finding(
                    usec, "jump",
                    f"{label}: {out:.1f} px in one event for {pending:.3f} mm of motion "
                    f"(even: {even:.1f} px)",
                ))
            pending = 0.0
    summary = {
        "start": steps[0][0], "end": steps[-1][0], "fingers": fingers,
        "raw_mm": raw_total, "out": out_total, "gain": gain,
    }
    return summary, findings


def table(trace, replay_out, kwin_out, log, start, end):
    print(f"      {'ms':>9}  fingers (units)        replay        recorded")
    previous = {}
    notes = [note for note in log if start <= note[0] <= end]
    for usec, touches, button in trace.frames:
        while notes and notes[0][0] <= usec:
            print(f"      {notes[0][0] / 1000:9.1f}  libinput: {notes.pop(0)[1]}")
        if not start <= usec <= end:
            previous = touches
            continue
        moves = []
        for slot, (x, y, tid) in sorted(touches.items()):
            old = previous.get(slot)
            if old and old[2] == tid:
                moves.append(f"{x - old[0]:+d},{y - old[1]:+d}")
            else:
                moves.append("down")
        previous = touches
        replayed, recorded = replay_out.get(usec), kwin_out.get(usec)
        if not replayed and not recorded and all(move == "+0,+0" for move in moves):
            continue
        print(
            f"      {usec / 1000:9.1f}  {' '.join(moves):<20}"
            + (f"  {replayed[0]:+6.2f},{replayed[1]:+6.2f}" if replayed else "  " + " " * 13)
            + (f"  {recorded[0]:+6.2f},{recorded[1]:+6.2f}" if recorded else "")
            + ("  [button]" if button else "")
        )


def analyze(path, lib=None, show_all=False, tweaks=None):
    trace = Trace(path)
    print(f"{path}: {trace.events[-1][0] / 1e6:.1f} s, {len(trace.frames)} frames, "
          f"{len(trace.cursor)} cursor positions, {len(trace.wheel)} scroll events, "
          f"{len(trace.marks)} marks")
    for key in ("time", "uptime_s", "libinput", "libinput_changed", "patch", "kwin"):
        if key in trace.context:
            print(f"  {key}: {trace.context[key]}")
    if trace.context.get("tweaks"):
        print("  tweaks: " + " ".join(trace.context["tweaks"].split()))

    motion, scroll, others, log = replay(trace, lib, tweaks, verbose=True)
    # Natural scrolling flips the sign in KWin, after libinput: compare sizes only (hypot)

    # What KWin did: the cursor's steps from its positions, the scroll's from the wheel events
    cursor_steps, last = [], None
    for msec, x, y in trace.cursor:
        if last and (msec - last[0]) & 0xFFFFFFFF < 100:
            cursor_steps.append((trace.rel_usec(msec), x - last[1], y - last[2]))
        last = (msec, x, y)
    kwin_motion, _ = by_frame(trace, cursor_steps)
    kwin_scroll, _ = by_frame(
        trace, [(trace.rel_usec(msec), dx, dy) for msec, dx, dy, _ax, _ay in trace.wheel]
    )
    recorded = bool(trace.cursor or trace.wheel)

    hysteresis = [text for _usec, text in log if "hysteresis enabled" in text]
    if hysteresis:
        print("\n  The replay turned on libinput's hysteresis (a dead zone of 1/4 mm) partway.")

    all_findings, rows = [], []
    for fingers, frames in segments(trace):
        if fingers > 2:
            continue
        what, path = tracks(trace, frames)
        cursor = what != "scroll"
        results = []
        for name, output in (("replay", motion if cursor else scroll),
                             ("recorded", kwin_motion if cursor else kwin_scroll)):
            if name == "recorded" and not recorded:
                continue
            summary, findings = analyze_run(trace, fingers, frames, path, output, name)
            if summary:
                results.append((name, summary, findings))
        if results:
            rows.append((what, frames, results))
            for _name, _summary, findings in results:
                all_findings += findings

    print("\nStrokes and scrolls. mm: the fingers' path; px: the output's; px/mm: the usual output"
          "\nper mm within the stroke.")
    for what, frames, results in rows:
        findings = [finding for _n, _s, found in results for finding in found]
        if not findings and not show_all:
            continue
        summary = results[0][1]
        line = (f"  {summary['start'] / 1000:9.1f} ms  {what}  "
                f"{(summary['end'] - summary['start']) / 1000:.0f} ms  {summary['raw_mm']:.2f} mm:")
        for name, result, _findings in results:
            line += f"  {name} {result['out']:.1f} px, {result['gain']:.1f} px/mm;"
        print(line.rstrip(";"))
        for finding in findings:
            print(f"      {finding.usec / 1000:9.1f} ms  {finding.kind}: {finding.text}")
        for finding in findings[:2]:
            table(trace, motion if what != "scroll" else scroll,
                  kwin_motion if what != "scroll" else kwin_scroll, log,
                  finding.usec - 120000, finding.usec + 40000)

    kinds = collections.Counter(
        (finding.kind, finding.text.split(":")[0]) for finding in all_findings
    )
    print(f"\n{len(rows)} strokes and scrolls with motion. Found: "
          + (", ".join(f"{count} {kind} ({where})" for (kind, where), count in sorted(kinds.items()))
             or "nothing"))

    for msec in trace.marks:
        usec = trace.rel_usec(msec)
        print(f"\nMark at {usec / 1000:.1f} ms: the 1.5 s before it")
        near = [f for f in all_findings if usec - 1500000 <= f.usec <= usec]
        for finding in near:
            print(f"      {finding.usec / 1000:9.1f} ms  {finding.kind}: {finding.text}")
        table(trace, {**motion, **scroll}, {**kwin_motion, **kwin_scroll}, log,
              usec - 1500000, usec)


def main():
    args = sys.argv[1:]
    if len(args) == 2 and args[0] == "_capture":
        try:
            capture(args[1])
        except (BrokenPipeError, KeyboardInterrupt):
            pass
    elif args and args[0] == "record" and len(args) <= 2:
        record(args[1] if len(args) == 2 else None)
    elif len(args) >= 2 and args[0] == "analyze":
        options = args[2:]
        lib = options[options.index("--lib") + 1] if "--lib" in options else None
        tweaks = options[options.index("--tweaks") + 1] if "--tweaks" in options else None
        analyze(args[1], lib, "--all" in options, tweaks)
    elif len(args) == 3 and args[0] == "convert":
        convert(args[1], args[2])
    else:
        print(__doc__.strip())
        sys.exit(1)


if __name__ == "__main__":
    main()
