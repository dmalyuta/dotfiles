+
+static double
+scroll_catch_up(double delta, double *left, double all)
+{
+	double extra;
+
+	if (delta * *left < 0.0)
+		*left = 0.0; /* scrolling back: never mind */
+	if (delta * *left <= 0.0)
+		return delta;
+	extra = copysign(fmin(scroll_backlog.speed * fabs(delta / all), 1.0) * fabs(*left), delta);
+	*left -= extra;
+	return delta + extra;
