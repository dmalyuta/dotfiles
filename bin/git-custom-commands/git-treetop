#!/bin/sh
# The newest rows of `git tree`, numbered: $1 of them, or as many as the last time.
rows_file=/tmp/git_treetop_rows
rows=${1:-$(cat "$rows_file" 2>/dev/null || echo 10)}
git tree "-$rows" --color=always | head -n "$rows" |
	awk -v width="${#rows}" '{ printf("%-*d %s\n", width, NR, $0) }'
echo "$rows" >"$rows_file"
