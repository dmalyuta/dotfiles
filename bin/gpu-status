#!/bin/bash
#
# NVIDIA dGPU power status: whether it is powered off, whether the driver can power it off when
# idle, how much of the time it has been off, and what has it open.
#
# Reads only sysfs and the driver's procfs power summary. Never runs nvidia-smi, NVML or anything
# else that opens /dev/nvidia*, and never reads the GPU's PCI config space, since each of those
# powers a sleeping dGPU back on. So the dGPU's own power draw is unknown while it is awake; while
# it is off (D3cold) its power is cut, so it draws ~0 W.
#
# Usage: gpu-status
#
# Author: Danylo Malyuta, 2026.

set -u

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
	bold=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' green=$'\e[32m' yellow=$'\e[33m' cyan=$'\e[36m'
	reset=$'\e[0m'
else
	bold='' dim='' red='' green='' yellow='' cyan='' reset=''
fi

# A section header, after a blank line unless it is the first.
sections=0
section() {
	local rule
	printf -v rule '%*s' $((60 - ${#1})) ''
	((sections++)) && echo
	printf '%s━━ %s %s%s\n' "$bold$cyan" "$1" "${rule// /━}" "$reset"
}
row() { printf '  %-18s %s\n' "$1" "$2"; }

# Milliseconds as "1h 02m", "3m 05s" or "12s".
duration() {
	local s=$(($1 / 1000))
	if ((s >= 3600)); then
		printf '%dh %02dm' $((s / 3600)) $((s % 3600 / 60))
	elif ((s >= 60)); then
		printf '%dm %02ds' $((s / 60)) $((s % 60))
	else
		printf '%ds' "$s"
	fi
}

section "NVIDIA dGPU"

# The driver lists its GPUs by PCI address. Without the driver, look for an Nvidia display device.
bdf=
for d in /proc/driver/nvidia/gpus/*; do
	[ -d "$d" ] && bdf=${d##*/} && break
done
if [ -z "$bdf" ]; then
	for d in /sys/bus/pci/devices/*; do
		if [ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] &&
			[[ $(cat "$d/class" 2>/dev/null) == 0x03* ]]; then
			bdf=${d##*/}
			break
		fi
	done
fi
# Cardwire hides the device from /sys/bus/pci while it blocks it, but its DRM card still links to it.
dev=/sys/bus/pci/devices/$bdf
if [ -z "$bdf" ] || [ ! -e "$dev" ]; then
	for c in /sys/class/drm/card[0-9]*; do
		[[ $(readlink -f "$c/device/driver" 2>/dev/null) == */nvidia ]] || continue
		dev=$(readlink -f "$c/device")
		bdf=${dev##*/}
		break
	done
fi
if [ -z "$bdf" ] || [ ! -e "$dev" ]; then
	row "Status" "${dim}no NVIDIA GPU found$reset"
	exit 0
fi

# Name and blocking state from cardwire, if it is installed. It answers from its own records.
name= mode= holders=
if command -v cardwire >/dev/null; then
	line=$(cardwire list 2>/dev/null | grep -F " $bdf ")
	if [ -n "$line" ]; then
		id=$(awk '{ print $1 }' <<<"$line")
		name=$(sed -E "s/^[0-9]+ +(.*[^ ]) +$bdf .*/\1/" <<<"$line")
		holders=$(cardwire gpu --lsof "$id" 2>/dev/null | grep -o '"[^"]*"' | tr -d '"' |
			grep -vx cardwired | sort -u | paste -sd, | sed 's/,/, /g')
	fi
	mode=$(cardwire get 2>/dev/null | sed -n 's/^Current Mode: //p')
fi
# Otherwise name it from the PCI ID database. The sysfs vendor/device files are cached by the kernel.
if [ -z "$name" ] && [ -r /usr/share/hwdata/pci.ids ]; then
	device=$(cat "$dev/device")
	name=$(awk -v dev="${device#0x}" '
		/^10de/ { in_nv = 1; next }
		/^[0-9a-f]/ { in_nv = 0 }
		in_nv && $1 == dev { $1 = ""; sub(/^ /, ""); print; exit }
	' /usr/share/hwdata/pci.ids)
fi
printf '  %s%s%s %s(%s)%s\n' "$bold" "${name:-NVIDIA GPU}" "$reset" "$dim" "$bdf" "$reset"

state=$(cat "$dev/power_state" 2>/dev/null)
case $state in
D3cold) row "Power" "${green}off$reset (D3cold, power cut, ~0 W)" ;;
D3hot) row "Power" "${yellow}sleeping$reset (D3hot, power on, draw unknown)" ;;
D0) row "Power" "${yellow}awake$reset (D0, draw unknown without waking it)" ;;
*) row "Power" "${state:-unknown}" ;;
esac

if [ -r "/proc/driver/nvidia/gpus/$bdf/power" ]; then
	rtd3=$(sed -n 's/^Runtime D3 status: *//p' "/proc/driver/nvidia/gpus/$bdf/power")
	vram=$(sed -n 's/^Video Memory: *//p' "/proc/driver/nvidia/gpus/$bdf/power")
	if [[ $rtd3 == Enabled* ]]; then
		row "Auto power-off" "$green$rtd3$reset"
	else
		row "Auto power-off" "$red${rtd3:-unknown}$reset"
		row "" "${dim}The dGPU stays on even when idle. It works on the LTS kernel.$reset"
	fi
	[ -n "$vram" ] && row "Video memory" "$vram"
else
	row "Driver" "${dim}not loaded$reset"
fi

# Time spent powered off vs on since runtime power management started (about boot).
off_ms=$(cat "$dev/power/runtime_suspended_time" 2>/dev/null || echo 0)
on_ms=$(cat "$dev/power/runtime_active_time" 2>/dev/null || echo 0)
if ((off_ms + on_ms > 0)); then
	pct=$((100 * off_ms / (off_ms + on_ms)))
	color=$green
	((pct < 90)) && color=$yellow
	((pct < 50)) && color=$red
	row "Off since boot" "$color$pct%$reset $dim($(duration "$off_ms") off, $(duration "$on_ms") on)$reset"
fi

tgp=$(cat /sys/class/firmware-attributes/asus-armoury/attributes/nv_base_tgp/current_value \
	2>/dev/null)
[ -n "$tgp" ] && row "Base power limit" "$tgp W"
[ -n "$mode" ] && row "Cardwire mode" "$mode"
[ -f /sys/module/nvidia/version ] &&
	row "Driver" "$(cat /sys/module/nvidia/version) $dim(kernel $(uname -r))$reset"
# Open handles alone don't keep it awake; the driver powers it off once they go idle.
[ -n "$holders" ] && row "Open by" "$holders"
exit 0
