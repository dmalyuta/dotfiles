#!/bin/bash
# Debug log for sleep and hibernation, to find the cause the first time one goes wrong: a
# hibernation that hangs at power-off and drains the battery overnight, a sleep that doesn't reach
# the SoC's deepest state or keeps waking up, or a sleep that never comes back. README.md in
# scripts/sleep-debug says what it logs, how its watchdogs get out of a hang, and how to read a
# trace.
#
# A systemd sleep hook, run around each sleep step (SYSTEMD_SLEEP_ACTION says which), and at boot
# by sleep-debug.service. Installed and removed by scripts/sleep-debug/setup.
#
# Read it with journalctl -t sleep-debug, and the files in /var/log/sleep-debug.
#
# Author: Danylo Malyuta, 2026.

set -u
dir=/var/log/sleep-debug
marker=$dir/asleep
state=/run/sleep-debug
efi=/sys/firmware/efi/efivars
var=$efi/HibernateTrace-8bc5b097-6e23-408e-9a7d-2bad8e8739d1
# What efi-pstore names a kernel crash's log (LINUX_EFI_CRASH_GUID), and the initramfs's note that
# it powered off for one.
crash_vars=$efi/dump-type0-*-cfc8fc79-be2e-4ddc-97f0-9f98bfe298a0
crash_off=$efi/HibernateCrashOff-8bc5b097-6e23-408e-9a7d-2bad8e8739d1
# The initramfs's note that the chipset's watchdog had fired.
tco_fired=$efi/HibernateTcoFired-8bc5b097-6e23-408e-9a7d-2bad8e8739d1
alerts=$dir/alerts
pstore=/sys/fs/pstore
watchdogs=/sys/class/watchdog
# setup's settings for the chipset's watchdog.
tco_conf=/etc/modprobe.d/sleep-debug-tco.conf
# setup's switch for pm_trace (setup trace on|off).
trace_flag=/etc/sleep-debug/pm-trace
sysctl=/proc/sys/kernel
self=$(readlink -f "$0")
bat=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n 1)
action=${SYSTEMD_SLEEP_ACTION:-${2:-}}

log() { logger -t sleep-debug -- "$*"; }
bat_get() { cat "$bat/$1" 2>/dev/null || echo "$2"; }
hw_sleep() { cat /sys/power/suspend_stats/total_hw_sleep 2>/dev/null || echo 0; }
now() { date +%s; }
uptime_s() { cut -d. -f1 /proc/uptime; }

# A new file in the log (or the folder given) named <time>-<kind>.txt, never one that exists.
new_file() {
	local d=${2:-$dir} f i=1
	f=$d/$(date +%Y%m%d-%H%M%S)-$1.txt
	while [ -e "$f" ]; do f=$d/$(date +%Y%m%d-%H%M%S)-$1-$((i++)).txt; done
	echo "$f"
}

# Log a problem, and show it in a window in the desktop session (sleep-debug-alert). Moved into
# the folder whole, as sleep-debug-alert.path starts the window when a file appears there.
alert() {
	log "$*"
	mkdir -p "$alerts"
	echo "$*" >"$dir/.alert.tmp" && mv "$dir/.alert.tmp" "$(new_file alert "$alerts")"
}

# The wakeup sources' event counts, one "<name>@<device> <count>" per line.
wakeups() {
	local w
	for w in /sys/class/wakeup/*; do
		echo "$(tr ' ' _ <"$w/name")@$(basename "$(readlink -f "$w/device")") $(cat "$w/event_count")"
	done 2>/dev/null
}

# The battery drain of a sleep: seconds, energy before and after (µWh).
drain() {
	awk -v t="$1" -v e0="$2" -v e1="$3" -v full="$(bat_get energy_full 1)" 'BEGIN {
		wh = (e0 - e1) / 1e6; w = (t > 0 ? wh / (t / 3600) : 0)
		printf "%dh%02dm, used %.2f Wh (%.1f%%), %.2f W avg, %.1f%% per 8 h",
			t / 3600, t % 3600 / 60, wh, 100 * wh / (full / 1e6), w, 100 * w * 8 / (full / 1e6)
	}'
}

snapshot() {
	echo "# $(date -Is) $*, step $action, up $(uptime_s) s, kernel $(uname -r)"
	echo "## battery"
	grep -H . "$bat"/{status,capacity,energy_now,power_now} /sys/class/power_supply/AC*/online 2>/dev/null
	echo "## /sys/power"
	grep -H . /sys/power/{disk,mem_sleep,image_size,pm_trace} /sys/power/suspend_stats/* 2>/dev/null
	echo "## memory"
	free -m
	swapon --show
	echo "## nvidia: driver version, users (its power state is in the pci list)"
	cat /sys/module/nvidia/version 2>/dev/null
	timeout 5 fuser -v /dev/nvidia* 2>&1
	local d
	echo "## pci: address vendor:device class driver runtime_status power_state d3cold_allowed wakeup"
	for d in /sys/bus/pci/devices/*; do
		echo "${d##*/} $(cat "$d/vendor" "$d/device" 2>/dev/null | sed 's/^0x//' | paste -sd:)" \
			"$(cat "$d/class") $(basename "$(readlink "$d/driver" 2>/dev/null)" 2>/dev/null)" \
			"$(cat "$d/power/runtime_status" "$d/power_state" "$d/d3cold_allowed" \
				"$d/power/wakeup" 2>/dev/null | paste -sd' ')"
	done
	echo "## usb: device vendor:product name runtime_status wakeup"
	for d in /sys/bus/usb/devices/*; do
		[ -f "$d/idVendor" ] || continue
		echo "${d##*/} $(cat "$d/idVendor"):$(cat "$d/idProduct") '$(cat "$d/product" 2>/dev/null)'" \
			"$(cat "$d/power/runtime_status" "$d/power/wakeup" 2>/dev/null | paste -sd' ')"
	done
	echo "## thunderbolt"
	for d in /sys/bus/thunderbolt/devices/*; do
		[ -f "$d/device_name" ] && echo "${d##*/} $(cat "$d/vendor_name" "$d/device_name" | paste -sd' ')"
	done
	echo "## acpi wakeup enabled"
	grep enabled /proc/acpi/wakeup
	echo "## wakeup sources: name@device event_count"
	cat "$state.wakeups"
	echo "## network"
	rfkill
	timeout 5 nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device
	echo "## modules"
	lsmod
	echo "## kernel log tail"
	dmesg | tail -n 40
	# The names pm_trace hashes, to decode a trace (pm-trace-decode).
	if [ "$action" = hibernate ]; then
		echo "## devices"
		find /sys/devices -name uevent -printf '%h\n' | sed 's|.*/||' | sort -u
	fi
}

# Whether the hibernation just over was traced: pre() notes it, and at a fresh boot, whose /run is
# new, go by the switch.
traced() {
	[ -e "$state.trace" ] || { [ ! -e "$state" ] && [ -e "$trace_flag" ]; }
}

# Move a pm_trace saved by the initramfs into the log (or drop it, when pm_trace was off and the RTC
# held the real time; the initramfs saves it at every resume).
collect_trace() {
	[ -e "$var" ] || return 0
	if ! traced; then
		chattr -i "$var" 2>/dev/null
		rm -f "$var"
		return
	fi
	mkdir -p "$dir"
	local f
	f=$(new_file trace)
	tail -c +5 "$var" >"$f"
	log "$1, its pm_trace ($f): $(grep -v '^rtc:' "$f" | paste -sd' ' | head -c 800)"
	chattr -i "$var" 2>/dev/null
	rm -f "$var"
}

# A marker left by a sleep that never came back.
check_marker() {
	[ -f "$marker" ] || return 0
	alert "The last boot ended during a sleep it never came back from (it hung, or the battery" \
		"died): $(cat "$marker"). See journalctl -b -1."
	rm -f "$marker"
}

# The kernel settings during a hibernation: reboot 5 s after a crash; crash at once on a CPU stuck
# in the kernel (a soft or hard lockup), with its stack; and before saving the crash log, print
# the stacks of the tasks stuck waiting, such as one stuck in a driver's shutdown.
crash_sysctls="panic=5 softlockup_panic=1 hardlockup_panic=1 panic_sys_info=blocked_tasks"

# Arm the watchdogs for a hibernation (see the README). The software one crashes the kernel after
# 5 min, for its log: only with efi-pstore, else the log is lost and the initramfs can't tell, and
# would resume. The chipset's (sp5100_tco), which setup sets to reset after 10 min, is the
# backstop for a hang that nothing in the kernel can see.
arm_watchdog() {
	local w soft= tco= kv saved=
	if [ "$(cat /sys/module/pstore/parameters/backend 2>/dev/null)" != efi_pstore ]; then
		log "hibernate: no watchdog, efi-pstore is off (efi_pstore.pstore_disable=0 takes a reboot)"
		return
	fi
	modprobe -r softdog 2>/dev/null
	modprobe softdog soft_margin=300 soft_panic=1 || return
	# The chipset's watchdog takes setup's settings when its driver loads: should it have loaded
	# without them (from an initramfs built before them), load it again with them.
	for w in "$watchdogs"/*; do
		if [ "$(cat "$w/identity" 2>/dev/null)" = "SP5100 TCO timer" ] &&
			[ "$(cat "$w/timeout" 2>/dev/null)" != 600 ] && [ -e "$tco_conf" ]; then
			modprobe -r sp5100_tco && modprobe sp5100_tco action=0 heartbeat=600
		fi
	done
	for w in "$watchdogs"/*; do
		case $(cat "$w/identity" 2>/dev/null) in
		"Software Watchdog") soft=/dev/${w##*/} ;;
		"SP5100 TCO timer") [ "$(cat "$w/timeout" 2>/dev/null)" = 600 ] && tco=/dev/${w##*/} ;;
		esac
	done
	[ -n "$soft" ] || { log "hibernate: no watchdog, softdog has no device" && return; }
	[ "$(cat /sys/module/watchdog/parameters/stop_on_reboot 2>/dev/null)" = 0 ] ||
		log "hibernate: the watchdog stops if the power-off falls back to a plain one" \
			"(watchdog.stop_on_reboot=0 takes a reboot)"
	for kv in $crash_sysctls; do
		saved="$saved ${kv%%=*}=$(cat "$sysctl/${kv%%=*}")"
	done
	echo "soft=$soft tco=$tco$saved" >"$state.watchdog"
	for kv in $crash_sysctls; do
		echo "${kv#*=}" >"$sysctl/${kv%%=*}"
	done
	# Opening one starts it, and closing it without writing V leaves it running.
	printf x >"$soft"
	[ -n "$tco" ] && printf x >"$tco"
	log "hibernate: watchdog armed: a crash 5 min from now if this doesn't power off${tco:+,}" \
		"${tco:+and a reset by the chipset at 10 min, then a power-off}"
}

# Disarm them (writing V before closing stops one), and put back the kernel settings. Idempotent:
# both this hook's post and sleep-debug-wake.service call it.
disarm_watchdog() {
	local kv
	(
		flock 8
		[ -f "$state.watchdog" ] || exit 0
		for kv in $(cat "$state.watchdog"); do
			case $kv in
			soft= | tco=) ;;
			soft=* | tco=*) printf V >"${kv#*=}" ;;
			*=*) echo "${kv#*=}" >"$sysctl/${kv%%=*}" ;;
			esac
		done
		rm -f "$state.watchdog"
		modprobe -r softdog 2>/dev/null
		log "watchdog disarmed"
	) 8>>"$state.lock"
}

# Join the parts of crash logs into one log, oldest first. Each part starts with a line like
# "Panic#1 Part114": the crash's number, then the part's, part 1 being the crash log's end. Their
# file names don't order them: they hold the time each part was written, which can differ.
join_crash_parts() {
	local f n m
	for f in "$@"; do
		read -r n m < <(head -n 1 "$f" | sed -nE 's/^[A-Za-z]+#([0-9]+) Part([0-9]+).*/\1 \2/p')
		echo "${n:-0} ${m:-0} $f"
	done | sort -k1,1n -k2,2nr | while read -r n m f; do
		cat "$f"
	done
}

# The log of a kernel crash from its EFI variables themselves, oldest part first, for when pstorefs
# doesn't list them (as after a resume). Each is named dump-type0-<part>-<count>-<time>-<C if
# compressed>-<guid> and holds 4 bytes of attributes, then the part, zlib-compressed. Read with
# cat: cp fails on efivarfs.
decode_crash_vars() {
	local tmp v
	tmp=$(mktemp -d) || return
	for v in $crash_vars; do
		cat "$v" >"$tmp/${v##*/}" || true
	done
	python3 -I - "$tmp" <<'PY'
import os, re, sys, zlib
d = sys.argv[1]
parts = []
for n in os.listdir(d):
    m = re.match(r"dump-type0-(\d+)-(\d+)-(\d+)-([CD])-", n)
    if not m:
        continue
    data = open(os.path.join(d, n), "rb").read()[4:]
    if m.group(4) == "C":
        try:
            data = zlib.decompress(data, -15)
        except zlib.error as e:
            data = f"[part {m.group(1)} of crash {m.group(2)}: undecodable, {e}]\n".encode()
    parts.append((int(m.group(3)), int(m.group(2)), -int(m.group(1)), data))
for *_, data in sorted(parts):
    sys.stdout.buffer.write(data)
PY
	rm -rf "$tmp"
}

# Move the log of a kernel crash saved in EFI variables (the watchdog's) into the log. The kernel
# lists them in pstorefs when it is mounted, so mount it again for ones saved since the boot.
# Failing that, decode the variables directly. They are deleted only once the log is saved.
collect_crash() {
	local f parts
	ls $crash_vars >/dev/null 2>&1 || return 0
	umount "$pstore" 2>/dev/null
	mount -t pstore pstore "$pstore" 2>/dev/null
	parts=$(ls -d "$pstore"/dmesg-* 2>/dev/null)
	f=$(new_file crash)
	if [ -n "$parts" ]; then
		# shellcheck disable=SC2086
		join_crash_parts $parts >"$f"
	else
		decode_crash_vars >"$f"
	fi
	if [ ! -s "$f" ]; then
		rm -f "$f"
		alert "$1: the kernel crashed (a hibernation hung, and its watchdog crashed it, say), but" \
			"its log couldn't be saved from its EFI variables: left there."
		return
	fi
	# Deleting them from pstorefs deletes the EFI variables; and directly, should that fail, so that
	# the next wake doesn't collect them again.
	rm -f "$pstore"/dmesg-*
	chattr -i $crash_vars "$crash_off" 2>/dev/null
	rm -f $crash_vars "$crash_off"
	alert "$1: a hibernation hung, and its watchdog crashed the kernel to get out of it (then it" \
		"powered off). The hung kernel's log is in $f."
}

# The initramfs's note that the chipset's watchdog fired before this boot.
collect_tco() {
	[ -e "$tco_fired" ] || return 0
	chattr -i "$tco_fired" 2>/dev/null
	rm -f "$tco_fired"
	if [ "$1" = "resumed from hibernation" ]; then
		alert "$1: the hibernation hung where nothing in the kernel could react (in the firmware," \
			"say): 10 min in, the chipset's watchdog restarted the laptop, which then powered" \
			"off. No crash log then, but the pm_trace saved at this resume tells how far it got."
	else
		alert "$1: the chipset's watchdog restarted the laptop (which then powered off), so a" \
			"hibernation, a shutdown or a reboot hung where nothing in the kernel could react (in" \
			"the firmware, say)."
	fi
}

# At a fresh boot, systemd-pstore has already moved crash logs to /var/lib/systemd/pstore (before
# sysinit.target), one file per part: join the new ones.
collect_archived_crash() {
	local seen=$dir/.pstore-seen f parts
	mkdir -p "$dir"
	# The first time, start from now rather than pick up older crashes.
	[ -f "$seen" ] || touch "$seen"
	parts=$(find /var/lib/systemd/pstore -type f -name 'dmesg-*' -newer "$seen" 2>/dev/null)
	if [ -n "$parts" ]; then
		f=$(new_file crash)
		# shellcheck disable=SC2086
		join_crash_parts $parts >"$f"
		alert "Booted after a kernel crash (a hibernation that hung, whose watchdog crashed it, or" \
			"another one): its log is in $f."
	fi
	touch "$seen"
	chattr -i "$crash_off" 2>/dev/null
	rm -f "$crash_off"
}

pre() {
	mkdir -p "$dir"
	local f pid i
	f=$(new_file "$action")
	# The settings first, then the readings that go through drivers (the battery's through the EC),
	# then the snapshot, so that nothing is left undone, or done after the resume, if one blocks.
	echo "$action since $(date -Is), snapshot $f" >"$marker"
	echo 1 >/sys/power/pm_debug_messages
	if [ "$action" = hibernate ]; then
		# While hibernate-loop runs, its file holds how long after this to wake up again. Set the
		# RTC's alarm for it here, as suspend-then-hibernate's own alarm has fired by now. And no
		# pm_trace then: it sets the RTC's time, so the alarm would never match.
		rm -f "$state.trace"
		if [ -e "$state.loop" ]; then
			log "hibernate: pm_trace off (hibernate-loop), snapshot $f"
			rtcwake -m no -s "$(cat "$state.loop")" >/dev/null &&
				log "hibernate: the RTC wakes it in $(cat "$state.loop") s (hibernate-loop)"
		elif [ -e "$trace_flag" ]; then
			echo 1 >/sys/power/pm_trace
			touch "$state.trace"
			log "hibernate: pm_trace on, snapshot $f"
		else
			log "hibernate: snapshot $f"
		fi
		arm_watchdog
	fi
	echo "$(now) $(bat_get energy_now 0) $(bat_get capacity 0) $(hw_sleep) $(bat_get status none)" >"$state"
	wakeups >"$state.wakeups"
	# Keep the last 300 snapshots, and every trace, crash log and PMC dump.
	ls -1t "$dir"/*.txt 2>/dev/null |
		grep -v -e '-trace[-0-9]*\.txt$' -e '-crash[-0-9]*\.txt$' -e '-pmc[-0-9]*\.txt$' |
		tail -n +301 | xargs -r rm -f
	# The marker must be on disk if the sleep never comes back.
	sync
	snapshot "$@" >"$f" 2>&1 &
	pid=$!
	for i in $(seq 20); do
		kill -0 "$pid" 2>/dev/null || return 0
		sleep 0.5
	done
	log "$action: snapshot not done after 10 s, sleeping without waiting for it"
}

post() {
	# The watchdog first, which would crash the kernel minutes from now.
	disarm_watchdog
	# Undo the hibernation's tracing, whatever else fails, and give the RTC a sane time again (the one
	# the clock resumed at, which chronyd then corrects).
	local was_traced=
	if [ "$action" = hibernate ] && traced; then
		was_traced=1
		echo 0 >/sys/power/pm_trace
		hwclock --systohc
	fi
	rm -f "$marker"
	collect_trace "resumed from hibernation"
	collect_crash "resumed from hibernation"
	collect_tco "resumed from hibernation"
	rm -f "$state.trace"
	[ -f "$state" ] || return 0
	local t0 e0 c0 h0 s0 t1 e1 c1 h1 s1 woke irq
	read -r t0 e0 c0 h0 s0 <"$state"
	t1=$(now) e1=$(bat_get energy_now 0) c1=$(bat_get capacity 0) h1=$(hw_sleep) s1=$(bat_get status none)
	woke=$(wakeups | awk 'NR == FNR { n[$1] = $2; next } $2 > n[$1] { printf "%s+%d ", $1, $2 - n[$1] }' \
		"$state.wakeups" -)
	rm -f "$state" "$state.wakeups"

	if [ "$action" = hibernate ]; then
		# Percentages, which also work when it was plugged in to boot after the battery died. After a
		# traced one, the clock is behind until chronyd steps it, so the duration comes from the
		# clock job.
		log "hibernate: battery $c0% -> $c1% ($s0 -> $s1)"
		[ $((c0 - c1)) -ge 5 ] &&
			alert "A hibernation probably hung at power-off: the battery went from $c0% to $c1%" \
				"while it was hibernated."
		if [ -n "$was_traced" ]; then
			systemd-run --no-block --collect --quiet --unit="sleep-debug-clock-$(date +%s%N)" \
				"$self" clock "$t0" "$(uptime_s)" "$e0" "$e1" "$s0" "$s1"
		else
			hibernate_drain "$t0" "$t1" "$e0" "$e1" "$s0" "$s1"
		fi
		return 0
	fi

	local t=$((t1 - t0)) hw note= f
	hw=$(awk -v h="$((h1 - h0))" -v t="$t" 'BEGIN { printf "%.0f", (t > 0 ? 100 * h / 1e6 / t : 0) }')
	irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null)
	[ -n "$irq" ] && irq=", wakeup irq $irq ($(grep -E "^ *$irq:" /proc/interrupts | awk '{ print $NF }'))"
	if [ "$t" -ge 300 ] && [ "$hw" -lt 90 ]; then
		f=$(new_file pmc)
		grep -H . /sys/kernel/debug/amd_pmc/{s0ix_stats,smu_fw_info,amd_pmc_idlemask} >"$f" 2>&1
		note=", NOT IN DEEP SLEEP most of the time, see $f"
	fi
	if [ "$s0" = Discharging ] && [ "$s1" = Discharging ]; then
		log "$action: $(drain "$t" "$e0" "$e1"), hw sleep $hw%$note, woke: ${woke:-none}$irq"
	else
		log "$action: $((t / 3600))h$(printf %02d $((t % 3600 / 60)))m on AC, hw sleep $hw%$note," \
			"woke: ${woke:-none}$irq"
	fi
}

# After a traced hibernation: step the clock back to the right time, then log how long it lasted.
clock() {
	local t0=$1 up1=$2 e0=$3 e1=$4 s0=$5 s1=$6
	systemctl restart chronyd
	if ! chronyc waitsync 90 1 >/dev/null; then
		log "hibernate: clock not synced after 15 min (offline?), duration unknown"
		return
	fi
	hwclock --systohc
	# The wall time when it came back, from the time since then.
	hibernate_drain "$t0" "$(($(now) - ($(uptime_s) - up1)))" "$e0" "$e1" "$s0" "$s1"
}

# Log how long a hibernation lasted and what it drew, flagging one that drew too much to have been
# off. Args: start and end times, battery energy before and after, and status before and after.
hibernate_drain() {
	local t0=$1 t1=$2 e0=$3 e1=$4 s0=$5 s1=$6 t
	t=$((t1 - t0))
	if [ "$s0" != Discharging ] || [ "$s1" != Discharging ]; then
		log "hibernate: lasted $((t / 3600))h$(printf %02d $((t % 3600 / 60)))m, on AC ($s0 -> $s1)"
	elif [ "$t" -ge 1200 ] && [ $((e0 - e1)) -gt $((t * 1000000 / 3600)) ]; then
		alert "A hibernation probably hung at power-off: it drew over 1 W, where a working one" \
			"is off: $(drain "$t" "$e0" "$e1")."
	else
		log "hibernate: $(drain "$t" "$e0" "$e1")"
	fi
}

case ${1:-} in
pre) pre "$@" ;;
post) post "$@" ;;
clock) shift && clock "$@" ;;
disarm) disarm_watchdog ;;
# By hand, to save a crash log left in EFI variables.
collect) collect_crash "collected by hand" ;;
# A fresh boot: a trace left means an image was there but not resumed.
boot)
	check_marker
	collect_trace "booted without resuming a hibernation"
	collect_crash "booted without resuming a hibernation"
	collect_tco "booted without resuming a hibernation"
	collect_archived_crash
	;;
esac
exit 0
