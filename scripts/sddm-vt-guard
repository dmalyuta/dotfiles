#!/bin/sh
#
# Unsticks SDDM's handoff from the greeter's virtual terminal to the session's.
# Installed to /usr/local/bin/sddm-vt-guard by start_fresh.sh, and run by
# scripts/sddm-vt-guard.service for as long as SDDM is up.
#
# The failure it covers looks, from the chair, like a black screen after the
# password is accepted: no desktop, no splash, but the keyboard still echoes
# characters, because what is on screen is a bare text console. Pressing
# Ctrl+Alt+F2 makes the desktop appear a second or two later. It is
# intermittent, and it is a lost race rather than anything being misconfigured.
#
# What happens
#
#   SDDM runs the greeter's compositor on one VT and the session on the next
#   one, so starting a session means switching VTs. sddm-helper does that
#   itself, in the child it has just forked for the session and before it execs
#   anything: VT_ACTIVATE for the new VT, then VT_WAITACTIVE to block until the
#   switch has actually happened. In the journal that is the gap between
#
#       sddm-helper[N]: Jumping to VT 2
#   and sddm[M]:        Session started true
#
#   which is normally a millisecond or two.
#
#   The VT being switched away from belongs to the greeter's logind session,
#   and logind puts every session VT into VT_PROCESS mode, which means the
#   kernel will not complete a switch off it until logind acknowledges with
#   VT_RELDISP. Normally logind gets the signal, releases, and the switch goes
#   through before sddm-helper has noticed. But SDDM tears the greeter session
#   down at the same moment, and when logind removes a session it restores that
#   VT to VT_AUTO -- and the kernel's VT_SETMODE handler ends with
#
#       vc->vt_newvt = -1;      /* no switch is required */
#
#   which throws away the switch that was pending. Nothing is left to complete
#   it, so VT_WAITACTIVE never returns. sddm-helper sits in that ioctl, the
#   session is never exec'd, and the console stays on the greeter's old VT with
#   nothing drawing on it. Ctrl+Alt+F2 works because by then the old VT is back
#   in VT_AUTO, so a fresh activation switches immediately and frees the ioctl.
#
# What this does
#
#   Exactly what Ctrl+Alt+F2 does, without needing somebody sitting there. It
#   looks for an sddm-helper parked in ioctl(_, VT_WAITACTIVE, N) -- read
#   straight out of /proc/PID/syscall, so there is no guessing about which VT
#   is wanted or whether the wait is real -- and once that has held for GRACE
#   consecutive checks with the console somewhere else, it activates that VT.
#
#   The grace period is what keeps it from fighting a switch that is merely in
#   flight. A healthy handoff is over in milliseconds, so anything still
#   waiting seconds later is the stuck case.
#
# Author: Danylo Malyuta, 2026.

set -u

POLL=1  # seconds between checks
GRACE=3 # checks a wait has to survive before this steps in

ACTIVE=/sys/class/tty/tty0/active

# The foreground VT's number, or nothing if the console has no VTs.
active_vt() {
	[ -r "$ACTIVE" ] || return 1
	read -r name <"$ACTIVE" || return 1
	case $name in
	tty[0-9]*) printf '%s' "${name#tty}" ;;
	*) return 1 ;;
	esac
}

# Echoes "<pid> <vt>" for an sddm-helper blocked in ioctl(VT_WAITACTIVE), and
# nothing at all when there is none. /proc/PID/syscall is
# "nr arg0 arg1 arg2 arg3 arg4 arg5 sp pc" while a task is blocked in a call,
# and the single word "running" otherwise, so a task that is merely busy never
# matches. Reading it needs the same privilege as attaching a debugger, which
# is why this runs as root.
waiting_helper() {
	for pid in $(pgrep -x sddm-helper 2>/dev/null); do
		[ -r "/proc/$pid/syscall" ] || continue
		read -r nr _ cmd arg _ <"/proc/$pid/syscall" || continue
		[ "$nr" = 16 ] || continue     # __NR_ioctl, x86-64
		[ "$cmd" = 0x5607 ] || continue # VT_WAITACTIVE
		printf '%s %s' "$pid" "$((arg))"
		return 0
	done
	return 1
}

previous=
count=0

while :; do
	current=$(waiting_helper) || current=

	if [ -n "$current" ] && [ "$current" = "$previous" ]; then
		count=$((count + 1))
	else
		previous=$current
		count=1
	fi

	if [ -n "$current" ] && [ "$count" -ge "$GRACE" ]; then
		pid=${current%% *}
		vt=${current##* }
		now=$(active_vt) || now=none
		if [ "$now" != "$vt" ]; then
			logger -t sddm-vt-guard \
				"sddm-helper $pid has waited $((count * POLL))s for VT $vt with the console on VT $now; activating it"
			# chvt itself ends in VT_WAITACTIVE, so cap it: the activation
			# that does the work has already happened by then.
			timeout 5 chvt "$vt" ||
				logger -t sddm-vt-guard "chvt $vt failed, will retry"
		fi
		# Either it worked, or it did not and the next pass can try again
		# after another grace period rather than once a second.
		previous=
		count=0
	fi

	sleep "$POLL"
done
